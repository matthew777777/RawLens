#version 450
layout(local_size_x=16, local_size_y=16) in;
layout(binding=0) readonly buffer Low { uint lo[]; };
layout(binding=1) readonly buffer High { uint hi[]; };
layout(binding=2) writeonly buffer Out { uint outputCodes[]; };
layout(push_constant) uniform Params {
    ivec4 geometry; // width, height, low pitch in uint16, high pitch
    vec4 blackLow;
    vec4 blackHigh;
    vec4 levels; // whiteLow, whiteHigh, high-to-low scale, low/high weight ratio
} p;
uint fetchLo(int x,int y) { uint i=uint(y*p.geometry.z+x); return (lo[i>>1]>>((i&1)*16))&65535; }
uint fetchHi(int x,int y) { uint i=uint(y*p.geometry.w+x); return (hi[i>>1]>>((i&1)*16))&65535; }
uint fuse(int x,int y) {
    int c=(y&1)*2+(x&1);
    float a=(float(fetchLo(x,y))-p.blackLow[c])/(p.levels.x-p.blackLow[c]);
    float b=(float(fetchHi(x,y))-p.blackHigh[c])/(p.levels.y-p.blackHigh[c]);
    float wa=p.levels.w*clamp((0.99-a)/0.09,0.0,1.0);
    float wb=clamp((0.99-b)/0.09,0.0,1.0);
    float v=wa+wb>0.0?(wa*a+wb*b*p.levels.z)/(wa+wb):a;
    return uint(clamp(round(v*64511.0+1024.0),0.0,65535.0));
}
void main() {
    int x=int(gl_GlobalInvocationID.x)*2, y=int(gl_GlobalInvocationID.y);
    if(x>=p.geometry.x || y>=p.geometry.y) return;
    outputCodes[(y*p.geometry.x+x)/2]=fuse(x,y)|(fuse(x+1,y)<<16);
}
