<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.camera.any" />
    <!-- DNG-only remains available when the optional GLES 3.1 RAW developer is unavailable. -->
    <uses-feature android:glEsVersion="0x00030001" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- RAW video sound: PCM16 inside the .mcraw. Requested at runtime only
        on first video-record press; stills never need the mic. No microphone
        uses-feature: mic-less devices record silent video instead. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Full-rate gyro/accel for video motion tracks (API 31+ install-time
        normal permission; game-rate fallback when unavailable). -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- Optional geotagging: requested at runtime only when "Save location" is enabled. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- In-app updater: fetch the latest GitHub release metadata on
        startup (and only that host) plus the release APK itself.
        No analytics, no telemetry. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updater: install the downloaded release APK. The user still
        approves unknown-sources per app and confirms every install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- No Auto Backup: settings are hardware-tied (lens setup, calibration)
        and a restore impersonates a fresh install — uninstall must reset.
        Intentional transfer stays available via Settings → Settings backup. -->
    <application
        android:name=".RawLensApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/backup_rules"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="RawLens"
        android:supportsRtl="true"
        android:theme="@style/Theme.RawLens">
        <service
            android:name=".JpegProcessingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Full-resolution RAW photo development and JPEG encoding" />
        </service>
        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
        </activity>
        <!-- In-app updater: serves the staged release APK to the system
            installer. Paths limited to the update staging dir (filepaths). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
    </application>
</manifest>
