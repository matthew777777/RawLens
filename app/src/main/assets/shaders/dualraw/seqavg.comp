#version 450
// Sequential-DCG stage-1 averaging: two same-exposure Bayer frames.
//
// CPU reference: HdrSeqMerge.mergeZeroPair. The per-tile shifts come from
// the CPU green-channel SAD (HdrSeqMerge.estimateTileShifts); this kernel
// only warps (same-colour bilinear, never mixing R/G/B), gates on the
// Poisson-Gaussian noise model, and averages. Output packs like
// dualraw/merge.comp (black 1024, headroom 1.0) for the 16-bit DNG path.
layout(local_size_x=16, local_size_y=16) in;
layout(binding=0) readonly buffer Ref { uint rf[]; };
layout(binding=1) readonly buffer Alt { uint al[]; };
layout(binding=2) readonly buffer Shifts { vec2 sh[]; };
layout(binding=3) writeonly buffer Out { uint outputCodes[]; };
layout(push_constant) uniform Params {
    ivec4 geometry; // width, height, ref pitch in uint16, alt pitch in uint16
    ivec4 grid;     // tile grid width, height, tile edge in green px, unused
    vec4 blackRef;  // per-channel black in DN, CFA order R Gr Gb B
    vec4 blackAlt;
    vec4 levels;   // white DN, noise scale, noise offset, reject K
} p;

uint fetchRef(int x, int y) { uint i = uint(y * p.geometry.z + x); return (rf[i >> 1] >> ((i & 1) * 16)) & 65535u; }
uint fetchAlt(int x, int y) { uint i = uint(y * p.geometry.w + x); return (al[i >> 1] >> ((i & 1) * 16)) & 65535u; }

// Same-colour bilinear tap: only lattice sites carrying pixel (x,y)'s own
// Bayer colour contribute. Mirrors HdrRawMerge.sampleSmoothAt.
float warpAlt(int x, int y, float dx, float dy) {
    int w = p.geometry.x;
    int h = p.geometry.y;
    float px = clamp(float(x) + dx, 0.0, float(w - 1));
    float py = clamp(float(y) + dy, 0.0, float(h - 1));
    int pxParity = x & 1;
    int pyParity = y & 1;
    int x0 = int(px);
    if ((x0 & 1) != pxParity) x0 -= 1;
    int y0 = int(py);
    if ((y0 & 1) != pyParity) y0 -= 1;
    x0 = clamp(x0, pxParity, w - 2 + pxParity);
    y0 = clamp(y0, pyParity, h - 2 + pyParity);
    int x1 = min(x0 + 2, w - 1 - ((w - 1 - pxParity) & 1));
    int y1 = min(y0 + 2, h - 1 - ((h - 1 - pyParity) & 1));
    float fx = clamp((px - float(x0)) / 2.0, 0.0, 1.0);
    float fy = clamp((py - float(y0)) / 2.0, 0.0, 1.0);
    float a = float(fetchAlt(x0, y0));
    float b = float(fetchAlt(x1, y0));
    float c = float(fetchAlt(x0, y1));
    float d = float(fetchAlt(x1, y1));
    return mix(mix(a, b, fx), mix(c, d, fx), fy);
}

uint fuse(int x, int y) {
    int c = (y & 1) * 2 + (x & 1);
    float white = p.levels.x;
    float r = (float(fetchRef(x, y)) - p.blackRef[c]) / (white - p.blackRef[c]);
    int tx = clamp((x / 2) / p.grid.z, 0, p.grid.x - 1);
    int ty = clamp((y / 2) / p.grid.z, 0, p.grid.y - 1);
    vec2 s = sh[ty * p.grid.x + tx];
    float m = (warpAlt(x, y, s.x, s.y) - p.blackAlt[c]) / (white - p.blackAlt[c]);
    float vr = p.levels.y * max(r, 0.0) + p.levels.z;
    float vm = p.levels.y * max(m, 0.0) + p.levels.z;
    float sigma = sqrt(max(vr + vm, 1e-12));
    float v = (abs(m - r) <= p.levels.w * sigma) ? (r + m) * 0.5 : r;
    return uint(clamp(round(v * 64511.0 + 1024.0), 0.0, 65535.0));
}

void main() {
    int x = int(gl_GlobalInvocationID.x) * 2, y = int(gl_GlobalInvocationID.y);
    if (x >= p.geometry.x || y >= p.geometry.y) return;
    outputCodes[(y * p.geometry.x + x) / 2] = fuse(x, y) | (fuse(x + 1, y) << 16);
}
