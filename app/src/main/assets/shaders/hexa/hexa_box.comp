#version 450
// SPDX-License-Identifier: GPL-3.0-or-later
// Hexadeca v2: 1-D box filter (radius R, mean) as a running sum. One thread walks SEG outputs
// along the filter direction: ~2 loads per output, no shared memory, no barrier.
// z = slot index within the batch (src+z -> dst+z). Clamp-to-edge inside the tile.
layout(local_size_x = 64, local_size_y = 1) in;
layout(constant_id = 0) const int DIR = 0;     // 0: along x, 1: along y
layout(constant_id = 1) const int R = 5;
const int SEG = 32;
layout(std430, binding = 0) buffer Data { vec4 d[]; };
layout(push_constant) uniform P { ivec4 a; ivec4 b; ivec4 c; vec4 f; } p;
// a: - src dst - | b: T
void main() {
    int T = p.b.x, TT = T * T;
    int line = int(gl_GlobalInvocationID.x), seg = int(gl_GlobalInvocationID.y), z = int(gl_GlobalInvocationID.z);
    if (line >= T) return;
    int start = seg * SEG;
    if (start >= T) return;
    int src = (p.a.y + z) * TT, dst = (p.a.z + z) * TT;
    int stepA = DIR == 0 ? 1 : T, lineOff = DIR == 0 ? line * T : line;
    vec4 s = vec4(0.0);
    for (int i = -R; i <= R; ++i) s += d[src + lineOff + clamp(start + i, 0, T - 1) * stepA];
    const float inv = 1.0 / float(2 * R + 1);
    int end = min(start + SEG, T);
    for (int x = start; x < end; ++x) {
        d[dst + lineOff + x * stepA] = s * inv;
        s += d[src + lineOff + clamp(x + R + 1, 0, T - 1) * stepA] - d[src + lineOff + clamp(x - R, 0, T - 1) * stepA];
    }
}
