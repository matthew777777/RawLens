#version 450
// SPDX-License-Identifier: GPL-3.0-or-later
// Hexadeca v2 per-pixel stages (4x4-block GBRG CFA, ratio init + residual interpolation).
// One pipeline per stage (specialisation constant MODE); no dynamic vector indexing (Mali spills it).
// Slots (T*T vec4): 0 V(x) 1 A 2 DENG 3 DENB 4 D/OUT 5 P 6 L 7 XR 8 XG 9 XB 10 AB1 11 AB2 12 R
layout(local_size_x = 16, local_size_y = 16) in;
layout(constant_id = 0) const int MODE = 0;
layout(std430, binding = 0) buffer Data { vec4 d[]; };
layout(push_constant) uniform P { ivec4 a; ivec4 b; ivec4 c; vec4 f; } p;
// b: T, gx0, gy0, halo | c: outW (interior/2) | f: eps0, epsRI, ratio floor (DN)
vec3 maskAt(int gx, int gy) {          // GBRG at block level -> one-hot (R, G, B)
    bool by = ((gy >> 2) & 1) == 1, bx = ((gx >> 2) & 1) == 1;
    bool g = by == bx;
    return vec3(!g && by, g, !g && !by);
}
void main() {
    int T = p.b.x, TT = T * T;
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (MODE == 7) {                       // final: own samples back, 2x2 area downsample of the interior
        int ow = p.c.x;
        if (q.x >= ow || q.y >= ow) return;
        vec3 acc = vec3(0.0);
        for (int j = 0; j < 2; ++j) for (int i = 0; i < 2; ++i) {
            int x = p.b.w + 2 * q.x + i, y = p.b.w + 2 * q.y + j, id = y * T + x;
            vec3 m = maskAt(p.b.y + x, p.b.z + y);
            acc += mix(d[5 * TT + id].rgb, vec3(d[id].x), m);
        }
        d[4 * TT + q.y * ow + q.x] = vec4(acc * 0.25, 0.0);
        return;
    }
    if (q.x >= T || q.y >= T) return;
    int id = q.y * T + q.x;
    vec3 m = maskAt(p.b.y + q.x, p.b.z + q.y);
    float v = d[id].x;
    if (MODE == 0) {                       // A = v*mask ; masks for the once-per-frame densities
        d[TT + id] = vec4(m * v, 0.0);
        if (p.a.y != 0) { d[2 * TT + id] = vec4(m, 0.0); d[3 * TT + id] = vec4(m, 0.0); }
    } else if (MODE == 1) {
        vec3 K = max(d[TT + id].rgb / d[2 * TT + id].rgb, vec3(p.f.x));
        K /= (K.r + 2.0 * K.g + K.b) * 0.25;
        float L = v / max(dot(K, m), 1e-3);
        d[4 * TT + id] = vec4(m * L, 0.0);
    } else if (MODE == 2) {
        // Regularised ratio: in deep shadow both sums are noise around 0 and the raw quotient explodes
        // (white/blue dots). The noise-floor term (f.z DN) shrinks K towards the bounded first-pass ratio.
        vec3 den = d[2 * TT + id].rgb, A = d[TT + id].rgb;
        vec3 K1 = max(A / den, vec3(p.f.x));
        K1 /= (K1.r + 2.0 * K1.g + K1.b) * 0.25;
        vec3 K = clamp((A + p.f.z * den * K1) / (d[4 * TT + id].rgb + p.f.z * den), vec3(0.02), vec3(50.0));
        K /= (K.r + 2.0 * K.g + K.b) * 0.25;
        float L = v / max(dot(K, m), 1e-3);
        d[5 * TT + id] = vec4(L * K, 0.0);
    } else if (MODE == 3) {
        vec3 o = mix(d[5 * TT + id].rgb, vec3(v), m);
        float L = (o.r + 2.0 * o.g + o.b) * 0.25;
        d[6 * TT + id] = vec4(L);
        vec4 x = vec4(L, v, L * v, L * L);
        d[7 * TT + id] = x * m.r; d[8 * TT + id] = x * m.g; d[9 * TT + id] = x * m.b;
    } else if (MODE == 4) {
        vec3 n = max(d[3 * TT + id].rgb, vec3(1e-6));
        vec4 xr = d[7 * TT + id] / n.r, xg = d[8 * TT + id] / n.g, xb = d[9 * TT + id] / n.b;
        vec3 mL = vec3(xr.x, xg.x, xb.x), mV = vec3(xr.y, xg.y, xb.y);
        vec3 cLV = vec3(xr.z, xg.z, xb.z) - mL * mV, vL = vec3(xr.w, xg.w, xb.w) - mL * mL;
        vec3 aa = cLV / (vL + p.f.y), bb = mV - aa * mL;
        d[10 * TT + id] = vec4(aa.r, bb.r, aa.g, bb.g); d[11 * TT + id] = vec4(aa.b, bb.b, 0.0, 0.0);
    } else if (MODE == 5) {
        vec4 a1 = d[10 * TT + id], a2 = d[11 * TT + id];
        float L = d[6 * TT + id].x;
        vec3 est = vec3(a1.x, a1.z, a2.x) * L + vec3(a1.y, a1.w, a2.y);
        d[5 * TT + id] = vec4(est, 0.0);
        d[12 * TT + id] = vec4(m * (v - est), 0.0);
    } else if (MODE == 6) {
        d[5 * TT + id] = vec4(d[5 * TT + id].rgb + d[12 * TT + id].rgb / d[2 * TT + id].rgb, 0.0);
    }
}
