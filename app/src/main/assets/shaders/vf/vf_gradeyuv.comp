//
// Encoded Video TRUE 10-bit stage: FP16 source (superpixel export OR
// full-res MHC demosaic, see fullRgb) -> WB/CCM/exposure -> DIRECT
// profile encode (BT.709 OETF / Sony S-Log3 / BT.2020 + HLG, see
// outMode) -> limited-range YUV -> semi-planar P010 bytes in OUR OWN
// buffer (storage buffer, byte-exact addressing). No EGL surface
// anywhere: the 8-bit recordable-surface choke point is gone, and every
// code in the file is full precision until the final 10-bit round. A
// dumb CPU copy then de-interleaves UV into the codec's planar input
// (GPU did all the math; MotionCam burns CPU on swscale here instead).
// No contrast curve, no saturation: the encode is the developed linear
// value through the profile's transfer function only.
//
// Layout (OUR allocation, validated natively per submit, loud -20 abort):
// Y: full res uint16, 10-bit in the upper bits (P010).
// UV: half res INTERLEAVED pairs (U,V uint16 each, 4 bytes per pair).
//
// Push block mirrors GradeYuvParams in vf_vulkan_vf.cpp (must match).
//
// Regenerate the SPIR-V with:
//   glslangValidator -V --target-env vulkan1.1 vf_gradeyuv.comp -o vf_gradeyuv.spv
#version 450
#extension GL_GOOGLE_include_directive : require

#ifdef RECORD_CUBE
#include "../record_cube.glsl"
#endif
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform readonly image2D img_in;
layout(binding = 1) writeonly buffer P010 { uint words[]; } buf_out;
// Reserved for upcoming LUT support: still bound every submit (the
// native gate requires the upload), not fetched (direct encode).
layout(binding = 2) uniform sampler3D gradeLut;

layout(push_constant) uniform Params {
    ivec2 u_dims;       // full-res output W/H
    ivec2 u_srcDims;    // FP16 source W/H (half res per axis in
                        // superpixel mode, full crop in full-RGB mode)
    vec4 u_ccmR;        // WB+exposure-folded on the CPU (no u_gains)
    vec4 u_ccmG;
    vec4 u_ccmB;
    vec4 u_misc;        // bypass, yStrideW, uvStrideW, uvBaseOffB
    vec4 u_misc2;       // fullRgb, outMode, reserved, 0
} p;

// Source texel to linear RGB. Superpixel mode (fullRgb == 0): the
// texel is a quad (R/Gr/Gb/B), demosaiced by Gr/Gb mean. Full-RGB
// mode (fullRgb != 0): the texel is MHC demosaiced output, already
// RGB. The flag is push-constant-uniform: no divergence.
vec3 rgbOf(vec4 q) {
    if (p.u_misc2.x > 0.5) {
        return q.rgb;
    }
    return vec3(q.r, 0.5 * (q.g + q.b), q.a);
}

// ---- direct-encode record grade: no warp, no saturation ----
vec3 bt709Encode(vec3 v) {
    v = clamp(v, 0.0, 1.0);
    vec3 lo = 4.5 * v;
    vec3 hi = 1.099 * pow(v, vec3(0.45)) - 0.099;
    return mix(hi, lo, vec3(lessThan(v, vec3(0.018))));
}

float hlgOetf(float e) {
    e = clamp(e, 0.0, 1.0);
    if (e <= 1.0 / 12.0) return sqrt(3.0 * e);
    // Natural log (BT.2100 Table 5); rounded constants overshoot 1.0
    // by ~8e-5 at E = 1, hence the clamp.
    return clamp(0.17883277 * log(12.0 * e - 0.28466892) + 0.55991073, 0.0, 1.0);
}

vec3 hlgEncode(vec3 v2020) {
    return vec3(hlgOetf(v2020.r), hlgOetf(v2020.g), hlgOetf(v2020.b));
}

// Linear sRGB (D65) -> linear BT.2020 (D65), dot form (avoids mat3
// layout pitfalls); mirrors VfVideoGrade.SRGB_TO_BT2020.
vec3 srgbToBt2020(vec3 v) {
    return vec3(
        dot(v, vec3(0.6274040, 0.3292820, 0.0433136)),
        dot(v, vec3(0.0690970, 0.9195400, 0.0113612)),
        dot(v, vec3(0.0163916, 0.0880132, 0.8955950)));
}

// Sony S-Log3, normalized (same mapping as vf_videograde.comp):
// divisor 0.19, 95-code black pedestal.
// BEGIN generated Sony gamut (tools/generate_sgamut3_cine.py)
vec3 srgbToSgamut3Cine(vec3 v) {
    return vec3(dot(v, vec3(0.6456794776, 0.2591145470, 0.0952059754)),
        dot(v, vec3(0.0875299915, 0.7596995626, 0.1527704459)),
        dot(v, vec3(0.0369574199, 0.1292809048, 0.8337616753)));
}
// END generated Sony gamut

float slog3cutY() {
    return (420.0 + log2((0.01125 + 0.01) / 0.19) * 0.30102999566 * 261.5) / 1023.0;
}

float sonySlog3(float x) {
    if (x >= 0.01125) {
        // log10 via log2 (GLSL has no log10): 1/log2(10) = 0.30103.
        return (420.0 + log2((x + 0.01) / 0.19) * 0.30102999566 * 261.5) / 1023.0;
    }
    return (95.0 + x * (slog3cutY() * 1023.0 - 95.0) / 0.01125) / 1023.0;
}

vec3 slogEncode(vec3 v) {
    v = srgbToSgamut3Cine(v);
    vec3 encoded = vec3(sonySlog3(v.r), sonySlog3(v.g), sonySlog3(v.b));
#ifdef RECORD_CUBE
    return applyRecordLut(encoded);
#else
    return encoded;
#endif
}

// Grade one source texel (shared by Y and UV taps): direct profile
// encode of the developed linear value. CCM arrives WB+exposure-folded
// on the CPU. outMode (u_misc2.y): 0 = BT.709, 1 = Sony S-Log3
// (flat), 2 = BT.2020 + HLG. The branch is push-constant-uniform: no
// divergence. CPU goldens are VfVideoGrade.encodePixel*.

// Output is display-linear: encode with inverse BT.1886 (gamma 2.4), not camera OETF.
// ACES fitted rendering, Stephen Hill's RRT/ODT approximation.
// Reference: TheRealMJP/BakingLab, ACES.hlsl (MIT).
// Vibrance (user grade, per-phone tuning): chroma-weighted saturation
// about BT.709 luma on the developed linear value. vib = 0 is neutral
// (uniform branch); > 0 lifts muted colors more than saturated ones.
// Plain saturation is folded into the CCM on the CPU (VfVideoGrade.packGrade).
vec3 applyVibrance(vec3 v, float vib) {
    if (vib == 0.0) return v;
    float l = dot(v, vec3(0.2126, 0.7152, 0.0722));
    float mx = max(v.r, max(v.g, v.b));
    float mn = min(v.r, min(v.g, v.b));
    float s = clamp((mx - mn) / max(mx, 1e-4), 0.0, 1.0);
    return vec3(l) + (v - vec3(l)) * max(1.0 + vib * (1.0 - s), 0.0);
}

vec3 acesFitted(vec3 v) {
    // Keep signed CCM values until the reference fit's final clamp.
    v = vec3(dot(v, vec3(0.59719,0.35458,0.04823)),
             dot(v, vec3(0.07600,0.90834,0.01566)),
             dot(v, vec3(0.02840,0.13383,0.83777)));
    v = (v*(v+0.0245786)-0.000090537)/(v*(0.983729*v+0.4329510)+0.238081);
    return clamp(vec3(dot(v,vec3(1.60475,-0.53108,-0.07367)),
                      dot(v,vec3(-0.10208,1.10813,-0.00605)),
                      dot(v,vec3(-0.00327,-0.07276,1.07602))),0.0,1.0);
}
vec3 gradeTexel(vec2 uv) {
    vec4 q = imageLoad(img_in, ivec2(uv));
    vec3 rgb = rgbOf(q);
    vec3 developed = vec3(dot(p.u_ccmR.rgb, rgb), dot(p.u_ccmG.rgb, rgb), dot(p.u_ccmB.rgb, rgb));
    developed = applyVibrance(developed, p.u_misc2.z);
    int mode = int(p.u_misc2.y + 0.5);
    if (mode == 3) return pow(acesFitted(developed), vec3(1.0 / 2.4));
    if (mode == 1) return slogEncode(developed);
    if (mode == 2) return hlgEncode(srgbToBt2020(developed));
    return bt709Encode(developed);
}

// Display RGB for one full-res output texel (source cover + grade).
vec3 pixelLog(ivec2 ij) {
    vec2 suv = (vec2(ij) + 0.5) * vec2(p.u_srcDims) / vec2(p.u_dims);
    vec3 lg = gradeTexel(suv);
    if (p.u_misc.x > 0.5) {
        // Bypass: ungraded source RGB through the pack (validates layout).
        vec4 q = imageLoad(img_in, ivec2(suv));
        lg = rgbOf(q);
    }
    return lg;
}

vec3 rgbToYuv(vec3 rgb, int mode) {
    if (mode == 2) {
        // BT.2020 non-constant luminance (Kr = 0.2627, Kb = 0.0593).
        float y = 0.2627 * rgb.r + 0.6780 * rgb.g + 0.0593 * rgb.b;
        float cb = (rgb.b - y) / 1.8814 + 0.5;
        float cc = (rgb.r - y) / 1.4746 + 0.5;
        return vec3(y, cb, cc);
    }
    float y = 0.2126 * rgb.r + 0.7152 * rgb.g + 0.0722 * rgb.b;
    float cb = (rgb.b - y) / (2.0 * (1.0 - 0.0722)) + 0.5;
    float cc = (rgb.r - y) / (2.0 * (1.0 - 0.2126)) + 0.5;
    return vec3(y, cb, cc);
}

uint pack10(float v, float low, float high) {
    uint code = uint(round(clamp(v, 0.0, 1.0) * (high - low) + low));
    return (code << 6) & 0xFFC0u;
}

void main() {
    // One invocation owns both luma pairs and chroma of a complete 2x2 cell.
    // Every source pixel is graded once; no row is omitted from chroma.
    ivec2 ij = ivec2(gl_GlobalInvocationID.xy) * 2;
    if (any(greaterThanEqual(ij, p.u_dims))) return;
    int yStride = int(p.u_misc.y);
    int outMode = int(p.u_misc2.y + 0.5);
    vec3 yuv0 = rgbToYuv(pixelLog(ij), outMode);
    vec3 yuv1 = rgbToYuv(pixelLog(min(ij + ivec2(1,0), p.u_dims - 1)), outMode);
    uint yIdx = uint(ij.y) * uint(yStride) + uint(ij.x);
    buf_out.words[yIdx >> 1u] = pack10(yuv0.x,64.0,940.0)
        | (pack10(yuv1.x,64.0,940.0) << 16u);
    vec3 sumTop = yuv0 + yuv1;
    vec3 yuv2 = rgbToYuv(pixelLog(min(ij + ivec2(0,1), p.u_dims - 1)), outMode);
    vec3 yuv3 = rgbToYuv(pixelLog(min(ij + ivec2(1,1), p.u_dims - 1)), outMode);
    if (ij.y + 1 < p.u_dims.y) {
        uint nextIdx = yIdx + uint(yStride);
        buf_out.words[nextIdx >> 1u] = pack10(yuv2.x,64.0,940.0)
            | (pack10(yuv3.x,64.0,940.0) << 16u);
    }
    vec3 mean = (sumTop + (yuv2 + yuv3)) * 0.25;
    uint pairIdx = uint(p.u_misc.w) / 2u + uint(ij.y / 2) * uint(p.u_misc.z) + uint(ij.x);
    buf_out.words[pairIdx >> 1u] = pack10(mean.g,64.0,960.0)
        | (pack10(mean.b,64.0,960.0) << 16u);
}
