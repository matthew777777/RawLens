//
// Direct-Log grade stage (Phase B): superpixel quad buffer (R/Gr/Gb/B in
// RGBA8) -> WB gains -> 3x3 CCM -> exposure -> S-Log3-shaped log curve ->
// graded RGBA8. The downstream EGL blit becomes a dumb copy: no GL color
// work, no second fullscreen tonemap pass.
//
// The curve is the published Sony S-Log3 10-bit code mapping, normalized to
// 0..1. Post-CCM linear sRGB is converted to S-Gamut3.Cine (D65) before
// the curve. Signed values retain the published linear toe below the cut.
//
// Regenerate the SPIR-V with:
//   glslangValidator -V --target-env vulkan1.1 vf_loggrade.comp -o vf_loggrade.spv
#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform readonly image2D img_in;
layout(binding = 1, rgba16f) uniform writeonly image2D img_out;

// Packing mirrors GradeParams in vf_vulkan_vf.cpp exactly (96 bytes:
// ivec2 needs 16-byte alignment before the first vec4).
layout(push_constant) uniform Params {
    ivec2 u_dims;
    vec4 u_gains;   // R, G, B white-balance gains (+1 spare)
    vec4 u_ccmR;
    vec4 u_ccmG;
    vec4 u_ccmB;
    vec4 u_misc;    // exposureEV, bypass, 0, 0
} p;

// The curve is Sony S-Log3, normalized to 0..1: the published 10-bit
// code mapping (420/261.5/1023 scaffolding, divisor 0.19) with the
// 95-code black pedestal. Anchors: 0 -> 95, 0.01125 -> ~171.21,
// 18% gray -> 420, 90% white -> ~597.9. The toe meets the log branch
// at the cut, so the curve is continuous. CPU golden is VfLogGrade.sonySlog3.
// BEGIN generated Sony gamut (tools/generate_sgamut3_cine.py)
vec3 srgbToSgamut3Cine(vec3 v) {
    return vec3(dot(v, vec3(0.6456794776, 0.2591145470, 0.0952059754)),
        dot(v, vec3(0.0875299915, 0.7596995626, 0.1527704459)),
        dot(v, vec3(0.0369574199, 0.1292809048, 0.8337616753)));
}
// END generated Sony gamut

float slog3cutY() {
    return (420.0 + log2((0.01125 + 0.01) / 0.19) * 0.30102999566 * 261.5) / 1023.0;
}

float slog3(float x) {
    if (x >= 0.01125) {
        // log10 via log2 (GLSL has no log10): 1/log2(10) = 0.30103.
        return (420.0 + log2((x + 0.01) / 0.19) * 0.30102999566 * 261.5) / 1023.0;
    }
    // Linear toe through (0, 95) and the cut point.
    return (95.0 + x * (slog3cutY() * 1023.0 - 95.0) / 0.01125) / 1023.0;
}

void main() {
    ivec2 ij = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(ij, p.u_dims))) return;
    vec4 q = imageLoad(img_in, ij);
    if (p.u_misc.y > 0.5) {
        imageStore(img_out, ij, q);
        return;
    }
    // Quad texel -> demosaiced-by-average RGB (Gr/Gb mean), then the grade.
    vec3 rgb = vec3(q.r, 0.5 * (q.g + q.b), q.a);
    vec3 wb = rgb * p.u_gains.rgb;
    vec3 ccm = vec3(dot(p.u_ccmR.rgb, wb), dot(p.u_ccmG.rgb, wb), dot(p.u_ccmB.rgb, wb));
    vec3 ex = srgbToSgamut3Cine(ccm * exp2(p.u_misc.x));
    vec3 lg = vec3(slog3(ex.r), slog3(ex.g), slog3(ex.b));
    imageStore(img_out, ij, vec4(lg, 1.0));
}
