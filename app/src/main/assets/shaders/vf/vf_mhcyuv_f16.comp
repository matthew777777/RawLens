//
// Direct-Log FUSED record stage, float16-math variant of vf_mhcyuv.comp:
// identical structure and op order, all computed values in float16_t
// (GL_EXT_shader_explicit_arithmetic_types_float16; needs the
// VK_KHR_shader_float16_int8 device feature + shaderFloat16). The fp32
// original stays as the fallback SPIR-V for devices without the feature.
//
// Deliberate differences from the fp32 twin beyond precision:
//  - normalize is a plain f16 multiply-add (no fma() call; the compiler
//    fuses it back — the ±8-code grade gate absorbs the rounding);
//  - the resample coverage suv is pure integer (exact floor; fp16 would
//    round 4K coordinates to even and mis-cover edge texels).
//
// Params arrive as a 192-byte SSBO (FusedParams in vf_vulkan_vf.cpp),
// still fp32 words (16-bit storage would churn the layout for 192 bytes);
// values convert to f16 on load.
//
// Regenerate the SPIR-V with:
//   glslangValidator -V --target-env vulkan1.1 vf_mhcyuv_f16.comp -o vf_mhcyuv_f16.spv
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// 16x16 workgroups (MHC's shape, not grade's 8x8): the fused kernel
// is tap-heavy like MHC, and wider groups give the scheduler more
// threads to cover tap latency with.
layout(local_size_x = 16, local_size_y = 16) in;

// Byte-exact sensor view (vf_superpixel convention): each uint holds 2
// LE pixels, stride is the Image plane pitch in pixels.
layout(binding = 0) readonly buffer Bayer { uint codes[]; };
layout(binding = 1) writeonly buffer P010 { uint words[]; } buf_out;

// Mirrors FusedParams in vf_vulkan_vf.cpp exactly (192 bytes, std430).
struct FusedParams {
    ivec2 cDims;      // crop W/H (MHC domain, full res)
    ivec2 cOrigin;    // crop left/top in sensor pixels (CFA phase)
    ivec4 cChans;     // quad-offset map, channels[] convention
    vec4 cNormBias;   // per-quad-pos -black * invRange (FMA bias)
    vec4 cInvRange;   // per-quad-pos 1/(white-black)
    int cPitch;       // sensor row stride in pixels
    int _pad0;
    ivec2 oDims;      // output W/H (encode res)
    vec4 gGains;      // R, G, B white-balance gains (+1 spare, folded: unused)
    vec4 gCcmR;
    vec4 gCcmG;
    vec4 gCcmB;
    vec4 gMisc;       // exposureEV, yStrideW, uvStrideW, uvBaseOffB
    ivec4 sDims;      // shade rows, cols, enable, outMode
    vec4 sActive;     // shade active l, t, 1/w, 1/h (sensor pixels)
};
layout(binding = 2) readonly buffer Fused { FusedParams u; };
// Reserved for upcoming LUT support: still bound every submit (the
// native gate requires the upload), not fetched (direct encode).
layout(binding = 3) uniform sampler3D gradeLut;
// HAL lens-shading map as RGBA16F (Camera2 order), hardware-bilinear
// sampled: 16 manual loads + weight ALU per texel cost ~7ms on this
// kernel (measured); one texture fetch is ~0.5ms.
layout(binding = 4) uniform sampler2D shadeMap;

// ---- MHC (port of vf_mhcyuv.comp; see its header) ----

// Green edge-gate band, mirrors MhcReference.GREEN_EDGE_T0/T1.
const float16_t GREEN_EDGE_T0 = 0.03hf;
const float16_t GREEN_EDGE_T1 = 0.08hf;
// Chroma side floor + level-ratio regularizer, mirrors
// MhcReference.BILATERAL_EPS/LEVEL_EPS.
const float16_t BILATERAL_EPS = 1.0e-3hf;
const float16_t LEVEL_EPS = 0.002hf;
// Sensor-white desaturation band, mirrors MhcReference.DESAT_LO/HI
// (same anchors as the AMaZE JPEG path).
const float16_t DESAT_LO = 0.70hf;
const float16_t DESAT_HI = 0.99hf;
// Demosaiced output ceiling, mirrors MhcReference.OUTPUT_CLAMP_HI.
const float16_t OUTPUT_CLAMP_HI = 4.0hf;

// Phase-preserving edge mirror (single reflection covers our +-2
// stencil on any dims >= 8).
int mir(int i, int n) {
    if (i < 0) i = -i;
    if (i >= n) i = 2 * n - 2 - i;
    return i;
}

// Quad offset (0..3) of crop pixel s in sensor phase.
int quadOf(ivec2 s) {
    return (((s.y + u.cOrigin.y) & 1) << 1) | ((s.x + u.cOrigin.x) & 1);
}

// CFA color 0=R 1=G 2=B by inverting channels[] (canonical 1 AND 2 are
// both green: Gr and Gb share a quad diagonal).
int colorAt(ivec2 s) {
    int q = quadOf(s);
    if (u.cChans.x == q) return 0;
    if (u.cChans.y == q || u.cChans.z == q) return 1;
    return 2;
}

// Unpack + normalize one sensor pixel from a precomputed plane index
// with precomputed quad phase. Single multiply-add, unclipped (kernel
// outputs are unclipped anyway; the grade packs clamped codes downstream).
float16_t normIdx(int idx, int q) {
    uint uu = uint(idx);
    uint word = codes[uu >> 1u];
    uint code = ((uu & 1u) == 0u) ? (word & 0xFFFFu) : (word >> 16u);
    return float16_t(code) * float16_t(u.cInvRange[q]) + float16_t(u.cNormBias[q]);
}

// Unpack + normalize from an already-loaded word (the caller
// guarantees word == codes[idx >> 1]) with a precomputed shift.
float16_t normShift(uint word, uint shift, int q) {
    uint code = (word >> shift) & 0xFFFFu;
    return float16_t(code) * float16_t(u.cInvRange[q]) + float16_t(u.cNormBias[q]);
}

// Edge path: mirror into range first (phase preserving), then unpack.
float16_t normEdge(ivec2 s) {
    ivec2 m = ivec2(mir(s.x, u.cDims.x), mir(s.y, u.cDims.y));
    int q = quadOf(m);
    int idx = (m.y + u.cOrigin.y) * u.cPitch + (m.x + u.cOrigin.x);
    return normIdx(idx, q);
}

// Level ratio for chroma rescaling (see MhcReference.levelRatio):
// (num + eps)/(den + eps) with both terms floored at eps. Taps here
// are unclipped FMA (sub-black noise reaches -0.067), so the floors
// bar division by ~zero (no INF/NaN speckle); the CPU computes the
// identical expression (no-op there: its taps clip at 0).
float16_t levelRatio(float16_t num, float16_t den) {
    return max(num + LEVEL_EPS, LEVEL_EPS) / max(den + LEVEL_EPS, LEVEL_EPS);
}

// Edge-directed green at R/B sites (reference op order): the two
// second-order directional estimates steered by gradient + same-color
// curvature, corner-blended to the symmetric MHC mean. (gh + gv) / 2
// IS the old MHC kernel, so flat fields and ramps are bit-identical.
float16_t greenDir(float16_t c, float16_t n, float16_t so, float16_t w, float16_t e,
                   float16_t n2, float16_t s2, float16_t w2, float16_t e2) {
    float16_t ch = 2.0hf * c - w2 - e2;
    float16_t cv = 2.0hf * c - n2 - s2;
    float16_t gh = 0.5hf * (w + e) + 0.25hf * ch;
    float16_t gv = 0.5hf * (n + so) + 0.25hf * cv;
    float16_t dh = abs(w - e) + 0.5hf * abs(ch);
    float16_t dv = abs(n - so) + 0.5hf * abs(cv);
    float16_t gd = (dh < dv) ? gh : gv;
    float16_t gm = 0.5hf * (gh + gv);
    float16_t t = clamp((min(dh, dv) - GREEN_EDGE_T0) / (GREEN_EDGE_T1 - GREEN_EDGE_T0), 0.0hf, 1.0hf);
    return mix(gd, gm, t);
}

// Full MHC interpolate at crop pixel s (13 taps, reference op order).
f16vec3 mhcRgb(ivec2 s) {
    float16_t c;
    float16_t n;
    float16_t so;
    float16_t w;
    float16_t e;
    float16_t n2;
    float16_t s2;
    float16_t w2;
    float16_t e2;
    float16_t nw;
    float16_t ne;
    float16_t sw;
    float16_t se;
    if (all(greaterThanEqual(s, ivec2(2))) && all(lessThan(s, u.cDims - ivec2(2)))) {
        int sx = s.x + u.cOrigin.x;
        int sy = s.y + u.cOrigin.y;
        int q0 = ((sy & 1) << 1) | (sx & 1);
        int qE = q0 ^ 1;
        int qS = q0 ^ 2;
        int qD = q0 ^ 3;
        int P = u.cPitch;
        int base = sy * P + sx;
        uint wN2 = codes[uint(base - 2 * P) >> 1u];
        uint wNm = codes[uint(base - P - 1) >> 1u];
        uint wNp = codes[uint(base - P + 1) >> 1u];
        uint wCm = codes[uint(base - 2) >> 1u];
        uint wC0 = codes[uint(base) >> 1u];
        uint wCp = codes[uint(base + 2) >> 1u];
        uint wSm = codes[uint(base + P - 1) >> 1u];
        uint wSp = codes[uint(base + P + 1) >> 1u];
        uint wS2 = codes[uint(base + 2 * P) >> 1u];
        uint wN = (((base - P) & 1) == 0) ? wNp : wNm;
        uint wS = (((base + P) & 1) == 0) ? wSp : wSm;
        uint wW = ((base & 1) == 0) ? wCm : wC0;
        uint wE = ((base & 1) == 0) ? wC0 : wCp;
        uint s0 = uint(base & 1) * 16u;
        uint s1 = 16u - s0;
        uint sP = ((P & 1) == 0) ? s0 : s1;
        uint sD = ((P & 1) == 0) ? s1 : s0;
        c = normShift(wC0, s0, q0);
        n = normShift(wN, sP, qS);
        so = normShift(wS, sP, qS);
        w = normShift(wW, s1, qE);
        e = normShift(wE, s1, qE);
        n2 = normShift(wN2, s0, q0);
        s2 = normShift(wS2, s0, q0);
        w2 = normShift(wCm, s0, q0);
        e2 = normShift(wCp, s0, q0);
        nw = normShift(wNm, sD, qD);
        ne = normShift(wNp, sD, qD);
        sw = normShift(wSm, sD, qD);
        se = normShift(wSp, sD, qD);
    } else {
        c = normEdge(s);
        n = normEdge(s + ivec2(0, -1));
        so = normEdge(s + ivec2(0, 1));
        w = normEdge(s + ivec2(-1, 0));
        e = normEdge(s + ivec2(1, 0));
        n2 = normEdge(s + ivec2(0, -2));
        s2 = normEdge(s + ivec2(0, 2));
        w2 = normEdge(s + ivec2(-2, 0));
        e2 = normEdge(s + ivec2(2, 0));
        nw = normEdge(s + ivec2(-1, -1));
        ne = normEdge(s + ivec2(1, -1));
        sw = normEdge(s + ivec2(-1, 1));
        se = normEdge(s + ivec2(1, 1));
    }
    // Edge-gate bank shared by green and chroma (see vf_mhc.comp).
    float16_t ch = 2.0hf * c - w2 - e2;
    float16_t cv = 2.0hf * c - n2 - s2;
    float16_t dh = abs(w - e) + 0.5hf * abs(ch);
    float16_t dv = abs(n - so) + 0.5hf * abs(cv);
    float16_t gt = clamp((min(dh, dv) - GREEN_EDGE_T0) / (GREEN_EDGE_T1 - GREEN_EDGE_T0), 0.0hf, 1.0hf);
    float16_t gf = clamp((GREEN_EDGE_T0 - max(dh, dv)) / GREEN_EDGE_T0, 0.0hf, 1.0hf);
    float16_t gg = max(gt, gf);
    bool hEdge = dh < dv;
    int col = colorAt(s);
    float16_t r;
    float16_t g;
    float16_t b;
    if (col == 0) {
        r = c;
        g = greenDir(c, n, so, w, e, n2, s2, w2, e2);
        float16_t dw = 0.5hf * (nw + sw) - w;
        float16_t de = 0.5hf * (ne + se) - e;
        float16_t dn = 0.5hf * (nw + ne) - n;
        float16_t ds = 0.5hf * (sw + se) - so;
        float16_t oppDir;
        if (hEdge) {
            float16_t wN = BILATERAL_EPS + abs(c - s2);
            float16_t wS = BILATERAL_EPS + abs(c - n2);
            float16_t rN = levelRatio(g, n);
            float16_t rS = levelRatio(g, so);
            oppDir = g + (wN * dn * rN + wS * ds * rS) / (wN + wS);
        } else {
            float16_t wW = BILATERAL_EPS + abs(c - e2);
            float16_t wE = BILATERAL_EPS + abs(c - w2);
            float16_t rW = levelRatio(g, w);
            float16_t rE = levelRatio(g, e);
            oppDir = g + (wW * dw * rW + wE * de * rE) / (wW + wE);
        }
        float16_t v = 6.0hf * c;
        v += 2.0hf * (nw + ne + sw + se);
        v -= 1.5hf * (n2 + s2 + w2 + e2);
        b = mix(oppDir, v * 0.125hf, gg);
    } else if (col == 2) {
        g = greenDir(c, n, so, w, e, n2, s2, w2, e2);
        float16_t dw = 0.5hf * (nw + sw) - w;
        float16_t de = 0.5hf * (ne + se) - e;
        float16_t dn = 0.5hf * (nw + ne) - n;
        float16_t ds = 0.5hf * (sw + se) - so;
        float16_t oppDir;
        if (hEdge) {
            float16_t wN = BILATERAL_EPS + abs(c - s2);
            float16_t wS = BILATERAL_EPS + abs(c - n2);
            float16_t rN = levelRatio(g, n);
            float16_t rS = levelRatio(g, so);
            oppDir = g + (wN * dn * rN + wS * ds * rS) / (wN + wS);
        } else {
            float16_t wW = BILATERAL_EPS + abs(c - e2);
            float16_t wE = BILATERAL_EPS + abs(c - w2);
            float16_t rW = levelRatio(g, w);
            float16_t rE = levelRatio(g, e);
            oppDir = g + (wW * dw * rW + wE * de * rE) / (wW + wE);
        }
        float16_t v = 6.0hf * c;
        v += 2.0hf * (nw + ne + sw + se);
        v -= 1.5hf * (n2 + s2 + w2 + e2);
        r = mix(oppDir, v * 0.125hf, gg);
        b = c;
    } else {
        g = c;
        float16_t gwW = hEdge ? 0.5hf * (c + w2) : 0.5hf * (nw + sw);
        float16_t gwE = hEdge ? 0.5hf * (c + e2) : 0.5hf * (ne + se);
        float16_t wW = BILATERAL_EPS + abs(c - e2);
        float16_t wE = BILATERAL_EPS + abs(c - w2);
        float16_t rW = levelRatio(c, gwW);
        float16_t rE = levelRatio(c, gwE);
        float16_t ewOut = c + (wW * (w - gwW) * rW + wE * (e - gwE) * rE) / (wW + wE);
        float16_t gnN = hEdge ? 0.5hf * (nw + ne) : 0.5hf * (c + n2);
        float16_t gnS = hEdge ? 0.5hf * (sw + se) : 0.5hf * (c + s2);
        float16_t wN = BILATERAL_EPS + abs(c - s2);
        float16_t wS = BILATERAL_EPS + abs(c - n2);
        float16_t rN = levelRatio(c, gnN);
        float16_t rS = levelRatio(c, gnS);
        float16_t nsOut = c + (wN * (n - gnN) * rN + wS * (so - gnS) * rS) / (wN + wS);
        float16_t vr = 5.0hf * c;
        vr += 4.0hf * (w + e);
        vr -= w2 + e2;
        vr -= nw + ne + sw + se;
        vr += 0.5hf * (n2 + s2);
        vr *= 0.125hf;
        float16_t vc = 5.0hf * c;
        vc += 4.0hf * (n + so);
        vc -= n2 + s2;
        vc -= nw + ne + sw + se;
        vc += 0.5hf * (w2 + e2);
        vc *= 0.125hf;
        if (colorAt(s + ivec2(1, 0)) == 0) {
            r = mix(ewOut, vr, gg);
            b = mix(nsOut, vc, gg);
        } else {
            r = mix(nsOut, vc, gg);
            b = mix(ewOut, vr, gg);
        }
    }
    // Clamp negatives like RawTherapee (a camera matrix turns edge
    // undershoot into complementary fringes); overshoot clamps at
    // OUTPUT_CLAMP_HI.
    return f16vec3(clamp(r, 0.0hf, OUTPUT_CLAMP_HI), clamp(g, 0.0hf, OUTPUT_CLAMP_HI), clamp(b, 0.0hf, OUTPUT_CLAMP_HI));
}

// ---- direct-encode record grade: no warp, no saturation ----
// Identical to the grade-YUV stage: the two record paths agree by
// construction. CPU goldens are VfLogGrade.encodePixel*.
f16vec3 bt709Encode(f16vec3 v) {
    v = clamp(v, 0.0hf, 1.0hf);
    f16vec3 lo = 4.5hf * v;
    f16vec3 hi = 1.099hf * pow(v, f16vec3(0.45hf)) - 0.099hf;
    return mix(hi, lo, f16vec3(lessThan(v, f16vec3(0.018hf))));
}

float16_t hlgOetf(float16_t e) {
    e = clamp(e, 0.0hf, 1.0hf);
    if (e <= 1.0hf / 12.0hf) return sqrt(3.0hf * e);
    // Natural log (BT.2100 Table 5); rounded constants overshoot 1.0
    // by ~8e-5 at E = 1, hence the clamp.
    return clamp(0.17883277hf * log(12.0hf * e - 0.28466892hf) + 0.55991073hf, 0.0hf, 1.0hf);
}

f16vec3 hlgEncode(f16vec3 v2020) {
    return f16vec3(hlgOetf(v2020.r), hlgOetf(v2020.g), hlgOetf(v2020.b));
}

// Linear sRGB (D65) -> linear BT.2020 (D65), dot form (avoids mat3
// layout pitfalls); mirrors VfLogGrade.SRGB_TO_BT2020.
f16vec3 srgbToBt2020(f16vec3 v) {
    return f16vec3(
        dot(v, f16vec3(0.6274040hf, 0.3292820hf, 0.0433136hf)),
        dot(v, f16vec3(0.0690970hf, 0.9195400hf, 0.0113612hf)),
        dot(v, f16vec3(0.0163916hf, 0.0880132hf, 0.8955950hf)));
}

// Sony S-Log3, normalized (same mapping as vf_loggrade.comp):
// divisor 0.19, 95-code black pedestal.
float16_t slog3cutY() {
    return (420.0hf + log2((0.01125hf + 0.01hf) / 0.19hf) * 0.30102999566hf * 261.5hf) / 1023.0hf;
}

float16_t sonySlog3(float16_t x) {
    x = max(x, 0.0hf);
    if (x >= 0.01125hf) {
        // log10 via log2 (GLSL has no log10): 1/log2(10) = 0.30103.
        return (420.0hf + log2((x + 0.01hf) / 0.19hf) * 0.30102999566hf * 261.5hf) / 1023.0hf;
    }
    return (95.0hf + x * (slog3cutY() * 1023.0hf - 95.0hf) / 0.01125hf) / 1023.0hf;
}

f16vec3 slogEncode(f16vec3 v) {
    return f16vec3(sonySlog3(v.r), sonySlog3(v.g), sonySlog3(v.b));
}

// Grade: direct profile encode of the developed linear value. CCM
// arrives WB+exposure-folded on the CPU. outMode (u.sDims.w): 0 =
// BT.709, 1 = Sony S-Log3 (flat), 2 = BT.2020 + HLG. The branch is
// SSBO-uniform: no divergence.
f16vec3 gradeRgb(f16vec3 rgb) {
    f16vec3 developed = f16vec3(dot(f16vec3(u.gCcmR.rgb), rgb), dot(f16vec3(u.gCcmG.rgb), rgb), dot(f16vec3(u.gCcmB.rgb), rgb));
    int mode = u.sDims.w;
    if (mode == 1) return slogEncode(developed);
    if (mode == 2) return hlgEncode(srgbToBt2020(developed));
    return bt709Encode(developed);
}

// Lens-shading gains (R, Gr, Gb, B) at sensor pixel s, one hardware-
// bilinear texture fetch. The (mx + 0.5) / size un-mapping cancels the
// sampler's half-texel convention, so the weights equal
// LensShadingModel.gainAt per channel (same clamp/edge behavior, incl.
// 1-wide maps) up to fp16/fp32 rounding (gains are smooth, ~0.1%).
f16vec4 shadeGains(ivec2 s) {
    float16_t nx = clamp((float16_t(s.x) - float16_t(u.sActive.x)) * float16_t(u.sActive.z), 0.0hf, 1.0hf);
    float16_t ny = clamp((float16_t(s.y) - float16_t(u.sActive.y)) * float16_t(u.sActive.w), 0.0hf, 1.0hf);
    float16_t mx = nx * float16_t(u.sDims.y - 1);
    float16_t my = ny * float16_t(u.sDims.x - 1);
    f16vec2 uv = f16vec2((mx + 0.5hf) / float16_t(u.sDims.y), (my + 0.5hf) / float16_t(u.sDims.x));
    return f16vec4(texture(shadeMap, uv));
}

// Sensor-domain white-point protection (CPU mirror:
// MhcReference.desaturateHighlights; same formula as the AMaZE JPEG
// final stage): approaching RAW clip, converge on the camera neutral
// BEFORE white balance, so clipped white renders white instead of
// magenta. Pre-shade: clip is sensor saturation, and shade would drag
// amplified midtones into the band (the shading proof pins 2x gains).
f16vec3 desatWhite(f16vec3 rgb) {
    f16vec3 gains = max(f16vec3(u.gGains.rgb), f16vec3(1.0e-6hf));
    float16_t minG = min(gains.r, min(gains.g, gains.b));
    f16vec3 neutral = f16vec3(minG) / gains;
    f16vec3 wb = smoothstep(f16vec3(DESAT_LO), f16vec3(DESAT_HI), rgb);
    float16_t blend = max(wb.r, max(wb.g, wb.b));
    return mix(rgb, neutral, blend);
}

// Display RGB for one output texel (nearest src cover + MHC + grade).
f16vec3 pixelLog(ivec2 ij) {
    // Integer coverage: floor((ij + 0.5) * cDims / oDims) as
    // floor((2*ij + 1) * cDims / (2*oDims)) — exact, where fp16 would
    // round 4K coordinates to even and mis-cover edge texels.
    ivec2 s = ((ij * 2 + 1) * u.cDims) / (2 * u.oDims);
    f16vec3 rgb = desatWhite(mhcRgb(s));
    if (u.sDims.z != 0) {
        // Vignetting, pre-WB like the viewfinder: the map is ~17x17 over
        // the sensor, so one gain per output texel (not per MHC tap) is
        // exact to 0.01%. Demosaiced green mixes both parities: mean them.
        f16vec4 sg = shadeGains(s + u.cOrigin);
        rgb *= f16vec3(sg.x, 0.5hf * (sg.y + sg.z), sg.w);
    }
    return gradeRgb(rgb);
}

f16vec3 rgbToYuv(f16vec3 rgb, int mode) {
    if (mode == 2) {
        // BT.2020 non-constant luminance (Kr = 0.2627, Kb = 0.0593).
        float16_t y = 0.2627hf * rgb.r + 0.6780hf * rgb.g + 0.0593hf * rgb.b;
        float16_t cb = (rgb.b - y) / 1.8814hf + 0.5hf;
        float16_t cc = (rgb.r - y) / 1.4746hf + 0.5hf;
        return f16vec3(y, cb, cc);
    }
    float16_t y = 0.2126hf * rgb.r + 0.7152hf * rgb.g + 0.0722hf * rgb.b;
    float16_t cb = (rgb.b - y) / (2.0hf * (1.0hf - 0.0722hf)) + 0.5hf;
    float16_t cc = (rgb.r - y) / (2.0hf * (1.0hf - 0.2126hf)) + 0.5hf;
    return f16vec3(y, cb, cc);
}

uint pack10(float16_t v, float16_t low, float16_t high) {
    uint code = uint(round(clamp(v, 0.0hf, 1.0hf) * (high - low) + low));
    return (code << 6) & 0xFFC0u;
}

void main() {
    ivec2 ij = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(ij, u.oDims))) return;
    // Storage is u32 words but P010 codes are u16: every store packs a
    // pair. Y pairs go to even-x invocations (odd-x has no unique word);
    // UV pairs are naturally (U, V).
    if ((ij.x & 1) != 0) return;
    int yStride = int(u.gMisc.y);  // u16 words per Y row
    int outMode = u.sDims.w;
    f16vec3 lg0 = pixelLog(ij);
    f16vec3 lg1 = (ij.x + 1 < u.oDims.x) ? pixelLog(ij + ivec2(1, 0)) : lg0;
    f16vec3 yuv0 = rgbToYuv(lg0, outMode);
    f16vec3 yuv1 = rgbToYuv(lg1, outMode);
    uint yCode0 = pack10(yuv0.x, 64.0hf, 940.0hf);
    uint yCode1 = pack10(yuv1.x, 64.0hf, 940.0hf);
    uint yIdx = uint(ij.y) * uint(yStride) + uint(ij.x);  // u16 units
    buf_out.words[yIdx >> 1u] = yCode0 | (yCode1 << 16u);
    if ((ij.y & 1) == 0) {
        // Chroma is this pair's mean (zero extra taps; rgbToYuv is
        // linear so the mean of converts equals the convert of the
        // mean).
        f16vec3 muv = (yuv0 + yuv1) * 0.5hf;
        uint uCode = pack10(muv.g, 64.0hf, 960.0hf);
        uint vCode = pack10(muv.b, 64.0hf, 960.0hf);
        // u16-unit pair address (always even: strides/height are even,
        // so >>1 below is exact).
        uint pairIdx = uint(u.gMisc.w) / 2u
            + uint(ij.y / 2) * uint(u.gMisc.z)
            + uint(ij.x / 2) * 2u;
        buf_out.words[pairIdx >> 1u] = uCode | (vCode << 16u);
    }
}
