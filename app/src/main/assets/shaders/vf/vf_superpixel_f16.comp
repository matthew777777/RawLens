//
// Direct-Log variant of the superpixel: identical integer core, but the output is
// RGBA16F so the log grade downstream keeps >8-bit precision (no banding
// in the 10-bit encode). The viewfinder keeps its own RGBA8 variant
// (vf_superpixel); the push-constant layout is shared, so both pipelines
// use the same descriptor set layout and packing. Levels are the same Q6
// blackQ/denQ bits (see VfLevels.kt); the interior value crosses one
// correctly-rounded division (operands < 2^24, error << fp16 ulp).
//
// Regenerate the SPIR-V with:
//   glslangValidator -V --target-env vulkan1.1 vf_superpixel_f16.comp -o vf_superpixel_f16.spv
#version 450
layout(local_size_x = 8, local_size_y = 8) in;

// Byte-exact buffer view of the sensor plane: the driver reports a padded
// rowPitch (4096) for image imports of a packed 4080-pixel buffer, so images
// sample skewed. Buffers have no pitch ambiguity; stride comes from the Image
// plane (the same value the correct CPU path uses). Each uint holds 2 LE pixels.
layout(binding = 0) readonly buffer Bayer { uint codes[]; };
layout(binding = 1, rgba16f) uniform writeonly image2D img_out;
// HAL lens-shading map as RGBA16F (Camera2 order), hardware-bilinear
// sampled. Only the record path binds a live map (the viewfinder
// shades in GL); enable stays 0 otherwise.
layout(binding = 2) uniform sampler2D shadeMap;

// Packing order avoids std430 padding surprises: 16-byte members first.
// Total 112 bytes (8 pad after u_pitch for the vec4 alignment); the C
// side mirrors this layout exactly.
layout(push_constant) uniform Params {
    ivec4 u_chans;
    vec4 u_black;
    vec4 u_invRange;
    ivec2 u_quadBase;
    ivec2 u_frameSize;
    int u_step;
    int u_pitch;
    ivec4 u_shadeDims;    // shade rows, cols, enable, 0
    vec4 u_shadeActive;   // shade active l, t, 1/w, 1/h (sensor px)
} p;

uint fetchCode(ivec2 s) {
    uint idx = uint(s.y) * uint(p.u_pitch) + uint(s.x);
    uint word = codes[idx >> 1u];
    return ((idx & 1u) == 0u) ? (word & 0xFFFFu) : (word >> 16u);
}

// Runtime-specialized unpack: black/white for the exact RAW bit depth are baked
// into Q6 ints on the CPU (bit-cast through u_black/u_invRange), so this is
// a straight-line fetch + integer normalize with dynamic uniform indexing
// and no per-channel branches. Clip decisions are integer-exact; the
// interior value is the 16-bit fixed-point ratio through one division.
float fetchN(ivec2 q, int ch) {
    ivec2 s = q + ivec2(ch & 1, (ch >> 1) & 1);
    int code = int(fetchCode(s));
    int bq = floatBitsToInt(p.u_black[ch]);
    int dq = floatBitsToInt(p.u_invRange[ch]);
    int num = code * 64 - bq;
    if (num <= 0) return 0.0;
    if (num >= dq) return 1.0;
    return float(num) / float(dq);
}

// Lens-shading gains (R, Gr, Gb, B) for one quad, one hardware-
// bilinear texture fetch at the quad origin (intra-quad variation is
// negligible — the map is ~17x17 over the sensor; the GL viewfinder
// samples the same way, so the record twin agrees with it texel for
// texel). Output slots are canonical R/Gr/Gb/B; the green slots take
// the map channel of their own sensor row parity (Gr sits on even or
// odd rows depending on CFA phase).
vec4 shadeQuad(ivec2 q, ivec4 ch) {
    float nx = clamp((float(q.x) - p.u_shadeActive.x) * p.u_shadeActive.z, 0.0, 1.0);
    float ny = clamp((float(q.y) - p.u_shadeActive.y) * p.u_shadeActive.w, 0.0, 1.0);
    float mx = nx * float(p.u_shadeDims.y - 1);
    float my = ny * float(p.u_shadeDims.x - 1);
    vec2 uv = vec2((mx + 0.5) / float(p.u_shadeDims.y), (my + 0.5) / float(p.u_shadeDims.x));
    vec4 g = texture(shadeMap, uv);
    int p1 = (q.y + ((ch.y >> 1) & 1)) & 1;
    int p2 = (q.y + ((ch.z >> 1) & 1)) & 1;
    float gr = (p1 == 0) ? g.y : g.z;
    float gb = (p2 == 0) ? g.y : g.z;
    return vec4(g.x, gr, gb, g.w);
}

// Canonical R/Gr/Gb/B of quad k (quad units from u_quadBase), clamped
// into the crop so edges replicate.
vec4 quadN(ivec2 k) {
    ivec2 quads = p.u_frameSize * (p.u_step / 2);
    ivec2 q = p.u_quadBase + 2 * clamp(k, ivec2(0), quads - 1);
    return vec4(fetchN(q, p.u_chans.x), fetchN(q, p.u_chans.y),
                fetchN(q, p.u_chans.z), fetchN(q, p.u_chans.w));
}

// Step 2: CENTRE-ALIGNED superpixel. A plain 2x2 quad puts R and B half
// a pixel apart (opposite quad corners), which reads as cyan/yellow
// fringes on every edge and highlight. R and B are instead bilinearly
// resampled to the quad centre from their 4 nearest same-colour sites
// (9/16, 3/16, 3/16, 1/16 on the 2 px colour grid); green is the Gr/Gb
// mean, already centred. Measured on a real Direct-Log frame vs
// RawTherapee AMaZE box-downscaled 2x: display error 0.0433 -> 0.0332.
// Steps > 2: BLOCK MEAN of every quad in the step x step block (the
// point sample skipped 3/4 of the sensor at step 4: aliasing and noise;
// 0.0554 -> 0.0234 vs AMaZE/4). CPU twin: RecordSuperpixel.
//
// Which neighbour direction holds the next R/B site depends on the CFA
// phase: canonical slot (ch) sits at quad offset (ch & 1, ch >> 1); R
// at offset 0 needs +1 quads, at offset 1 needs -1 quads (per axis).
vec4 superpixel(ivec2 ij) {
    int hq = p.u_step / 2;
    ivec2 k0 = ij * hq;
    if (hq == 1) {
        vec4 c = quadN(k0);
        ivec2 dr = ivec2(1 - 2 * (p.u_chans.x & 1), 1 - 2 * ((p.u_chans.x >> 1) & 1));
        ivec2 db = ivec2(1 - 2 * (p.u_chans.w & 1), 1 - 2 * ((p.u_chans.w >> 1) & 1));
        float r = (9.0 * c.x + 3.0 * quadN(k0 + ivec2(dr.x, 0)).x
                   + 3.0 * quadN(k0 + ivec2(0, dr.y)).x + quadN(k0 + dr).x) * (1.0 / 16.0);
        float b = (9.0 * c.w + 3.0 * quadN(k0 + ivec2(db.x, 0)).w
                   + 3.0 * quadN(k0 + ivec2(0, db.y)).w + quadN(k0 + db).w) * (1.0 / 16.0);
        return vec4(r, c.y, c.z, b);
    }
    vec4 sum = vec4(0.0);
    for (int y = 0; y < hq; ++y) {
        for (int x = 0; x < hq; ++x) {
            sum += quadN(k0 + ivec2(x, y));
        }
    }
    return sum / float(hq * hq);
}

void main() {
    ivec2 ij = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(ij, p.u_frameSize))) return;
    ivec2 q = p.u_quadBase + ij * p.u_step;
    vec4 b = superpixel(ij);
    if (p.u_shadeDims.z != 0) {
        b *= shadeQuad(q, p.u_chans);
    }
    imageStore(img_out, ij, b);
}
