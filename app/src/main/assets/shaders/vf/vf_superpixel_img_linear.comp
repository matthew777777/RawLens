// High precision live VF variant. Q6 black/white levels are retained, but
// sensor codes are normalized directly to RGBA16F without the byte LUT.
// Lens shading, WB, CCM and tonemapping run after this export in GL/BGU.
// Regenerate: glslangValidator -V --target-env vulkan1.1 <source> -o <name>.spv
#version 450
layout(local_size_x = 8, local_size_y = 8) in;

// Sampled-image view of the sensor plane: the HAL buffer is
// imported as a VK_FORMAT_R16_UINT VkImage (OPTIMAL tiling, SAMPLED usage)
// and fetched texel-exact. No pitch/tiling ambiguity reaches the shader;
// buffers that cannot expose R16_UINT sampled are rejected natively and the
// caller falls back to the lock+memcpy upload tier.
layout(binding = 0) uniform usampler2D rawImg;
layout(binding = 1, rgba16f) uniform writeonly image2D img_out;
// HAL lens-shading map as RGBA16F (Camera2 order), hardware-bilinear
// sampled. Only the record path binds a live map (the viewfinder
// shades in GL); enable stays 0 otherwise.
layout(binding = 2) uniform sampler2D shadeMap;
// Reserved binding: shared pipeline layout with the legacy byte proof shader.
layout(binding = 3) readonly buffer Lut { uint lut[]; };

// Packing order avoids std430 padding surprises: 16-byte members first.
// Total 112 bytes (8 pad after u_pitch for the vec4 alignment); the C
// side mirrors this layout exactly. u_black/u_invRange carry Q6
// blackQ/denQ ints bit-cast to float (see VfLevels.kt).
layout(push_constant) uniform Params {
    ivec4 u_chans;
    vec4 u_black;
    vec4 u_invRange;
    ivec2 u_quadBase;
    ivec2 u_frameSize;
    int u_step;
    int u_pitch;
    ivec4 u_shadeDims;    // shade rows, cols, enable, 0
    vec4 u_shadeActive;   // shade active l, t, 1/w, 1/h (sensor px)
} p;

uint fetchCode(ivec2 s) {
    return texelFetch(rawImg, s, 0).r;
}

float fetchLinear(ivec2 q, int ch) {
    ivec2 s = q + ivec2(ch & 1, (ch >> 1) & 1);
    int num = int(texelFetch(rawImg, s, 0).r) * 64 - floatBitsToInt(p.u_black[ch]);
    return clamp(float(num) / float(floatBitsToInt(p.u_invRange[ch])), 0.0, 1.0);
}

// Lens-shading gains (R, Gr, Gb, B) for one quad, one hardware-
// bilinear texture fetch at the quad origin (intra-quad variation is
// negligible — the map is ~17x17 over the sensor; the GL viewfinder
// samples the same way). The viewfinder keeps enable at 0 (it shades
// in GL); the layout stays in sync with the f16 record twin, which
// shares the push block. Output slots are canonical R/Gr/Gb/B; the
// green slots take the map channel of their own sensor row parity (Gr
// sits on even or odd rows depending on CFA phase).
vec4 shadeQuad(ivec2 q, ivec4 ch) {
    float nx = clamp((float(q.x) - p.u_shadeActive.x) * p.u_shadeActive.z, 0.0, 1.0);
    float ny = clamp((float(q.y) - p.u_shadeActive.y) * p.u_shadeActive.w, 0.0, 1.0);
    float mx = nx * float(p.u_shadeDims.y - 1);
    float my = ny * float(p.u_shadeDims.x - 1);
    vec2 uv = vec2((mx + 0.5) / float(p.u_shadeDims.y), (my + 0.5) / float(p.u_shadeDims.x));
    vec4 g = texture(shadeMap, uv);
    int p1 = (q.y + ((ch.y >> 1) & 1)) & 1;
    int p2 = (q.y + ((ch.z >> 1) & 1)) & 1;
    float gr = (p1 == 0) ? g.y : g.z;
    float gb = (p2 == 0) ? g.y : g.z;
    return vec4(g.x, gr, gb, g.w);
}

void main() {
    ivec2 ij = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(ij, p.u_frameSize))) return;
    ivec2 q = p.u_quadBase + ij * p.u_step;
    vec4 b = vec4(fetchLinear(q, p.u_chans.x), fetchLinear(q, p.u_chans.y),
                  fetchLinear(q, p.u_chans.z), fetchLinear(q, p.u_chans.w));
    if (p.u_shadeDims.z != 0) {
        b *= shadeQuad(q, p.u_chans);
    }
    imageStore(img_out, ij, b);
}
