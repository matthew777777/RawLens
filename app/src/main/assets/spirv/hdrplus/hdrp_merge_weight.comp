#version 450
// Port of hdr-plus-swift compute_merge_weight: the companion's weight falls
// linearly from 1 (no difference) to 0 at noise_sd / robustness.
// RawLens extension (step-4 strength maps, marked patch): optional per-block
// robustness map (binding 3, one float per 32px block, N maps concatenated).
// mapOffset >= 0 selects this companion's map slice and the cell's block
// robustness wins; negative keeps the upstream computation (map ignored,
// verified <=1 DN @16-bit rescheduling dust vs the pre-patch shader).
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, r32f) readonly uniform image2D diff;
layout(set = 0, binding = 1, r32f) writeonly uniform image2D weight;
layout(std430, set = 0, binding = 2) readonly buffer Noise { float v[]; } noise;
layout(std430, set = 0, binding = 3) readonly buffer StrengthMap { float r[]; } smap;
layout(push_constant) uniform P {
    ivec2 cells;
    float robustness;
    int mapOffset;
    int pad;
} p;

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(q, p.cells))) return;
    float R = p.robustness;
    if (p.mapOffset >= 0) {
        ivec2 b = q >> 4;  // 32px map blocks over 2px weight cells
        int mw = (p.cells.x + 15) >> 4;
        R = smap.r[p.mapOffset + b.y * mw + b.x];
    }
    float w = 1.0;
    if (R != 0.0) {
        float maxDiff = noise.v[0] / R;
        w = clamp(1.0 - imageLoad(diff, q).x / maxDiff, 0.0, 1.0);
    }
    imageStore(weight, q, vec4(w));
}
