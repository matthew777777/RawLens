#version 450
// Port of hdr-plus-swift convert_to_bayer + crop_texture + add_texture: adds
// one pass's merged RGBA (unpacked to Bayer, offset by the pass padding) into
// the raw-domain accumulator. mode 0 overwrites (first pass).
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rgba32f) readonly uniform image2D merged;
layout(set = 0, binding = 1, r32f) uniform image2D accum;
layout(push_constant) uniform P {
    ivec2 size;    // RAW extent
    ivec2 offset;  // pass padding minus the merge crop, raw pixels
    int mode;
} p;

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(q, p.size))) return;
    ivec2 s = q + p.offset;
    float v = imageLoad(merged, s / 2)[(s.y & 1) * 2 + (s.x & 1)];
    imageStore(accum, q, vec4(p.mode == 0 ? v : imageLoad(accum, q).x + v));
}
