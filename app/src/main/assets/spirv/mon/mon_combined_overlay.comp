#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, r16ui) uniform readonly uimage2D rawStateImage;
layout(set = 0, binding = 1, rgba8) uniform readonly image2D displayImage;
layout(set = 0, binding = 2, rgba8) uniform readonly image2D displayImageFocus;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D overlayImage;

layout(std140, set = 0, binding = 4) uniform CombinedParams {
    uvec4 meta0;  // x raw flags (bit0 highlight), y width, z height, w false-color rangeCount
    uvec4 meta1;  // x focus enabled, y false-color enabled, z tonemap-shadow enabled, w reserved
    vec4 focusColor;
    vec4 focusControls;  // sensitivity, absoluteNoiseFloor, normalizationFloor, unused
    vec4 highlightColors[3];
    vec4 shadowControls;  // shadowsUI, blacksUI, thresholdIre, stripePeriod
    vec4 shadowColorA;
    vec4 shadowColorB;
    vec4 falseBounds[16];
    vec4 falseColors[16];
}
pc;

shared float lumaTile[144];
shared float alphaTile[100];

float lumaAt(ivec2 p) {
    p = clamp(p, ivec2(0), ivec2(int(pc.meta0.y) - 1, int(pc.meta0.z) - 1));
    vec3 rgb = clamp(imageLoad(displayImageFocus, p).rgb, vec3(0.0), vec3(1.0));
    return dot(rgb, vec3(0.2126, 0.7152, 0.0722));
}
float lload(int x, int y) { return lumaTile[y * 12 + x]; }
vec4 premul(vec4 c) {
    float a = clamp(c.a, 0.0, 1.0);
    return vec4(clamp(c.rgb, vec3(0.0), vec3(1.0)) * a, a);
}
vec4 over(vec4 top, vec4 bottom) { return top + bottom * (1.0 - top.a); }

// Emulate the RGBA8 storage-image round trip between standalone passes.
float q8s(float v) {
    v = clamp(v, 0.0, 1.0);
    return floor(v * 255.0 + 0.5) * (1.0 / 255.0);
}
vec4 q8(vec4 v) { return vec4(q8s(v.r), q8s(v.g), q8s(v.b), q8s(v.a)); }

uint logicalSeverity(uint word, uint offset) {
    uint n = (word >> offset) & 0xFu;
    uint r = n & 1u;
    uint g = ((n & 6u) != 0u) ? 1u : 0u;
    uint b = ((n & 8u) != 0u) ? 1u : 0u;
    return r + g + b;
}

vec4 falseColorAt(ivec2 p) {
    if (pc.meta1.y == 0u) return vec4(0.0);
    vec3 rgb = clamp(imageLoad(displayImage, p).rgb, vec3(0.0), vec3(1.0));
    float ire = 100.0 * dot(rgb, vec3(0.2126, 0.7152, 0.0722));
    uint count = min(pc.meta0.w, 16u);
    for (uint i = 0u; i < count; i++) {
        float lo = pc.falseBounds[i].x, hi = pc.falseBounds[i].y;
        bool inside = (ire >= lo) && ((ire < hi) || ((i + 1u == count) && (ire <= hi)));
        if (inside) return premul(pc.falseColors[i]);
    }
    return vec4(0.0);
}

float focusScoreAt(int x, int y) {
    float n00 = lload(x - 1, y - 1), n01 = lload(x, y - 1), n02 = lload(x + 1, y - 1);
    float n10 = lload(x - 1, y), c = lload(x, y), n12 = lload(x + 1, y);
    float n20 = lload(x - 1, y + 1), n21 = lload(x, y + 1), n22 = lload(x + 1, y + 1);
    float gx = (n02 + 2.0 * n12 + n22) - (n00 + 2.0 * n10 + n20);
    float gy = (n20 + 2.0 * n21 + n22) - (n00 + 2.0 * n01 + n02);
    float sobel = abs(gx) + abs(gy);
    float axial = abs(4.0 * c - n01 - n10 - n12 - n21);
    float diag = abs(4.0 * c - n00 - n02 - n20 - n22);
    float hf = sobel + 0.5 * (axial + 0.5 * diag);
    float localMean = (abs(n00) + abs(n01) + abs(n02) + abs(n10) + abs(c) + abs(n12) + abs(n20) + abs(n21) + abs(n22));
    localMean *= 1.0 / 9.0;
    float floorv = max(pc.focusControls.y, 0.0) * (1.0 + 0.5 * sqrt(max(localMean, 0.0)));
    return max(0.0, hf - floorv) / (localMean + max(pc.focusControls.z, 1e-6));
}

float focusAlphaFromScore(float score) {
    float s = clamp(pc.focusControls.x, 0.0, 1.0);
    float threshold = mix(4.0, 0.6, s);
    float width = max(0.08, threshold * 1.2);
    float u = clamp((score - threshold) / width, 0.0, 1.0);
    return u * u * (3.0 - 2.0 * u) * clamp(pc.focusColor.a, 0.0, 1.0);
}

vec4 shadowAt(ivec2 p) {
    if (pc.meta1.z == 0u) return vec4(0.0);
    vec3 rgb = clamp(imageLoad(displayImage, p).rgb, vec3(0.0), vec3(1.0));
    float ire = 100.0 * dot(rgb, vec3(0.2126, 0.7152, 0.0722));
    // WYSIWYG crushed-black zebra; slider positions already live in the pixels.
    if (ire >= clamp(pc.shadowControls.z, 0.0, 100.0)) return vec4(0.0);
    float period = max(2.0, pc.shadowControls.w);
    float stripe = mod(floor(float(p.x + p.y) / period), 2.0);
    return premul(stripe < 0.5 ? pc.shadowColorA : pc.shadowColorB);
}

vec4 rawHighlightAt(ivec2 p) {
    if ((pc.meta0.x & 1u) == 0u) return vec4(0.0);
    uint word = imageLoad(rawStateImage, p).r;
    uint s = logicalSeverity(word, 0u);
    if (s == 0u) return vec4(0.0);
    return premul(pc.highlightColors[s - 1u]);
}

void main() {
    uint lid = gl_LocalInvocationIndex;
    ivec2 origin = ivec2(gl_WorkGroupID.xy) * 8 - ivec2(2);
    // Fused pipeline needs display for false/shadow and focus luma.
    for (uint i = lid; i < 144u; i += 64u) {
        ivec2 q = ivec2(int(i % 12u), int(i / 12u));
        lumaTile[i] = lumaAt(origin + q);
    }
    barrier();
    // 10x10 focus alphas for 3x3 dilation.
    for (uint i = lid; i < 100u; i += 64u) {
        int ax = int(i % 10u);
        int ay = int(i / 10u);
        float a = 0.0;
        if (pc.meta1.x != 0u) a = focusAlphaFromScore(focusScoreAt(ax + 1, ay + 1));
        alphaTile[i] = a;
    }
    barrier();

    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.meta0.y) || p.y >= int(pc.meta0.z)) return;
    int x = int(gl_LocalInvocationID.x) + 1;
    int y = int(gl_LocalInvocationID.y) + 1;

    vec4 outv = vec4(0.0);

    if (pc.meta1.y != 0u) {
        outv = falseColorAt(p);
        outv = q8(outv);
    }

    if (pc.meta1.x != 0u) {
        float core = alphaTile[y * 10 + x];
        float m = 0.0;
        for (int dy = -1; dy <= 1; dy++)
            for (int dx = -1; dx <= 1; dx++) m = max(m, alphaTile[(y + dy) * 10 + (x + dx)]);
        float a = max(core, 0.4 * m);
        vec4 f = vec4(clamp(pc.focusColor.rgb, vec3(0.0), vec3(1.0)) * a, a);
        outv = (pc.meta1.y != 0u) ? over(f, outv) : f;
        outv = q8(outv);
    }

    if (pc.meta1.z != 0u) {
        vec4 s = shadowAt(p);
        bool have = (pc.meta1.x != 0u) || (pc.meta1.y != 0u);
        outv = have ? over(s, outv) : s;
        outv = q8(outv);
    }

    if ((pc.meta0.x & 1u) != 0u) {
        vec4 r = rawHighlightAt(p);
        bool have = (pc.meta1.x != 0u) || (pc.meta1.y != 0u) || (pc.meta1.z != 0u);
        outv = have ? over(r, outv) : r;
    }

    imageStore(overlayImage, p, outv);
}
