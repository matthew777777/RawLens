#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D displayImage;
layout(set = 0, binding = 1, rgba8) uniform image2D overlayImage;
layout(std140, set = 0, binding = 2) uniform FalseColorParamsBlock {
    uvec4 meta;       // rangeCount, width, height, compose
    vec4 bounds[16];  // low IRE, high IRE, unused, unused
    vec4 colors[16];
}
pc;

vec4 premul(vec4 c) {
    float a = clamp(c.a, 0.0, 1.0);
    return vec4(clamp(c.rgb, vec3(0.0), vec3(1.0)) * a, a);
}
vec4 over(vec4 top, vec4 bottom) { return top + bottom * (1.0 - top.a); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.meta.y) || p.y >= int(pc.meta.z)) return;
    vec3 rgb = clamp(imageLoad(displayImage, p).rgb, vec3(0.0), vec3(1.0));
    float ire = 100.0 * dot(rgb, vec3(0.2126, 0.7152, 0.0722));
    vec4 outv = vec4(0.0);
    uint count = min(pc.meta.x, 16u);
    for (uint i = 0u; i < count; i++) {
        float lo = pc.bounds[i].x, hi = pc.bounds[i].y;
        bool inside = (ire >= lo) && ((ire < hi) || ((i + 1u == count) && (ire <= hi)));
        if (inside) {
            outv = premul(pc.colors[i]);
            break;
        }
    }
    if (pc.meta.w != 0u) outv = over(outv, imageLoad(overlayImage, p));
    imageStore(overlayImage, p, outv);
}
