#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, r16ui) uniform readonly uimage2D stateImage;
layout(set = 0, binding = 1, rgba8) uniform image2D overlayImage;

layout(std140, set = 0, binding = 2) uniform RawParams {
    uvec4 meta;  // x flags: bit0 highlight, bit1 shadow-warning, bit2 shadow-clipped; y width; z height; w compose
    vec4 highlightColors[3];
    vec4 shadowWarningColors[3];
    vec4 shadowClippedColors[3];
}
pc;

uint logicalSeverity(uint word, uint offset) {
    uint n = (word >> offset) & 0xFu;
    uint r = n & 1u;
    uint g = ((n & 6u) != 0u) ? 1u : 0u;
    uint b = ((n & 8u) != 0u) ? 1u : 0u;
    return r + g + b;
}

vec4 premul(vec4 c) {
    float a = clamp(c.a, 0.0, 1.0);
    return vec4(clamp(c.rgb, vec3(0.0), vec3(1.0)) * a, a);
}

vec4 over(vec4 top, vec4 bottom) { return top + bottom * (1.0 - top.a); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.meta.y) || p.y >= int(pc.meta.z)) return;
    uint word = imageLoad(stateImage, p).r;
    vec4 outv = vec4(0.0);

    if ((pc.meta.x & 1u) != 0u) {
        uint s = logicalSeverity(word, 0u);
        if (s != 0u) outv = premul(pc.highlightColors[s - 1u]);
    }
    if (outv.a == 0.0 && (pc.meta.x & 4u) != 0u) {
        uint s = logicalSeverity(word, 12u);
        if (s != 0u) outv = premul(pc.shadowClippedColors[s - 1u]);
    }
    if (outv.a == 0.0 && (pc.meta.x & 2u) != 0u) {
        uint s = logicalSeverity(word, 8u);
        if (s != 0u) outv = premul(pc.shadowWarningColors[s - 1u]);
    }

    if (pc.meta.w != 0u) outv = over(outv, imageLoad(overlayImage, p));
    imageStore(overlayImage, p, outv);
}
