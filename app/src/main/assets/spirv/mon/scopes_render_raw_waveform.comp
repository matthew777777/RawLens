#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer RawWave { uint d[]; }
r;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform PC {
    uint mode;
    float gain;
    float opacity;
    uint showGrid;
    uint showBg;
    uint p0;
    uint p1;
    uint p2;
}
pc;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy), sz = imageSize(dst);
    if (any(greaterThanEqual(p, sz))) return;
    uint xb = min(255u, uint((float(p.x) + .5) * 256. / float(sz.x)));
    uint yb = min(63u, uint((1. - (float(p.y) + .5) / float(sz.y)) * 64.));
    vec3 col = pc.showBg != 0u ? vec3(.02) : vec3(0);
    if (pc.showGrid != 0u && ((p.x % max(sz.x / 4, 1)) == 0 || (p.y % max(sz.y / 4, 1)) == 0))
        col = max(col, vec3(.12));
    vec3 cc[4] = vec3[4](vec3(1, 0, 0), vec3(0, 1, .2), vec3(.2, 1, 0), vec3(0, 0, 1));
    for (uint c = 0u; c < 4u; ++c) {
        if (pc.mode != 0u && c != pc.mode - 1u) continue;
        uint den = r.d[c * 16384u + yb * 256u + xb];
        float a = (1.0 - exp(-max(pc.gain, 0.0001) * float(den))) * pc.opacity;
        col = max(col, cc[c] * a);
    }
    imageStore(dst, p, vec4(col, 1));
}
