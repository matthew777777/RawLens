    if (any(greaterThanEqual(h, u_size))) return;
    float sum = 0.0;
    int count = 0;
    for (int i = 0; i <= 1; i++) {
        for (int j = 0; j <= 1; j++) {
            ivec2 q = h * 2 + ivec2(j, i);
            if (any(greaterThanEqual(q, u_full_size))) continue;
            float v = texelFetch(u_gray, q, 0).r;
            if (!finite(v)) continue;
            sum += v;
            count++;
