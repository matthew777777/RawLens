// Unblocker half-quad box mean (Sabre UnblockerBlur analogue). One invocation
// per half-quad: the mean of its 2x2 quad taps from the full quad gray plane.
// Edge half-cells average the available taps; the count can never reach zero
// (every half-cell covers at least one quad). Mirrors the half-grid build in
// RawSrUnblocker.computeFrame exactly, including non-finite tap exclusion.
precision highp float;
precision highp int;
precision highp sampler2D;
precision highp image2D;
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D u_gray;
layout(binding = 1, r32f) writeonly uniform highp image2D img_half;
bool finite(float x) { return !isnan(x) && !isinf(x); }
