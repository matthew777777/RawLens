#version 450

// Tiled edge-aware a-trous (mirrors eaw_dn_decompose + accumulate).
// B3-spline 5x5, stride 2^scale, clamped tile-local reads. The tile carries a
// halo H >= 2*sum(mult) (+3*maxScale for modes 2/3) so inner pixels are exact.
//
// RawLens optimization of the RAWR shader. Modes 0/1 produce output
// byte-identical to RAWR (verified by tools/wavelet-parity/compare_optimization.py):
//
// mode 0 (estimate): taps -> coarse, detail, per-workgroup detail^2 partials.
//   applyPrev=1 first soft-thresholds the PREVIOUS scale's stored detail at
//   this pixel (thresh[scaleIdx-1]) into accum, before overwriting it. This
//   fuses RAWR's separate apply pass (which recomputed all 25 taps) into the
//   next estimate: same values, same accumulation order.
// mode 1 (apply only): no taps. Soft-threshold stored detail into accum.
//   Used once per tile, for the last scale.
// mode 2 (RawLens Wiener estimate): coarse + detail only, no statistics; the
//   apply step is denoise_img_wiener_apply.comp (separate pipeline so its
//   shared memory never lowers occupancy of these passes).
//
// accumFirst=1 writes accum instead of read-modify-write (replaces the clear).

#ifndef LOCAL_X
#define LOCAL_X 16
#endif
#ifndef LOCAL_Y
#define LOCAL_Y 16
#endif

layout(local_size_x = LOCAL_X, local_size_y = LOCAL_Y) in;

layout(set = 0, binding = 0, rgba16f) readonly uniform image2D fineImg;
layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D coarseImg;
layout(set = 0, binding = 2, rgba16f) uniform image2D accumImg;
layout(set = 0, binding = 3, std430) buffer Partials {
    vec4 sums[];
};
layout(set = 0, binding = 4, std430) readonly buffer Thresholds {
    vec4 thresh[];
};
layout(set = 0, binding = 5, rgba16f) uniform image2D detailImg;

layout(push_constant) uniform Parameters {
    uint tileEW; // extended tile extent (cropped per tile, >= inner+2H)
    uint tileEH;
    uint innerW;
    uint innerH;
    uint halo;
    uint mult; // 1u << scale
    float invSigma2;
    uint mode;
    uint scaleIdx;
    uint groupsX;
    uint applyPrev;
    uint accumFirst;
    float noiseY;   // mode 3: effective noise variance, luma
    float noiseUv;  // mode 3: effective noise variance, chroma
    float guide;    // mode 3: luma structure amplifies chroma's own signal evidence
    float keepY;    // mode 3: fraction of removed luma noise kept (grain)
    float eps;      // mode 3: chroma-on-luma slope regulariser (x luma noise)
}
p;

shared vec3 sdata[LOCAL_X * LOCAL_Y];

float b3tap(int i) {
    if (i == 0 || i == 4) return 1.0 / 16.0;
    if (i == 1 || i == 3) return 4.0 / 16.0;
    return 6.0 / 16.0;
}

vec3 coarseAt(ivec2 q, out vec3 c0) {
    const int mult = int(p.mult);
    c0 = imageLoad(fineImg, q).rgb;
    vec3 wgt = vec3(0.0);
    vec3 acc = vec3(0.0);
    for (int jj = 0; jj < 5; jj++) {
        int yy = clamp(q.y + mult * (jj - 2), 0, int(p.tileEH) - 1);
        for (int ii = 0; ii < 5; ii++) {
            int xx = clamp(q.x + mult * (ii - 2), 0, int(p.tileEW) - 1);
            vec3 v = imageLoad(fineImg, ivec2(xx, yy)).rgb;
            vec3 d = c0 - v;
            float e = dot(d, d) * p.invSigma2 * 0.02 - 9.0;
            float w = b3tap(jj) * b3tap(ii) * (e > 20.0 ? 0.0 : exp2(-max(e, 0.0)));
            wgt += vec3(w);
            acc += w * v;
        }
    }
    return acc / wgt;
}

void accumulate(ivec2 q, vec3 amt) {
    if (p.accumFirst != 0u) {
        imageStore(accumImg, q, vec4(amt, 0.0));
    } else {
        vec3 prev = imageLoad(accumImg, q).rgb;
        imageStore(accumImg, q, vec4(prev + amt, 0.0));
    }
}

vec3 softApply(ivec2 q, uint idx) {
    vec3 d = imageLoad(detailImg, q).rgb;
    vec3 t = thresh[idx].xyz;
    return max(d - t, vec3(0.0)) + min(d + t, vec3(0.0));
}

// Mode 2: plain estimate (coarse + detail), no statistics.
void wienerEstimate() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= int(p.tileEW) || q.y >= int(p.tileEH)) return;
    vec3 c0;
    vec3 cavg = coarseAt(q, c0);
    imageStore(coarseImg, q, vec4(cavg, 0.0));
    imageStore(detailImg, q, vec4(c0 - cavg, 0.0));
}

void main() {
    if (p.mode == 2u) {
        wienerEstimate();
        return;
    }
    uint lx = gl_GlobalInvocationID.x;
    uint ly = gl_GlobalInvocationID.y;
    uint lid = gl_LocalInvocationID.y * uint(LOCAL_X) + gl_LocalInvocationID.x;
    const bool inside = lx < p.tileEW && ly < p.tileEH;
    ivec2 q = ivec2(lx, ly);
    if (p.mode == 1u) {
        if (inside) accumulate(q, softApply(q, p.scaleIdx));
        return;
    }
    vec3 det = vec3(0.0);
    if (inside) {
        vec3 c0;
        vec3 cavg = coarseAt(q, c0);
        det = c0 - cavg;
        imageStore(coarseImg, q, vec4(cavg, 0.0));
        if (p.applyPrev != 0u) accumulate(q, softApply(q, p.scaleIdx - 1u));
        imageStore(detailImg, q, vec4(det, 0.0));
    }
    // Per-workgroup detail^2 partials. Threads outside the inner exact region
    // contribute zero so halo data never biases sums.
    vec3 mine = vec3(0.0);
    if (inside && lx >= p.halo && lx < p.halo + p.innerW && ly >= p.halo &&
        ly < p.halo + p.innerH) {
        mine = det * det;
    }
    sdata[lid] = mine;
    barrier();
    for (uint stride = uint((LOCAL_X * LOCAL_Y) / 2); stride > 0u; stride >>= 1u) {
        if (lid < stride) sdata[lid] += sdata[lid + stride];
        barrier();
    }
    if (lid == 0u) {
        uint wg = gl_WorkGroupID.y * p.groupsX + gl_WorkGroupID.x;
        sums[wg] = vec4(sdata[0], 0.0);
    }
}
