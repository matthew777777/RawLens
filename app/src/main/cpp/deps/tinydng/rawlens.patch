+                 "writer is tiled (compressed strips need striped layout)");
+    return TINYDNG_E_INVALID_ARG;
+  }
+  if (!w->precompressed || w->compression != TINYDNG_COMPRESSION_JPEG_XL) {
+    td_set_error(err, TINYDNG_E_INVALID_ARG, TINYDNG_STAGE_WRITE, 0, 0, 0,
+                 "compressed strips need a precompressed JPEG XL writer");
+    return TINYDNG_E_INVALID_ARG;
+  }
