+    td_set_error(err, TINYDNG_E_INVALID_ARG, TINYDNG_STAGE_WRITE, 0, 0, 0,
+                 "segment index %u out of range (count %u)", strip_index,
+                 w->seg_count);
+    return TINYDNG_E_INVALID_ARG;
