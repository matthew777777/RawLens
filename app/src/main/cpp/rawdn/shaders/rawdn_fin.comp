#version 450
#extension GL_GOOGLE_include_directive : require
// SPDX-License-Identifier: GPL-3.0-or-later
// Estimate += bilinear 2x upsample of the coarse correction, 3 planes (gid.z).
// One thread per coarse quad = 2x2 fine quads.
#include "rawdn_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer D { uvec2 d[]; };
layout(std430, binding = 1) buffer O { uvec2 o[]; };
layout(push_constant) uniform P { int fqw, fqh, cqw, cqh; } pc;

vec4 upq(float m, float n, float s, float w, float e, float nw, float ne, float sw, float se) {
  return 0.5625 * m + 0.1875 * vec4(n + w, n + e, s + w, s + e) + 0.0625 * vec4(nw, ne, sw, se);
}

void main() {
  ivec2 q = ivec2(gl_GlobalInvocationID.xy);   // coarse quad
  if (q.x >= pc.cqw || q.y >= pc.cqh) return;
  int pl = int(gl_GlobalInvocationID.z), f = pl * pc.fqw * pc.fqh + (2 * q.y) * pc.fqw + 2 * q.x, cb = pl * pc.cqw * pc.cqh;
  // 4x4 coarse pixels around this coarse quad: rows/cols -1..2
  vec4 qm = unq(d[quadIndex(q.y, q.x, pc.cqw, pc.cqh, cb)]);
  vec4 qn = unq(d[quadIndex(q.y - 1, q.x, pc.cqw, pc.cqh, cb)]), qs = unq(d[quadIndex(q.y + 1, q.x, pc.cqw, pc.cqh, cb)]);
  vec4 qw_ = unq(d[quadIndex(q.y, q.x - 1, pc.cqw, pc.cqh, cb)]), qe = unq(d[quadIndex(q.y, q.x + 1, pc.cqw, pc.cqh, cb)]);
  vec4 qnw = unq(d[quadIndex(q.y - 1, q.x - 1, pc.cqw, pc.cqh, cb)]), qne = unq(d[quadIndex(q.y - 1, q.x + 1, pc.cqw, pc.cqh, cb)]);
  vec4 qsw = unq(d[quadIndex(q.y + 1, q.x - 1, pc.cqw, pc.cqh, cb)]), qse = unq(d[quadIndex(q.y + 1, q.x + 1, pc.cqw, pc.cqh, cb)]);
  bool top = q.y == 0, bot = q.y == pc.cqh - 1, lef = q.x == 0, rig = q.x == pc.cqw - 1;
  // c[r][c], r, c in 0..3  <->  coarse pixel rows 2qy-1 .. 2qy+2
  float c11 = qm.x, c12 = qm.y, c21 = qm.z, c22 = qm.w;
  float c01 = top ? c11 : qn.z, c02 = top ? c12 : qn.w;
  float c31 = bot ? c21 : qs.x, c32 = bot ? c22 : qs.y;
  float c10 = lef ? c11 : qw_.y, c20 = lef ? c21 : qw_.w;
  float c13 = rig ? c12 : qe.x, c23 = rig ? c22 : qe.z;
  float c00 = top ? c10 : (lef ? c01 : qnw.w);
  float c03 = top ? c13 : (rig ? c02 : qne.z);
  float c30 = bot ? c20 : (lef ? c31 : qsw.y);
  float c33 = bot ? c23 : (rig ? c32 : qse.x);
  o[f] = pkq(unq(o[f]) + upq(c11, c01, c21, c10, c12, c00, c02, c20, c22));
  o[f + 1] = pkq(unq(o[f + 1]) + upq(c12, c02, c22, c11, c13, c01, c03, c21, c23));
  o[f + pc.fqw] = pkq(unq(o[f + pc.fqw]) + upq(c21, c11, c31, c20, c22, c10, c12, c30, c32));
  o[f + pc.fqw + 1] = pkq(unq(o[f + pc.fqw + 1]) + upq(c22, c12, c32, c21, c23, c11, c13, c31, c33));
}
