#version 450
#extension GL_GOOGLE_include_directive : require
// SPDX-License-Identifier: GPL-3.0-or-later
// Coarse correction: d = coarse estimate - box_down(fine estimate), 3 planes (gid.z).
#include "rawdn_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer CO { uvec2 co[]; };   // coarse estimate planes
layout(std430, binding = 1) readonly buffer E { uvec2 e[]; };
layout(std430, binding = 2) writeonly buffer D { uvec2 d[]; };    // coarse scratch (one plane)
layout(push_constant) uniform P { int fqw, fqh, cqw, cqh; } pc;
void main() {
  ivec2 q = ivec2(gl_GlobalInvocationID.xy);
  if (q.x >= pc.cqw || q.y >= pc.cqh) return;
  int pl = int(gl_GlobalInvocationID.z);
  int o = pl * pc.fqw * pc.fqh + (2 * q.y) * pc.fqw + 2 * q.x, c = pl * pc.cqw * pc.cqh + q.y * pc.cqw + q.x;
  const vec4 k = vec4(0.25);
  d[c] = pkq(unq(co[c]) - vec4(dot(unq(e[o]), k), dot(unq(e[o + 1]), k), dot(unq(e[o + pc.fqw]), k), dot(unq(e[o + pc.fqw + 1]), k)));
}
