#version 450
#extension GL_GOOGLE_include_directive : require
// SPDX-License-Identifier: GPL-3.0-or-later
// Opponent planes -> denoised CFA (uint16) + white-balanced removed noise (fp16) per site. One thread = 4x4 CFA px.
#include "rawdn_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer E { uvec2 est[]; };
layout(std430, binding = 1) readonly buffer I { uvec2 cfa[]; };
layout(std430, binding = 2) writeonly buffer O { uvec2 outc[]; };
layout(std430, binding = 3) writeonly buffer R { uvec2 rs[]; };
layout(push_constant) uniform P {
  int qw, qh, cw, ch;
  int diagGreen; float range; int pad1; float keptColour;
  float a, b, scale, grain;
  vec4 black;
  vec4 gain;
  float white;
  float outWhite;   // output full scale (uint16)
} pc;


vec4 inv(vec4 v) {   // closed-form exact unbiased inverse of the generalised Anscombe transform
  vec4 t = max(v, vec4(1.0)), i = 1.0 / t;
  return pc.a * (0.25 * t * t - 0.125 + i * (0.30618622 + i * (-1.375 + i * 0.76546554))) - pc.b / pc.a;
}
vec2 put(int y, int x4, int t, vec4 est, vec4 gain, vec4 black, vec4 w, vec4 bias) {   // returns the row residual of the two cells
  vec4 d = inv(est / gain) - bias;
  if (y < 2 * pc.ch && 4 * x4 < 2 * pc.cw) {
    int o = y * (pc.cw / 2) + x4;
    uvec2 c = cfa[o];
    vec4 x = (vec4(c.x & 0xffffu, c.x >> 16, c.y & 0xffffu, c.y >> 16) - black) * pc.scale;
    d = mix(d, x, step(vec4(0.985), x));   // clipped sites stay clipped for highlight reconstruction
    // No zero clip: black stays a pedestal, so the demosaic mean is unbiased.
    uvec4 u = uvec4(clamp(d * (pc.outWhite * 0.9375) + pc.outWhite * 0.0625 + 0.5, vec4(0.0), vec4(pc.outWhite)));
    outc[o] = uvec2(u.x | (u.y << 16), u.z | (u.w << 16));
    vec4 r = (x - d) * gain * gain;
    rs[t] = uvec2(packHalf2x16(r.xy), packHalf2x16(r.zw));
    r *= w; return vec2(r.x + r.y, r.z + r.w);
  }
  rs[t] = uvec2(0u);
  return vec2(0.0);
}
void main() {
  ivec2 q = ivec2(gl_GlobalInvocationID.xy);
  if (q.x >= pc.qw || q.y >= pc.qh) return;
  int n = pc.qw * pc.qh, o = q.y * pc.qw + q.x, t = 4 * o;
  vec4 Y = pc.range * unq(est[o]), Ca = pc.range * unq(est[o + n]), Cb = pc.range * unq(est[o + 2 * n]), D = pc.range * unq(est[o + 3 * n]);
  vec4 r = Y + Cb + Ca, b = Y + Cb - Ca, g1 = Y - Cb + D, g2 = Y - Cb - D;
  bool dg = pc.diagGreen != 0;
  vec4 s00 = dg ? g1 : r, s01 = dg ? r : g1, s10 = dg ? b : g2, s11 = dg ? g2 : b;
  vec4 ge = pc.gain.xyxy, go = pc.gain.zwzw, be = pc.black.xyxy, bo = pc.black.zwzw;
  // Luma of the four 2x2 cells (green 1/6, red / blue 1/3) as fp16 after the residual rows; cells beyond the frame repeat.
  vec4 we = dg ? vec4(1, 2, 1, 2) : vec4(2, 1, 2, 1), wo = we.yxwz;
  // The inverse adds a / 4 per unit of noise variance removed: take back the part of colour noise that stays.
  vec4 g2v = pc.gain * pc.gain;
  float sr = dg ? g2v.y : g2v.x, sb = dg ? g2v.z : g2v.w, vg = (sr + sb + 2.0) * 0.0625;
  float f = 0.25 * pc.a * pc.keptColour, br = f * (vg + 0.5 * sr) / sr, bb = f * (vg + 0.5 * sb) / sb, bg = f * vg;
  vec4 bse = dg ? vec4(bg, br, bg, br) : vec4(br, bg, br, bg), bso = dg ? vec4(bb, bg, bb, bg) : vec4(bg, bb, bg, bb);
  vec2 m = put(4 * q.y,     q.x, t,     vec4(s00.x, s01.x, s00.y, s01.y), ge, be, we, bse);
  m += put(4 * q.y + 1, q.x, t + 1, vec4(s10.x, s11.x, s10.y, s11.y), go, bo, wo, bso);
  vec2 k = put(4 * q.y + 2, q.x, t + 2, vec4(s00.z, s01.z, s00.w, s01.w), ge, be, we, bse);
  k += put(4 * q.y + 3, q.x, t + 3, vec4(s10.z, s11.z, s10.w, s11.w), go, bo, wo, bso);
  m *= 1.0 / 6.0; k = 2 * q.y + 1 < pc.ch ? k * (1.0 / 6.0) : m;
  rs[4 * n + o] = uvec2(packHalf2x16(m), packHalf2x16(k));
}
