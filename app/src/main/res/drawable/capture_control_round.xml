<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/accent_soft">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="oval">
                    <solid android:color="@color/quick_gold_surface" />
                    <stroke android:width="1dp" android:color="@color/accent" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/surface_container" />
                    <stroke android:width="1dp" android:color="@color/outline" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
