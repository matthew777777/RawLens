<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom island: edge-to-edge, rounded top only, kept opaque.
         Overlaps the viewfinder slightly so the curves fill with picture.
         The base solid runs full-bleed (no stroke) so the side edges reach
         the screen glass with zero dark hairline; the 1dp light hairline is
         a second, fully-inside layer so none of it clips off-screen. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners
                android:topLeftRadius="15dp"
                android:topRightRadius="15dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
