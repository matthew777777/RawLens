<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active focal segment: sand-tinted pill with a top tick. The background
         never rotates (rotation applies to text content only), so the tick
         always stays at the top in screen space. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_soft" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:top="3dp"
        android:gravity="top|center_horizontal">
        <shape android:shape="rectangle">
            <size
                android:width="12dp"
                android:height="3dp" />
            <solid android:color="@color/accent" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
