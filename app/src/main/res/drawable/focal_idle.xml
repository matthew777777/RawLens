<?xml version="1.0" encoding="utf-8"?>
<!-- Idle lens disc: faint glass with a hairline rim, so every lens reads as
     tappable without competing with the ringed selected disc (focal_active). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="#12FFFFFF" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
</shape>
