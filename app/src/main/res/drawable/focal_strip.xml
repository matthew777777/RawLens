<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- In-viewfinder focal strip: opaque bed so viewfinder content (scope
         grid lines included) can never show through it. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0D0F12" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
            <corners android:radius="20dp" />
            <padding
                android:left="6dp"
                android:top="4dp"
                android:right="6dp"
                android:bottom="4dp" />
        </shape>
    </item>
</layer-list>
