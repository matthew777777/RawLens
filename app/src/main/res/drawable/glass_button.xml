<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#402E3338" /><stroke android:width="1dp" android:color="#80D6FF33" /></shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="oval"><solid android:color="#80141618" /><stroke android:width="1dp" android:color="#1EFFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#CC1D2126" /><stroke android:width="1dp" android:color="#3DFFFFFF" /></shape>
    </item>
</selector>
