<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/accent_soft">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/quick_gold_surface" />
                    <stroke android:width="1dp" android:color="@color/quick_gold_rim" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/surface_container" />
                    <stroke android:width="1dp" android:color="@color/outline_strong" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
