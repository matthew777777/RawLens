<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="oval"><solid android:color="#252218"/><stroke android:width="1dp" android:color="@color/accent"/></shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="oval"><solid android:color="#15191E"/><stroke android:width="1dp" android:color="#343A42"/></shape>
        </inset>
    </item>
</selector>
