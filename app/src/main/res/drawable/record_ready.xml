<!-- RAW Video record-ready core: white core, red ring (Blackmagic idle-REC language). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/danger" />
            <stroke android:width="1dp" android:color="#CC151B00" />
            <size android:width="72dp" android:height="72dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/text_primary" />
            <stroke android:width="3dp" android:color="@color/danger" />
            <size android:width="72dp" android:height="72dp" />
        </shape>
    </item>
</selector>
