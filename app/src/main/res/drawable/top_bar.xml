<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top island: edge-to-edge, rounded bottom only, kept opaque.
         Mirrors the bottom control panel (rounded top): the viewfinder
         tucks 16dp underneath so the curves fill with picture instead
         of root black. The base solid runs full-bleed (no stroke) so the
         side edges reach the screen glass with zero dark hairline. The 1dp
         light hairline traces only the picture-facing edge and curves: its
         side and top runs sit 1dp past the glass (never half-clipped by
         rounded or curved display edges), radius 17 keeps the arc just
         inside the 16dp solid curve. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="16dp"
                android:bottomRightRadius="16dp" />
        </shape>
    </item>
    <item android:left="-1dp" android:right="-1dp" android:top="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="17dp"
                android:bottomRightRadius="17dp" />
        </shape>
    </item>
</layer-list>
