<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top island: edge-to-edge, opaque and square, so it meets the
         viewfinder without covering any of the picture. The 1dp hairline
         shows only on the picture-facing edge. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
        </shape>
    </item>
    <item android:left="-1dp" android:right="-1dp" android:top="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
