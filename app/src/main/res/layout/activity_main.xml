<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/black"
    android:clipChildren="false" android:clipToPadding="false">

    <!-- System ISP preview, PhotonCamera style: a SurfaceView the camera fills directly
         (zero app GPU). It stays VISIBLE whenever a preview session runs (a destroyed output
         kills the session); the RAW/BGU VF surfaces sit above it as media overlays and are
         removed only when Settings -> Merge "ISP preview" toggles show it. RAW-only fallback
         sessions omit this stream entirely and drive the RawViewfinder alone. -->
    <com.matthew.rawlens.AutoFitSurfaceView
        android:id="@+id/viewfinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <com.matthew.rawlens.RawViewfinder
        android:id="@+id/rawViewfinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- BGU viewfinder: from-scratch bilateral-grid engine. Only one of the
         two VF surfaces is ever visible; the controller routes offers. -->
    <com.matthew.rawlens.BguViewfinder
        android:id="@+id/bguViewfinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Encoded Video take monitor: stacked directly over the RAW viewfinder,
         sized to its rect at record start, GONE otherwise. Shows the staged
         encode pixels (aspect-fit) instead of a separately-demosaiced
         viewfinder; the RAW VF idles untouched underneath. -->
    <com.matthew.rawlens.EncodedVideoPreviewView
        android:id="@+id/recordPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <com.matthew.rawlens.RawExposureOverlayView
        android:id="@+id/rawExposureOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="yes" />

    <!-- Focus-peaking sparkle: drawn above both RAW VF and recording monitor surfaces,
         below guides + metering so focus squares stay on top. Sized to the
         viewfinder rect at runtime (syncGuideOverlayToViewfinder). -->
    <com.matthew.rawlens.FocusPeakingOverlayView
        android:id="@+id/focusPeakingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <com.matthew.rawlens.CameraGuideOverlay
        android:id="@+id/guideOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.matthew.rawlens.LevelOverlayView
        android:id="@+id/levelOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="yes" />

    <com.matthew.rawlens.FocusMeteringOverlay
        android:id="@+id/focusMeteringOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/recordingSleepOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:text="Preview asleep · tap to wake"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/rawVfDebugOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="96dp"
        android:background="@drawable/manual_control_panel"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="monospace"
        android:maxWidth="280dp"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/debugOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="96dp"
        android:background="@drawable/manual_control_panel"
        android:fontFamily="monospace"
        android:maxWidth="300dp"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- RAW Video HUD (Blackmagic language): a stats strip over the same
         3:4 viewport and top island as photo (the top-bar gear opens
         Settings at the Video tab). Shown in VIDEO mode only. No top text: the record timecode lives as the
         first line of the stats strip (red while rolling); fps/profile
         switches live in the Settings Video tab. Meter and REC stay fixed
         like reference hardware. -->
    <!-- RAW Video stats strip: same mono contract as rawVfDebugOverlay
         (fps / encode ms / drops / queue / MB/s / audio+gyro rates) with the
         record timecode as its first line (red while rolling), laid out as
         a wide rounded strip over a translucent fill so the viewfinder
         shows through. -->
    <TextView
        android:id="@+id/videoDebugOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="96dp"
        android:background="@drawable/video_stats_frame"
        android:fontFamily="monospace"
        android:maxWidth="300dp"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:text="00:00:00:00"
        android:textColor="@color/text_primary"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- LK-R zoom chip: floats on the viewfinder's bottom-right corner,
         mirroring the scope (bottom-left), seated above the measured panel by
         seatScopeSlot; 248dp below is only the initial fallback, independent
         of how many lenses the lens row holds.
         1x / 1.5x / 2x centre crop solved at x2; output stays sensor size.
         Shown only while LK-R is the active merge in photo mode. -->
    <com.matthew.rawlens.RotatingTextView
        android:id="@+id/lkrZoomChip"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="248dp"
        android:background="@drawable/control_chip"
        android:gravity="center"
        android:minWidth="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="SR 1×"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />




    <!-- Top bar: opaque black island, edge-to-edge with rounded bottom corners
         mirroring the bottom panel. Single controls row in photo mode; the
         capture info line lives in the bottom panel in both modes so the
         panel keeps one exact structure photo/video (no jump on switch).
         Hidden in video for full-bleed framing. -->
    <LinearLayout android:id="@+id/topBar" android:clipChildren="true" android:clipToPadding="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:background="@drawable/top_bar" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="48dp" android:paddingStart="16dp" android:paddingTop="4dp" android:paddingEnd="32dp" android:paddingBottom="4dp">
        <com.matthew.rawlens.RotatingImageButton android:id="@+id/settingsButton" style="@style/TopBarButton" android:contentDescription="Settings" android:src="@drawable/ic_settings" />
        <Space android:id="@+id/topSpacer" android:layout_width="8dp" android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/rawStatusGroup"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="96dp"
            android:clickable="true"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="end|center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/captureHeaderMetadataRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rawBadge"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:singleLine="true"
                    android:text="DNG"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Space android:id="@+id/headerCutoutGap" android:layout_width="0dp" android:layout_height="1dp" />
                <TextView
                    android:id="@+id/status"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:maxWidth="140dp"
                    android:singleLine="true"
                    android:text="READY"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/captureStatusRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/headerSensorGroup"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="2" android:gravity="center_vertical">
                <com.matthew.rawlens.RotatingTextView
                    android:id="@+id/sensorInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:gravity="start"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                <com.matthew.rawlens.RotatingTextView
                    android:id="@+id/dngInfo"
                    android:layout_width="wrap_content"
                    android:maxWidth="76dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                </LinearLayout>
                <Space android:id="@+id/meterCutoutGap" android:layout_width="0dp" android:layout_height="1dp" />
                <LinearLayout android:id="@+id/headerMeterGroup"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center_vertical">
                    <TextView
                android:id="@+id/featureTags"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:letterSpacing="0.06"
                android:maxWidth="140dp"
                android:singleLine="true"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
                    <TextView
                android:id="@+id/rawSpotReading"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:gravity="end"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxWidth="110dp"
                android:singleLine="true"
                android:text="RAW —"
                android:textColor="@color/accent"
                android:textSize="9sp" />
                </LinearLayout>            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Floating scope (histogram / waveform share one slot): sized by the
         views to fit the bottom-left thirds cell. seatScopeSlot places it above
         the visible panel and adds clearance for rotation in landscape. -->
    <com.matthew.rawlens.HistogramView
        android:id="@+id/histogramView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="238dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Histogram" />

    <com.matthew.rawlens.WaveformView
        android:id="@+id/waveformView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="238dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Waveform"
        android:visibility="gone" />

    <LinearLayout android:id="@+id/manualControlPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="248dp" android:background="@android:color/transparent" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:id="@+id/recordingToolsRow" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="4dp" android:orientation="horizontal" android:visibility="gone">
            <com.matthew.rawlens.RotatingTextView android:id="@+id/focusMarkA" style="@style/ExposureControl" android:text="Set A" />
            <com.matthew.rawlens.RotatingTextView android:id="@+id/focusMarkB" style="@style/ExposureControl" android:text="Set B" android:layout_marginStart="8dp" />
            <com.matthew.rawlens.RotatingTextView android:id="@+id/focusPullDuration" style="@style/ExposureControl" android:text="1.2s" android:layout_marginStart="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical|end" android:orientation="horizontal">
            <com.matthew.rawlens.RotatingButton android:id="@+id/manualLimitsButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" android:background="@drawable/control_chip" android:minWidth="0dp" android:minHeight="48dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="LIMITS" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold" android:visibility="gone" />
            <com.matthew.rawlens.RuleSliderView
                android:id="@+id/manualControlSlider"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp" />
            <com.matthew.rawlens.RotatingButton android:id="@+id/manualAutoButton" android:layout_width="wrap_content" android:layout_height="48dp" android:background="@drawable/capture_control_round" android:layout_marginStart="6dp" android:minWidth="48dp" android:minHeight="48dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="AUTO" android:textColor="@color/accent" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:id="@+id/quickSettingsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="248dp" android:background="@drawable/quick_control_plate" android:scrollbars="none" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.matthew.rawlens.QuickControlTileView
                    android:id="@+id/monitorQuickTab"
                    style="@style/QuickControlTile"
                    android:layout_height="48dp"
                    android:background="@drawable/quick_tab"
                    android:text="Monitor"
                    android:textSize="11sp" />
                <com.matthew.rawlens.QuickControlTileView
                    android:id="@+id/captureQuickTab"
                    style="@style/QuickControlTile"
                    android:layout_height="48dp"
                    android:background="@drawable/quick_tab"
                    android:text="Capture"
                    android:textSize="11sp" />
                <com.matthew.rawlens.QuickControlTileView
                    android:id="@+id/mergeQuickTab"
                    style="@style/QuickControlTile"
                    android:layout_height="48dp"
                    android:background="@drawable/quick_tab"
                    android:text="Merge"
                    android:textSize="11sp" />
                <com.matthew.rawlens.QuickControlTileView
                    android:id="@+id/toolsQuickTab"
                    style="@style/QuickControlTile"
                    android:layout_height="48dp"
                    android:background="@drawable/quick_tab"
                    android:text="Tools"
                    android:textSize="11sp" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="4dp"
                android:background="@color/outline" />
            <LinearLayout android:id="@+id/photoCaptureQuickRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:orientation="horizontal" android:baselineAligned="false">
                <com.matthew.rawlens.QuickControlTileView android:id="@+id/timerQuick" style="@style/QuickControlTile" android:text="TIMER\nOFF" />
                <com.matthew.rawlens.QuickControlTileView android:id="@+id/releaseQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="RELEASE\nSINGLE" />
                <com.matthew.rawlens.QuickControlTileView android:id="@+id/hdrQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="HDR\nOFF" />
            </LinearLayout>
            <LinearLayout android:id="@+id/recordingQuickSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/videoQuickHeading" style="@style/QuickSectionLabel" android:text="Dimmed settings locked" android:visibility="gone" />
                <LinearLayout android:id="@+id/videoFormatQuickRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:orientation="horizontal" android:baselineAligned="false" android:visibility="gone">
                    <com.matthew.rawlens.QuickControlTileView android:id="@+id/videoModeQuick" style="@style/QuickControlTile" android:layout_marginStart="0dp" android:text="VIDEO" />
                    <com.matthew.rawlens.QuickControlTileView android:id="@+id/videoResolutionQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="RESOLUTION" />
                    <com.matthew.rawlens.QuickControlTileView android:id="@+id/videoFpsQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="FPS" />
                </LinearLayout>
                <LinearLayout android:id="@+id/videoModeQuickRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:orientation="horizontal" android:baselineAligned="false" android:visibility="gone">
                    <com.matthew.rawlens.QuickControlTileView android:id="@+id/encodedVideoCropQuick" style="@style/QuickControlTile" android:layout_marginStart="0dp" android:text="CROP" android:visibility="gone" />
                    <com.matthew.rawlens.QuickControlTileView android:id="@+id/videoBinningQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="BINNING" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/monitorQuickSection" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                <com.matthew.rawlens.QuickControlTileView android:id="@+id/gridQuick" style="@style/QuickControlTile" android:text="GRID\nTHIRDS" />
                <com.matthew.rawlens.QuickControlTileView android:id="@+id/histogramQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="SCOPE\nHISTO" />
                <com.matthew.rawlens.QuickControlTileView android:id="@+id/levelQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="LEVEL\nOFF" />
                <com.matthew.rawlens.QuickControlTileView android:id="@+id/aeMeteringQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="AE METER\nAUTO" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:orientation="horizontal" android:baselineAligned="false">
                    <com.matthew.rawlens.QuickControlTileView android:id="@+id/rawExposureToggle" style="@style/QuickControlTile" android:text="OVERLAY\nOFF" />
                    <com.matthew.rawlens.QuickControlTileView android:id="@+id/vfEngineButton" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="RAW VF\nAUTO" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/toolsQuickSection" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:orientation="horizontal" android:baselineAligned="false">
                <com.matthew.rawlens.QuickControlTileView android:id="@+id/ettrQuick" style="@style/QuickControlTile" android:text="ETTR\nOFF" />
                <com.matthew.rawlens.QuickControlTileView android:id="@+id/resetTargetsQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="AF / AE\nRESET" />
                <com.matthew.rawlens.QuickControlTileView android:id="@+id/lightQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="LIGHT\nOFF" />
                <com.matthew.rawlens.QuickControlTileView android:id="@+id/monoQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="B&amp;W\nOFF" />
                <com.matthew.rawlens.QuickControlTileView android:id="@+id/portraitQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="PORTRAIT\nOFF" />
                <com.matthew.rawlens.QuickControlTileView android:id="@+id/recordingPreviewSleep" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="Preview sleep" />
            </LinearLayout>
            <LinearLayout android:id="@+id/mergeQuickSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.matthew.rawlens.QuickControlTileView
                        android:id="@+id/lkrQuick"
                        style="@style/QuickControlTile"
                        android:background="@drawable/quick_lkr"
                        android:text="LK-R\nOFF"
                        android:textSize="12sp" />
                    <com.matthew.rawlens.QuickControlTileView
                        android:id="@+id/lkrHdrQuick"
                        style="@style/QuickControlTile"
                        android:layout_width="76dp"
                        android:layout_weight="0"
                        android:layout_marginStart="8dp"
                        android:text="HDR\nAUTO" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:orientation="horizontal" android:baselineAligned="false">
                    <com.matthew.rawlens.QuickControlTileView android:id="@+id/hdrPlusQuick" style="@style/QuickControlTile" android:text="HDR+\nOFF" />
                    <com.matthew.rawlens.QuickControlTileView android:id="@+id/mfsrQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="MFSR\nOFF" />
                    <com.matthew.rawlens.QuickControlTileView android:id="@+id/dLightingQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="D-LIGHTING\nOFF" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/control_panel"
        android:gravity="top"
        android:minHeight="232dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Lens row: horizontal focal pills (populated at runtime by
             refreshLensSwitcher; the static child is a first-frame
             placeholder). Same row in photo and video (video records on the
             selected lens) so the bottom panel keeps one exact structure
             across the mode switch. No bed of its own: the pills sit
             straight on the panel surface, one piece with the island. -->
        <LinearLayout
            android:id="@+id/captureInfoRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <com.matthew.rawlens.RotatingTextView
                android:id="@+id/afOnButton"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:background="@drawable/exposure_control_state"
                android:contentDescription="Focus at selected point"
                android:gravity="center"
                android:text="AF-ON"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Keep oversized content start-aligned: centering the child
                 itself puts its leading lenses outside the scroll range.
                 fillViewport centers short strips via their own gravity. -->
            <HorizontalScrollView
                android:id="@+id/lensScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:fillViewport="true"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:fadingEdgeLength="32dp"
                android:overScrollMode="never"
                android:requiresFadingEdge="horizontal"
                android:scrollbars="none">

            <LinearLayout
                android:id="@+id/lensSwitcher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/lens_track"
                android:padding="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.matthew.rawlens.RotatingTextView
                    android:id="@+id/lensControl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/focal_active"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:minHeight="32dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="1×"
                    android:textColor="@color/accent_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            </HorizontalScrollView>

            <com.matthew.rawlens.RotatingTextView
                android:id="@+id/aeLockButton"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:background="@drawable/exposure_control_state"
                android:contentDescription="Lock exposure"
                android:gravity="center"
                android:text="AE-L"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/exposureControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/exposure_strip"
            android:gravity="center"
            android:orientation="horizontal">

            <com.matthew.rawlens.RotatingTextView
                android:id="@+id/isoControl"
                style="@style/CaptureExposureControl"
                android:text="ISO&#10;—" />

            <com.matthew.rawlens.RotatingTextView
                android:id="@+id/shutterControl"
                style="@style/CaptureExposureControl"
                android:text="S&#10;—" />

            <com.matthew.rawlens.RotatingTextView
                android:id="@+id/wbControl"
                style="@style/CaptureExposureControl"
                android:text="WB&#10;—" />

            <com.matthew.rawlens.RotatingTextView
                android:id="@+id/focusControl"
                style="@style/CaptureExposureControl"
                android:text="AF&#10;—" />

            <com.matthew.rawlens.RotatingTextView
                android:id="@+id/evControl"
                style="@style/CaptureExposureControl"
                android:text="EV&#10;+0.0" />

            <com.matthew.rawlens.RotatingTextView
                android:id="@+id/flashControl"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="LIGHT OFF" />
        </LinearLayout>

        <!-- Shutter area, mirrored around the shutter: each side has one large
             control (gallery | mode dial). The dial is ring-sized (its face
             is 12dp smaller than the view) and mirrors the shutter. The spacers centre the area in any spare height, so it
             sits lower on tall screens. Same XML in photo and video. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/capturePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp">

            <!-- Newest capture; quick controls and the photo/video toggle. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/galleryThumb"
                        android:layout_marginVertical="6dp"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/glass_button"
                        android:contentDescription="Open last capture"
                        android:padding="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_gallery" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.matthew.rawlens.RotatingImageButton
                            android:id="@+id/quickButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/capture_control_round"
                            android:contentDescription="Quick controls"
                            android:padding="12dp"
                            android:tint="@color/capture_control_tint"
                            android:src="@drawable/ic_tune" />

                        <View
                            android:id="@+id/videoRecordButton"
                            android:layout_marginStart="8dp"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/video_enter"
                            android:contentDescription="Enter video mode"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- The 20dp bottom margin lifts the centred ring 10dp. -->
                <FrameLayout
                    android:layout_width="@dimen/shutter_ring_size"
                    android:layout_height="@dimen/shutter_ring_size"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/shutter_ring"
                    android:padding="8dp">

                    <View
                        android:id="@+id/shutter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/shutter_core"
                        android:contentDescription="Capture RAW photo" />
                </FrameLayout>
            </LinearLayout>

            <!-- Exposure mode. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <!-- Fixed height so the row never shifts when the chip shows or hides.
                     Both children carry the same 20dp lift and are centred on one line,
                     so the chip and the dial share a centre. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="96dp"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.matthew.rawlens.RotatingTextView
                        android:id="@+id/lkrResChip"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/control_chip_round"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="0.9"
                        android:text="12.5\nMP"
                        android:textColor="@color/text_primary"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Larger than the gallery thumb, smaller than the ring; lifted like the ring so the
                         dial sits level with the shutter. -->
                    <com.matthew.rawlens.CaptureModeDial
                        android:id="@+id/modeButton"
                        android:layout_width="@dimen/mode_dial_size"
                        android:layout_height="@dimen/mode_dial_size"
                        android:layout_marginBottom="20dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:focusable="true" />

                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
