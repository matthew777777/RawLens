<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/black"
    android:clipChildren="false" android:clipToPadding="false">

    <!-- System ISP preview: usually a repeating-request target (HAL stability), NEVER displayed.
         The view stays VISIBLE so its SurfaceTexture is created, but fully transparent so the
         user only ever sees our scene-referred RawViewfinder. (INVISIBLE suppresses surface
         creation on some HALs and wedges startup with no camera client at all.) RAW-only
         fallback sessions omit this stream entirely and drive the RawViewfinder alone. -->
    <com.matthew.rawlens.AutoFitTextureView
        android:id="@+id/viewfinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:alpha="0" />

    <com.matthew.rawlens.RawViewfinder
        android:id="@+id/rawViewfinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- BGU viewfinder: from-scratch bilateral-grid engine. Only one of the
         two VF surfaces is ever visible; the controller routes offers. -->
    <com.matthew.rawlens.BguViewfinder
        android:id="@+id/bguViewfinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Focus-peaking sparkle: drawn in the window above the RAW VF surface,
         below guides + metering so focus squares stay on top. Sized to the
         viewfinder rect at runtime (syncGuideOverlayToViewfinder). -->
    <com.matthew.rawlens.FocusPeakingOverlayView
        android:id="@+id/focusPeakingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Direct-Log take monitor: stacked directly over the RAW viewfinder,
         sized to its rect at record start, GONE otherwise. Shows the staged
         encode pixels (aspect-fit) instead of a separately-demosaiced
         viewfinder; the RAW VF idles untouched underneath. -->
    <com.matthew.rawlens.DirectLogPreviewView
        android:id="@+id/recordPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <com.matthew.rawlens.CameraGuideOverlay
        android:id="@+id/guideOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.matthew.rawlens.LevelOverlayView
        android:id="@+id/levelOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="yes" />

    <com.matthew.rawlens.FocusMeteringOverlay
        android:id="@+id/focusMeteringOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/rawVfDebugOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="96dp"
        android:background="@drawable/manual_control_panel"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="monospace"
        android:maxWidth="280dp"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/debugOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="96dp"
        android:background="@drawable/manual_control_panel"
        android:fontFamily="monospace"
        android:maxWidth="300dp"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- RAW Video HUD (Blackmagic language): a stats strip over the same
         3:4 viewport and top island as photo (the top-bar gear opens
         Settings at the Video tab). Shown in VIDEO mode only. No top text: the record timecode lives as the
         first line of the stats strip (red while rolling); fps/profile
         switches live in the Settings Video tab. Meter and REC stay fixed
         like reference hardware. -->
    <!-- RAW Video stats strip: same mono contract as rawVfDebugOverlay
         (fps / encode ms / drops / queue / MB/s / audio+gyro rates) with the
         record timecode as its first line (red while rolling), laid out as
         a wide rounded strip over a translucent fill so the viewfinder
         shows through. -->
    <TextView
        android:id="@+id/videoDebugOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="96dp"
        android:background="@drawable/video_stats_frame"
        android:fontFamily="monospace"
        android:maxWidth="300dp"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:text="00:00:00:00"
        android:textColor="@color/text_primary"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Top bar: opaque black island, edge-to-edge with rounded bottom corners
         mirroring the bottom panel. Single controls row in photo mode; the
         capture info line lives in the bottom panel in both modes so the
         panel keeps one exact structure photo/video (no jump on switch).
         Hidden in video for full-bleed framing. -->
    <LinearLayout android:id="@+id/topBar" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:background="@drawable/top_bar" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="48dp" android:paddingStart="16dp" android:paddingTop="16dp" android:paddingEnd="16dp" android:paddingBottom="10dp">
        <com.matthew.rawlens.RotatingImageButton android:id="@+id/settingsButton" style="@style/TopBarButton" android:contentDescription="Settings" android:src="@drawable/ic_settings" />
        <Space android:id="@+id/topSpacer" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/rawStatusGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="96dp"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:gravity="end|center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <!-- Capture format line: sensor + bit depth beside the format
                 badge, one row so the top island never grows. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.matthew.rawlens.RotatingTextView
                    android:id="@+id/sensorInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="0.06"
                    android:maxWidth="96dp"
                    android:singleLine="true"
                    android:text="RAW SENSOR"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <com.matthew.rawlens.RotatingTextView
                    android:id="@+id/dngInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:letterSpacing="0.06"
                    android:maxWidth="96dp"
                    android:singleLine="true"
                    android:text="12-BIT"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/rawBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/raw_badge"
                    android:letterSpacing="0.08"
                    android:text="DNG"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Active capture features (HDR+, MFSR, ETTR, HDR, BURST,
                 timer) as gold tags; tap opens quick controls. Same line
                 as the status so the top island never grows. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/featureTags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:letterSpacing="0.06"
                android:maxWidth="140dp"
                android:singleLine="true"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:maxWidth="140dp"
                android:singleLine="true"
                android:text="READY"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Floating scope (histogram / waveform share one slot): sized by the
         views to fit the bottom-left thirds cell (never covers the grid); seated 16dp above the panel by seatScopeSlot (with
         the quarter-turn lift in landscape). Only the active mode is visible. -->
    <com.matthew.rawlens.HistogramView
        android:id="@+id/histogramView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="248dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Histogram" />

    <com.matthew.rawlens.WaveformView
        android:id="@+id/waveformView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="248dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Waveform"
        android:visibility="gone" />

    <!-- Floating minimal ruler: transparent container, the strip itself is the pill. -->
    <LinearLayout android:id="@+id/manualControlPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="248dp" android:background="@android:color/transparent" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical|end" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingBottom="8dp">
            <com.matthew.rawlens.RotatingButton android:id="@+id/manualLimitsButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" android:background="@drawable/control_chip" android:minWidth="0dp" android:minHeight="48dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="LIMITS" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold" android:visibility="gone" />
            <com.matthew.rawlens.RotatingButton android:id="@+id/manualAutoButton" android:layout_width="wrap_content" android:layout_height="48dp" android:background="@drawable/control_chip_active" android:minWidth="88dp" android:minHeight="48dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="AUTO" android:textColor="@color/accent_dark" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <com.matthew.rawlens.RuleSliderView android:id="@+id/manualControlSlider" android:layout_width="match_parent" android:layout_height="68dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/quickSettingsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="248dp" android:background="@drawable/quick_panel" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <com.matthew.rawlens.RotatingTextView android:id="@+id/quickPanelTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:letterSpacing="0.08" android:text="QUICK CONTROL" android:textColor="@color/text_primary" android:textSize="9sp" android:textStyle="bold" />
            <com.matthew.rawlens.RotatingTextView android:id="@+id/quickPanelHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap outside to close" android:textColor="@color/text_muted" android:textSize="9sp" />
        </LinearLayout>
        <!-- Balanced 3 x 3 grid: every row same weight so tiles never stretch. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <com.matthew.rawlens.RotatingTextView android:id="@+id/gridQuick" style="@style/QuickControlTile" android:text="GRID\nTHIRDS" />
            <com.matthew.rawlens.RotatingTextView android:id="@+id/histogramQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="SCOPE\nHISTO" />
            <com.matthew.rawlens.RotatingTextView android:id="@+id/levelQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="LEVEL\nOFF" />
            <com.matthew.rawlens.RotatingTextView android:id="@+id/aeMeteringQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="AE METER\nAUTO" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.matthew.rawlens.RotatingTextView android:id="@+id/timerQuick" style="@style/QuickControlTile" android:text="TIMER\nOFF" />
            <com.matthew.rawlens.RotatingTextView android:id="@+id/releaseQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="RELEASE\nSINGLE" />
            <com.matthew.rawlens.RotatingTextView android:id="@+id/hdrQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="HDR\nOFF" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <!-- Future SR hook: rawSrQuick tile here. -->
            <com.matthew.rawlens.RotatingTextView android:id="@+id/ettrQuick" style="@style/QuickControlTile" android:text="ETTR\nOFF" />
            <com.matthew.rawlens.RotatingTextView android:id="@+id/resetTargetsQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="AF / AE\nRESET" />
            <com.matthew.rawlens.RotatingTextView android:id="@+id/lightQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="LIGHT\nOFF" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.matthew.rawlens.RotatingTextView android:id="@+id/hdrPlusQuick" style="@style/QuickControlTile" android:text="HDR+\nOFF" />
            <com.matthew.rawlens.RotatingTextView android:id="@+id/mfsrQuick" style="@style/QuickControlTile" android:layout_marginStart="8dp" android:text="MFSR\nOFF" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/control_panel"
        android:gravity="top"
        android:minHeight="232dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <!-- Lens row: horizontal focal pills (populated at runtime by
             refreshLensSwitcher; the static child is a first-frame
             placeholder). Same row in photo and video (video records on the
             selected lens) so the bottom panel keeps one exact structure
             across the mode switch. No bed of its own: the pills sit
             straight on the panel surface, one piece with the island. -->
        <LinearLayout
            android:id="@+id/captureInfoRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <!-- Pills shrink 48 -> 40dp to share the row; past that the
                 row scrolls, edges fading, selected lens kept centered. -->
            <HorizontalScrollView
                android:id="@+id/lensScroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fadingEdgeLength="32dp"
                android:overScrollMode="never"
                android:requiresFadingEdge="horizontal"
                android:scrollbars="none">

            <LinearLayout
                android:id="@+id/lensSwitcher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/lens_track"
                android:padding="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.matthew.rawlens.RotatingTextView
                    android:id="@+id/lensControl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/focal_active"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:minHeight="32dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="1×"
                    android:textColor="@color/accent_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/exposureControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.matthew.rawlens.RotatingTextView
                android:id="@+id/isoControl"
                style="@style/ExposureControl"
                android:text="ISO A" />

            <com.matthew.rawlens.RotatingTextView
                android:id="@+id/shutterControl"
                style="@style/ExposureControl"
                android:layout_marginStart="8dp"
                android:text="S A" />

            <com.matthew.rawlens.RotatingTextView
                android:id="@+id/wbControl"
                style="@style/ExposureControl"
                android:layout_marginStart="8dp"
                android:text="WB A" />

            <com.matthew.rawlens.RotatingTextView
                android:id="@+id/focusControl"
                style="@style/ExposureControl"
                android:layout_marginStart="8dp"
                android:text="AF" />

            <com.matthew.rawlens.RotatingTextView
                android:id="@+id/evControl"
                style="@style/ExposureControl"
                android:layout_marginStart="8dp"
                android:text="EV +0.0" />

            <com.matthew.rawlens.RotatingTextView
                android:id="@+id/flashControl"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="LIGHT OFF" />
        </LinearLayout>

        <!-- Shutter area: fixed two-row structure, no code sizing. Every
             vertical gap in the panel is 8dp (top pad, lens -> tiles,
             tiles -> ring, ring -> row B) and every side control is 48dp
             tall, so left and right columns line up. Row A
             (quick | shutter | mode) is 92dp tall with every child vertically
             centered, so the shutter, quick, and mode centers share one line
             by construction. Row B carries the video dot and preview format.
             Identical XML in photo and video: the mode switch cannot jump. -->
        <LinearLayout
            android:id="@+id/capturePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Left and right groups take equal weight so the shutter
                     stays centered whatever each side holds. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical|start"
                    android:orientation="horizontal">

                    <!-- Quick access first: same 48dp column as the red
                         record dot below it. -->
                    <com.matthew.rawlens.RotatingImageButton
                        android:id="@+id/quickButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/glass_button"
                        android:contentDescription="Quick controls"
                        android:padding="12dp"
                        android:src="@drawable/ic_tune" />

                    <!-- Newest capture (photo or video): tap opens the
                         system viewer. Empty glass circle until the first
                         capture lands. -->
                    <ImageView
                        android:id="@+id/galleryThumb"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/glass_button"
                        android:contentDescription="Open last capture"
                        android:padding="13dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_gallery" />
                </LinearLayout>

                <!-- 88dp ring centered in the 92dp row: 2dp clear top and
                     bottom, so the ring can never clip. -->
                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/shutter_ring"
                    android:padding="8dp">

                    <View
                        android:id="@+id/shutter"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/shutter_core"
                        android:contentDescription="Capture RAW photo" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.matthew.rawlens.RotatingTextView
                        android:id="@+id/modeButton"
                        android:layout_width="72dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/control_chip"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:text="S\nSINGLE"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Dedicated RAW Video entry: red record dot below the quick
                     panel access. Never part of the mode switcher. Tap = enter
                     video / toggle recording, long-press in video = exit. -->
                <View
                    android:id="@+id/videoRecordButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/video_enter"
                    android:contentDescription="Enter RAW video mode"
                    android:clickable="true"
                    android:focusable="true" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- RAW VF engine: shows the current engine, tap cycles it
                     (same as tapping the RAW VF debug overlay). -->
                <com.matthew.rawlens.RotatingTextView
                    android:id="@+id/vfEngineButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/control_chip_round"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="0.9"
                    android:text="AUTO"
                    android:textColor="@color/text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
