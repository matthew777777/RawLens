<?xml version="1.0" encoding="utf-8"?>
<!-- First launch: one black screen, one action. Everything else is asked
     at the moment its feature is first used (see FirstUseAsks). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="RawLens camera"
        android:src="@drawable/photo_camera_photograph_svgrepo_com" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="RawLens"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Sensor RAW. Offline. No account."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <Button style="@style/Widget.RawLens.WelcomeAction"
        android:id="@+id/openCameraButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/quick_control_active"
        android:minHeight="48dp"
        android:text="Allow camera"
        android:textAllCaps="false"
        android:textColor="@color/accent_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Empty until something needs saying (denied grant, unsupported phone). -->
    <TextView
        android:id="@+id/welcomeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />
</LinearLayout>
