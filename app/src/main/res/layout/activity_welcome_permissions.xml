<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="48dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Two quick grants"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Camera access to shoot, plus the photo folder so burst gyro files save next to your DNGs."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <!-- Camera grant -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/welcome_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="1 · CAMERA"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/permCameraStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Camera access is needed to discover RAW lenses and shoot."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <Button
                android:id="@+id/permCameraButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/welcome_cta"
                android:text="Allow Camera"
                android:textAllCaps="false"
                android:textColor="@color/accent_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:minHeight="52dp" />
        </LinearLayout>

        <!-- Photo-folder grant -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/welcome_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="2 · PHOTO FOLDER"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Choose DCIM/RawLens next so burst gyro files save next to your DNGs. Skipping is fine — sidecars fall back to Downloads until you grant it from burst settings."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/permFolderStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Not chosen yet."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/permFolderButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/welcome_cta"
                android:text="Choose Photo Folder"
                android:textAllCaps="false"
                android:textColor="@color/accent_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:minHeight="52dp" />
        </LinearLayout>

        <!-- Location tags: optional, also flippable later in Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/welcome_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="3 · LOCATION (OPTIONAL)"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/locationSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="false"
                android:text="Tag photos with GPS location"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Adds GPS coordinates to your DNGs and JPEGs. Optional — without it photos simply save untagged, and you can switch it on later in Settings."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- Keep-up-to-date ask: updater builds only, hidden on F-Droid -->
        <LinearLayout
            android:id="@+id/updateSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/welcome_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="4 · KEEP UP TO DATE"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/updateSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="Check for updates on startup"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="RawLens compares the installed version against the latest GitHub release, at most once a day. Only the public release info is fetched; nothing is uploaded.\n\nOff means fully offline: the app never contacts the network on its own. You can change this anytime under Settings → About."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <Button
            android:id="@+id/permContinueButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/welcome_cta"
            android:text="Find My Lenses  →"
            android:textAllCaps="false"
            android:textColor="@color/accent_dark"
            android:textSize="17sp"
            android:textStyle="bold"
            android:minHeight="60dp" />

        <TextView
            android:id="@+id/permStatus"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Next: RAW lens discovery, then go shoot. Your photos stay in DCIM/RawLens — no accounts, no cloud."
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>
</ScrollView>
