<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Four quick grants"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Camera, folder, location, updates — all here."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Camera grant -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/welcome_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="1 · CAMERA"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/permCameraStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Camera access is needed to discover RAW lenses and shoot."
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/permCameraButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/welcome_cta"
                android:text="Allow Camera"
                android:textAllCaps="false"
                android:textColor="@color/accent_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:minHeight="48dp" />
        </LinearLayout>

        <!-- Photo-folder grant -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/welcome_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="2 · PHOTO FOLDER"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tap Use this folder so burst gyro files save next to your DNGs. Skip anytime — Downloads works too."
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/permFolderStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Not chosen yet."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/permFolderButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/welcome_cta"
                android:text="Choose Photo Folder"
                android:textAllCaps="false"
                android:textColor="@color/accent_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:minHeight="48dp" />
        </LinearLayout>

        <!-- Location tags: optional, also flippable later in Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/welcome_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="3 · LOCATION (OPTIONAL)"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/locationSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="Tag photos with GPS location"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Optional — untagged without it, also in Settings later."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Keep-up-to-date ask: updater builds only, hidden on F-Droid -->
        <LinearLayout
            android:id="@+id/updateSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/welcome_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="4 · KEEP UP TO DATE"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/updateSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="Check for updates on startup"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Daily GitHub release check, at most. Nothing uploaded; off is fully offline."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/permContinueButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/welcome_cta"
            android:text="Find My Lenses  →"
            android:textAllCaps="false"
            android:textColor="@color/accent_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:minHeight="52dp" />

        <TextView
            android:id="@+id/permStatus"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Next: lens discovery, then shoot. Photos stay in DCIM/RawLens."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
