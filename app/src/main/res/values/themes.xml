<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RawLens" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.RawLens.Dialog</item>
    </style>

    <style name="ThemeOverlay.RawLens.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/quick_panel</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:buttonStyle">@style/Widget.RawLens.DialogButton</item>
    </style>

    <style name="Widget.RawLens.DialogButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/control_chip</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">40dp</item>
    </style>
</resources>
