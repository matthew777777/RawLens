<?xml version="1.0" encoding="utf-8"?>
<!-- Fresh install must mean fresh: nothing leaves the device.
    allowBackup=false already stops cloud backup/restore, but on Android 12+
    some OEMs still run device-to-device transfer — these rules close that gap.
    Pinned by BackupRulesTest: no <include> may appear here (fail closed). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
