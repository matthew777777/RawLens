#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
// SPDX-License-Identifier: Apache-2.0
// Directional lattice notch (2026-11-19). At 2x the merge leaves the Bayer lattice period (2 LR px =
// 4 HR px, and its 8 px beat) as dashes / beads along thin near-axis lines: far poles, twigs against
// the sky, branch outlines (IMG_20260919_184641_979, 8-16 frames: ~0.5 R/B sample per HR pixel, so
// the colour planes take the lattice phase of the line). AMaZE interpolates along edges and has none.
// Per pixel, along the edge tangent only: [1 2 3 4 3 2 1] / 16 with taps every pc.rpow px
// (= [1 2 1]/4 at +-d convolved with [1 2 1]/4 at +-2d: zeros at periods 2d and 4d; d = 1 at 2x kills
// the 2 px sub-pixel phase gap and the 4 px Bayer lattice). Across-edge profile untouched; strength
//   w = clamp((coh - c0) / (c1 - c0)) * clamp(energy / (K sigma) - 1),
// sigma = merged-image luma noise from the noise model (pc.a / pc.b already scaled to output px).
// Incoherent texture (grass, leaves, rock) has coh < c0 and is not touched.
// pc.robk = c0, pc.tau = c1, pc.clip = K, pc.rpow = tap spacing d, pc.LB = triangle half-length n.
// mode 0: pack z into fp16 RGB (P) once; mode 1: filter, neighbours from P (4 loads per tap instead of
// 12; malioc G615 longest path 79 -> fewer LS cycles), centre and result in fp32 in z (in place).
#include "lite_common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) buffer Z { float z[]; };
layout(std430, binding = 1) readonly buffer O { uvec2 o[]; };
layout(std430, binding = 2) buffer P { uvec2 pk[]; };
vec3 P3(int k) { uvec2 v = pk[k]; return vec3(unpackHalf2x16(v.x), unpackHalf2x16(v.y).x); }
void main() {
  int X = int(gl_GlobalInvocationID.x), Y = int(gl_GlobalInvocationID.y);
  if (X >= pc.W || Y >= pc.H) return;
  int i = Y * pc.W + X, HW = pc.H * pc.W;
  if (pc.mode == 0) { pk[i] = uvec2(packHalf2x16(vec2(z[i], z[HW + i])), packHalf2x16(vec2(z[2 * HW + i], 0.0))); return; }
  uvec2 v = o[i];
  vec2 cw = unpackHalf2x16(v.y);                       // coherence, gradient energy
  float wc = clamp((cw.x - pc.robk) / (pc.tau - pc.robk), 0.0, 1.0);
  if (wc <= 0.0) return;                               // most pixels: one 8-byte load
  vec3 c0 = vec3(z[i], z[HW + i], z[2 * HW + i]);
  float l = max((c0.x + c0.y + c0.z) * (1.0 / 3.0), 0.0);
  float w = wc * clamp(cw.y / (pc.clip * sqrt(max(pc.a * l + pc.b, 1e-12))) - 1.0, 0.0, 1.0);
  if (w <= 0.0) return;
  vec2 ev = unpackHalf2x16(v.x) * pc.rpow, p = vec2(float(X), float(Y));
  vec2 hi = vec2(float(pc.W - 1), float(pc.H - 1)) - 1e-3;
  // Triangle of half-length n = pc.LB taps (weights n + 1 - |t|), spacing pc.rpow: zeros at periods
  // (n + 1) d / k. n = 3, d = 1 at 2x: zeros at 2 and 4 HR px (sub-pixel phase gap + Bayer lattice).
  int n = pc.LB;
  float nf = float(n + 1);
  vec3 acc = nf * c0;
  [[dont_unroll]] for (int j = 0; j < 2 * n; ++j) {   // t = -n..-1, 1..n (one rolled loop: 32 registers)
    int t = j < n ? j - n : j - n + 1;
    vec2 q = clamp(p + float(t) * ev, vec2(0.0), hi);
    ivec2 q0 = ivec2(floor(q)); vec2 f = q - vec2(q0); int k = q0.y * pc.W + q0.x;
    float wt = nf - float(abs(t));
    vec2 g = vec2(1.0) - f;   // bilinear weights applied one tap at a time (short live ranges)
    acc += (wt * g.x * g.y) * P3(k);
    acc += (wt * f.x * g.y) * P3(k + 1);
    acc += (wt * g.x * f.y) * P3(k + pc.W);
    acc += (wt * f.x * f.y) * P3(k + pc.W + 1);
  }
  acc *= 1.0 / (nf * nf);
  vec3 r = mix(c0, acc, w);
  z[i] = r.x; z[HW + i] = r.y; z[2 * HW + i] = r.z;
}
