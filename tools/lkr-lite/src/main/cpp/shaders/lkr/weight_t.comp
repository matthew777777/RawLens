#version 450
#extension GL_GOOGLE_include_directive : require
// SPDX-License-Identifier: Apache-2.0
// Temporal consistency weight of frame k: residual r = U_k z0 - y_k against
// the REFERENCE-only start image z0. Test both the mean and energy over a
// 5x5 LR neighbourhood: displaced fine structures can have opposite-signed
// residuals and disappear from the mean. var(mean) = 2 (a y + b) / n
// (frame k + reference noise) plus a
// misregistration term (tau * gradient)^2 that does not average out.
// Separable: pass 2 (columns) of weight_th.comp's row sums (binding 2).
// w = 1 / (1 + e / k^2); reference frame 1. Writes wt (binding 3) only.
#include "lkr_common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer R { float r[]; };
layout(std430, binding = 1) readonly buffer Y { uint yh[]; };
// Frames are fp16, two per uint (halves the traffic of every frame read; 2026-11-14).
float yv(int o) { vec2 v = unpackHalf2x16(yh[o >> 1]); return (o & 1) != 0 ? v.y : v.x; }
layout(std430, binding = 2) readonly buffer TM { vec4 tmp[]; };   // row sums (weight_th.comp)
layout(std430, binding = 3) writeonly buffer WT { float wt[]; };
layout(std430, binding = 4) readonly buffer TD { float td[]; };   // model-error row sums (weight_th.comp)
layout(std430, binding = 5) writeonly buffer DK { float dk[]; };  // deep-shadow share for weight_td.comp

// Mean + energy test of one window (sums of r, a y + b, count, r^2, model error).
float windowWeight(float sr, float sv, float n, float ss, float sd, float g2, float kk) {
  float m = sr / n;
  float var = max(2.0 * sv / (n * n) + pc.f3 * pc.f3 * g2, 1e-12);
  float e = m * m / var, k2 = kk * kk;
  float w = 1.0 / (1.0 + max(e - k2, 0.0) / k2);
  float energyVar = max(2.0 * sv / n + pc.f3 * pc.f3 * g2 + pc.f0 * sd / n, 1e-12);
  float energy = ss / n / energyVar;
  float limit = 1.0 + kk * sqrt(2.0 / n);
  float support = clamp(2.0 - energy / limit, 0.0, 1.0);
  return min(w, support * support);
}

void main() {
  int j = int(gl_GlobalInvocationID.x), i = int(gl_GlobalInvocationID.y);
  int k = int(gl_GlobalInvocationID.z);
  if (j >= pc.w || i >= pc.h) return;
  int base = k * pc.h * pc.w;
  float w = 1.0, dark = 0.0;
  if (k != 0) {
    float sr = 0.0, sv = 0.0, n = 0.0, ss = 0.0, sd = 0.0;
    for (int di = -2; di <= 2; ++di) {   // columns over the row sums (weight_th.comp)
      int rowt = base + clamp(i + di, 0, pc.h - 1) * pc.w + j;
      vec4 q = tmp[rowt];
      sd += td[rowt];
      sr += q.x;
      sv += q.y;
      n += q.z;
      ss += q.w;
    }
    if (n > 0.0) {
      int jl = clamp(j - 2, 0, pc.w - 1), jr = clamp(j + 2, 0, pc.w - 1);
      int iu = clamp(i - 2, 0, pc.h - 1), id = clamp(i + 2, 0, pc.h - 1);
      float gx = (yv(int(base + i * pc.w + jr)) - yv(int(base + i * pc.w + jl))) * 0.25;
      float gy = (yv(int(base + id * pc.w + j)) - yv(int(base + iu * pc.w + j))) * 0.25;
      float g2 = gx * gx + gy * gy;
      w = windowWeight(sr, sv, n, ss, sd, g2, pc.rob_k);
      // Deep shadow (pc.f1 > 0.5): weight_td.comp also tests a wider window where dk > 0. Kept in
      // its own pass: inlined here it pushed every sample over the Mali register limit (64
      // registers, 640 bytes of stack) although only dark samples run it.
      float level = max((sv / n - pc.rob_b) / max(pc.rob_a, 1e-12), 0.0);
      dark = pc.f1 > 0.5 ? 1.0 - smoothstep(0.25 * pc.f2, pc.f2, level) : 0.0;
    }
  }
  wt[base + i * pc.w + j] = w;
  if (pc.f1 > 0.5) dk[base + i * pc.w + j] = dark;
}
