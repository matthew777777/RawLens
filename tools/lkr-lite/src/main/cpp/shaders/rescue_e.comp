#version 450
#extension GL_GOOGLE_include_directive : require
// SPDX-License-Identifier: Apache-2.0
// Rejection rescue, pass 1: support of each LR sample by a 1x merge made WITHOUT rejection (r = y - U z, vm validity).
// Over 5x5 samples: residual energy against the noise model (e = sum r^2 / (dof sum (a y + b)), dof = 1 - 3/K: the merge
// fitted the samples it is tested on) and the texture's own variance per Bayer channel against that noise. Static aliased
// texture (perforated panels, railings) is explained to within noise; a moving subject is not; texture below the noise
// cannot be judged (night motion), so it gets no support.
// support = clamp(2 - e / robk)^2 * clamp((var - noise) / (tau noise) - 1), robk = limit, tau = SNR gate (0: off).
#include "lite_common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer R { float r[]; };
layout(std430, binding = 1) readonly buffer VM { float vm[]; };
layout(std430, binding = 2) readonly buffer Y { uint yh[]; };
float yv(int o) { vec2 v = unpackHalf2x16(yh[o >> 1]); return (o & 1) != 0 ? v.y : v.x; }
layout(std430, binding = 3) writeonly buffer S { float sup[]; };

const int P = 20;   // 16 + 2 x 2 halo
shared vec4 tile[P * P];   // r^2, noise variance, y, valid

void main() {
  ivec2 origin = ivec2(gl_WorkGroupID.xy) * 16 - 2;
  int k = int(gl_WorkGroupID.z), base = k * pc.h * pc.w;
  for (int t = int(gl_LocalInvocationIndex); t < P * P; t += 256) {
    ivec2 q = origin + ivec2(t % P, t / P);
    vec4 v = vec4(0.0);
    if (q.x >= 0 && q.y >= 0 && q.x < pc.w && q.y < pc.h) {
      int o = base + q.y * pc.w + q.x;
      if (vm[o] > 0.5) { float y = yv(o); v = vec4(r[o] * r[o], pc.a * max(y, 0.0) + pc.b, y, 1.0); }
    }
    tile[t] = v;
  }
  barrier();
  int j = int(gl_GlobalInvocationID.x), i = int(gl_GlobalInvocationID.y);
  if (j >= pc.w || i >= pc.h) return;
  float se = 0.0, sn = 0.0, n = 0.0;
  // A tap's Bayer channel depends only on its parity: accumulate (sum y, sum y^2, count) per parity class
  // (row dy, column dx), even columns 0 2 4 / odd 1 3, then map classes to channels.
  vec3 e0 = vec3(0.0), o0 = vec3(0.0), e1 = vec3(0.0), o1 = vec3(0.0);
  ivec2 l = ivec2(gl_LocalInvocationID.xy);
  int rows = 5 + min(pc.mode, 0);   // runtime bound keeps both loops rolled: 63 -> 39 registers (malioc G615)
  for (int dy = 0; dy < rows; ++dy) {
    int t = (l.y + dy) * P + l.x;
    vec3 ev = vec3(0.0), od = vec3(0.0);
    for (int dx = 0; dx < rows; ++dx) {
      vec4 v = tile[t + dx];
      se += v.x; sn += v.y; n += v.w;
      vec3 c = vec3(v.z, v.z * v.z, 1.0) * v.w;
      if ((dx & 1) == 0) ev += c; else od += c;
    }
    if ((dy & 1) == 0) { e0 += ev; o0 += od; } else { e1 += ev; o1 += od; }
  }
  float s = 0.0;
  if (n >= 8.0) {
    // first tap (i - 2, j - 2) has the parity of (i, j): R where both even, B where both odd, G the rest
    bool pi = (i & 1) != 0, pj = (j & 1) != 0;
    vec3 c00 = pi ? e1 : e0, c01 = pi ? o1 : o0, c10 = pi ? e0 : e1, c11 = pi ? o0 : o1;   // rows by tap parity
    vec3 rr = pj ? c01 : c00, bb = pj ? c10 : c11, gg = pj ? c00 + c11 : c01 + c10;
    // rr: taps with even row and even column; bb: odd/odd; gg: mixed
    float var = 0.0;
    if (rr.z > 1.5) var += max(rr.y - rr.x * rr.x / rr.z, 0.0);
    if (gg.z > 1.5) var += max(gg.y - gg.x * gg.x / gg.z, 0.0);
    if (bb.z > 1.5) var += max(bb.y - bb.x * bb.x / bb.z, 0.0);
    float e = se / max((1.0 - 3.0 / float(pc.K)) * sn, 1e-12);
    float t = clamp(2.0 - e / pc.robk, 0.0, 1.0);
    if (pc.tau > 0.0) t = min(t, clamp((var - sn) / max(pc.tau * sn, 1e-12) - 1.0, 0.0, 1.0));
    s = t * t;
  }
  sup[base + i * pc.w + j] = s;
}
