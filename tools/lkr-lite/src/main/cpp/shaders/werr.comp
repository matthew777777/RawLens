#version 450
#extension GL_GOOGLE_include_directive : require
// SPDX-License-Identifier: Apache-2.0
// Per-sample e = r^2 / (a y + b + (tau * same-colour gradient or 3x3 range)^2) (LK-R weight_e).
#include "lite_common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer R { float r[]; };
layout(std430, binding = 1) readonly buffer Y { uint yh[]; };
// Frames are fp16, two per uint (halves the traffic of every frame read; 2026-11-14).
float yv(int o) { vec2 v = unpackHalf2x16(yh[o >> 1]); return (o & 1) != 0 ? v.y : v.x; }
layout(std430, binding = 2) writeonly buffer E { float e[]; };

void main() {
  int k, i, j;
  lrIndex(k, i, j);
  if (j >= pc.w || i >= pc.h) return;
  int base = k * pc.h * pc.w;
  int t = base + i * pc.w + j;
  int jl = max(j - 2, 0), jr = min(j + 2, pc.w - 1), iu = max(i - 2, 0), id = min(i + 2, pc.h - 1);
  float gx = (yv(int(base + i * pc.w + jr)) - yv(int(base + i * pc.w + jl))) * 0.25;
  float gy = (yv(int(base + id * pc.w + j)) - yv(int(base + iu * pc.w + j))) * 0.25;
  float lo = yv(int(t)), hi = lo;
  for (int di = -2; di <= 2; di += 2)
    for (int dj = -2; dj <= 2; dj += 2) {
      float v = yv(int(base + clamp(i + di, 0, pc.h - 1) * pc.w + clamp(j + dj, 0, pc.w - 1)));
      lo = min(lo, v); hi = max(hi, v);
    }
  float rg = (hi - lo) * 0.25;
  float edge = pc.tau * pc.tau * max(gx * gx + gy * gy, rg * rg);
  float var = max(pc.a * max(yv(int(t)), 0.0) + pc.b + edge, 1e-12);
  float rv = r[t];
  e[t] = rv * rv / var;
}
