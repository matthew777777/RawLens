#version 450
#extension GL_GOOGLE_include_directive : require
// SPDX-License-Identifier: GPL-3.0-or-later
// scatter.comp, one invocation per 2x2 Bayer quad (affine + local block
// displacement once, rw as vec2 row pairs); per sample identical taps and
// fixed-point atomics (bit-identical sum).
#define LKR_LOCAL_BINDING 3
#include "lkr_common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer RW { vec2 rw[]; };
layout(std430, binding = 1) readonly buffer P { float p[]; };
layout(std430, binding = 2) buffer ACC { int acc[]; };

void main() {
  int J = int(gl_GlobalInvocationID.x), I = int(gl_GlobalInvocationID.y);
  int k = int(gl_GlobalInvocationID.z);
  int hw = pc.w / 2;
  if (J >= hw || 2 * I >= pc.h) return;
  float a0 = p[k * 6 + 0], a1 = p[k * 6 + 1], a2 = p[k * 6 + 2];
  float a3 = p[k * 6 + 3], a4 = p[k * 6 + 4], a5 = p[k * 6 + 5];
  float sf = float(pc.s);
  float invn = 1.0 / (sf * sf);
  vec2 d = localD(k, subPos(2 * I, 2 * J, 0, 0));
  for (int dy = 0; dy < 2; ++dy) {
    int i = 2 * I + dy;
    vec2 r2 = rw[(k * pc.h + i) * hw + J];
    for (int dx = 0; dx < 2; ++dx) {
      float r = r2[dx];
      if (r == 0.0) continue;                          // invalid / clipped / fully rejected
      int j = 2 * J + dx;
      int base = bayerChannel(i, j) * pc.H * pc.W;
      float rs = r * invn * pc.scale;
      for (int oy = 0; oy < pc.s; ++oy)
        for (int ox = 0; ox < pc.s; ++ox) {
          vec2 u = subPos(i, j, ox, oy);
          precise vec2 q = sf * (vec2(a0 * u.x + a1 * u.y + a2, a3 * u.x + a4 * u.y + a5) + d);
          ivec2 x0; vec2 a;
          if (!taps(q, x0, a)) continue;   // out of frame under the CURRENT motion
          int o = base + x0.y * pc.W + x0.x;
          atomicAdd(acc[o], int(round(rs * (1.0 - a.x) * (1.0 - a.y))));
          atomicAdd(acc[o + 1], int(round(rs * a.x * (1.0 - a.y))));
          atomicAdd(acc[o + pc.W], int(round(rs * (1.0 - a.x) * a.y)));
          atomicAdd(acc[o + pc.W + 1], int(round(rs * a.x * a.y)));
        }
    }
  }
}
