#version 450
#extension GL_GOOGLE_include_directive : require
// SPDX-License-Identifier: Apache-2.0
// Exact adjoint U^T r as a GATHER, fused with the HQS z-update (paper Eq. 5):
//   z <- z - eta [U^T r + mu (z - x)]          (mode 0)
//   z <- U^T r                                 (mode 1/2, power iteration)
// One invocation per HR pixel (all 3 planes, all K frames). For frame k the
// LR sub-samples whose bilinear taps can reach this pixel satisfy
// |s (A u + t) - q| < 1 per axis, i.e. u within R = |A^-1|_inf / s of
// u* = A^-1 (q/s - t); every LR pixel in that window is visited and its
// sub-samples' taps are recomputed EXACTLY as in resid.comp, so the weights
// are the transpose of the forward operator, with no atomics and a fixed,
// deterministic summation order.
#include "lkr_common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) buffer Z { float z[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) readonly buffer R { float r[]; };
layout(std430, binding = 3) readonly buffer P { float p[]; };

void main() {
  int X0 = int(gl_GlobalInvocationID.x), Y0 = int(gl_GlobalInvocationID.y);
  if (X0 >= pc.W || Y0 >= pc.H) return;
  float sf = float(pc.s);
  float invn = 1.0 / (sf * sf);
  vec2 q0 = vec2(float(X0) + 0.5, float(Y0) + 0.5);
  vec3 g = vec3(0.0);
  for (int k = 0; k < pc.K; ++k) {
    float a0 = p[k * 6 + 0], a1 = p[k * 6 + 1], a2 = p[k * 6 + 2];
    float a3 = p[k * 6 + 3], a4 = p[k * 6 + 4], a5 = p[k * 6 + 5];
    float det = a0 * a4 - a1 * a3;
    mat2 Ai = mat2(a4, -a3, -a1, a0) / det;              // column-major inverse
    vec2 us = Ai * (q0 / sf - vec2(a2, a5));
    float R = (max(abs(Ai[0][0]) + abs(Ai[1][0]), abs(Ai[0][1]) + abs(Ai[1][1]))) / sf + 1e-3;
    int j0 = int(floor(us.x - R)), j1 = int(floor(us.x + R));
    int i0 = int(floor(us.y - R)), i1 = int(floor(us.y + R));
    j0 = max(j0, 0); i0 = max(i0, 0); j1 = min(j1, pc.w - 1); i1 = min(i1, pc.h - 1);
    for (int i = i0; i <= i1; ++i)
      for (int j = j0; j <= j1; ++j) {
        float rv = r[(k * pc.h + i) * pc.w + j];
        if (rv == 0.0) continue;
        int c = bayerChannel(i, j);
        float acc = 0.0;
        for (int oy = 0; oy < pc.s; ++oy)
          for (int ox = 0; ox < pc.s; ++ox) {
            vec2 u = subPos(i, j, ox, oy);
            vec2 q = sf * vec2(a0 * u.x + a1 * u.y + a2, a3 * u.x + a4 * u.y + a5);
            vec2 f = q - 0.5;
            vec2 fl = floor(f);
            ivec2 t0 = ivec2(fl);
            vec2 a = f - fl;
            float wx = t0.x == X0 ? 1.0 - a.x : (t0.x + 1 == X0 ? a.x : 0.0);
            float wy = t0.y == Y0 ? 1.0 - a.y : (t0.y + 1 == Y0 ? a.y : 0.0);
            acc += wx * wy;
          }
        g[c] += rv * acc * invn;
      }
  }
  int HW = pc.H * pc.W;
  int o = Y0 * pc.W + X0;
  for (int c = 0; c < 3; ++c) {
    int idx = c * HW + o;
    if (pc.mode != 0) {
      z[idx] = g[c];
    } else {
      float zi = z[idx];
      z[idx] = zi - pc.eta * (g[c] + pc.mu * (zi - x[idx]));
    }
  }
}
