// SPDX-License-Identifier: GPL-3.0-or-later
// Frame-global RCD for recording, subgroup column-walker schedule.
// RawLens, 2026-11-03. Equations and step order: RawTherapee b2ee504c
// rtengine/rcd_demosaic.cc, Copyright (c) 2017-2020 Luis Sanz Rodriguez and
// Ingo Weyrich, via the attributed FP32 port tools/photo-rcd/baseline.comp.
// Canonical 9-pixel border: Gabor Horvath.
// Schedule (new): one 16-lane subgroup owns a 64-pixel column band, 4 pixels
// per lane, and walks down rows. Vertical neighbours live in a rolling FP16
// register history; horizontal neighbours come from adjacent lanes by
// subgroup shuffle. No shared memory and no barriers. Bands overlap by the
// stencil erosion so each written pixel has a complete neighbourhood.
// Pass 0: refined VH, refined PQ, LP planes. Pass 1: green and missing R/B.
// Pass 2: R/B at green and product output. Pass 3: canonical border.
// Generated by generate.py: product code comes from tile_local.py.
#version 450
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_vote : require
layout(local_size_x=16) in;
// Border pass uses the same 16-wide groups over a 1D border index.
// RAW16 source words (binding 9); normalized in-shader, so no CFA pass.
layout(binding=9,std430) readonly restrict buffer Source { uvec2 sourcePairs[]; };
layout(binding=1,std430) restrict buffer Planes { uvec2 planes[]; };
layout(push_constant) uniform Params { int width; int height; int phase; int stage; } p;
//@METADATA@
layout(constant_id=9) const int algorithmPass=-1;
const float eps=1e-5, epssq=1e-10;
const int ROWS=64;
// Final pass rows per workgroup: one row per group made launch overhead dominate.
const int FINAL_ROWS=8;
// Planes: 0 VH, 1 PQ, 2 LP, 3 green, 4 missing (FP16, four pixels per uvec2).
int lane,x0,band0;
int color(int x,int y) { return (p.phase >> (2*((y&1)*2+(x&1))))&3; }
bool inside(int x,int y) { return x>=0 && y>=0 && x<p.width && y<p.height; }
bool domain(int x,int y,int m) { return x>=m && y>=m && x<p.width-m && y<p.height-m; }
vec4 U(uvec2 u) { return vec4(unpackHalf2x16(u.x),unpackHalf2x16(u.y)); }
uvec2 P(vec4 v) { return uvec2(packHalf2x16(v.xy),packHalf2x16(v.zw)); }
bool stripInside(int y) { return y>=0 && y<p.height && x0>=0 && x0<p.width; }
// Same normalization as the separate pass: clamp((code-black[quad])/(white-black[quad]),0,1).
// Requires 2-byte pixels, crop left %4==0 and row stride %8==0 (engine-checked)
// so four crop pixels are one aligned 8-byte load.
vec4 normalizeCodes(uvec2 w,int y) {
    vec4 code=vec4(float(w.x&65535u),float(w.x>>16),float(w.y&65535u),float(w.y>>16));
    int sy=y+m.top,sx=x0+m.left;
    vec2 blackRow=(sy&1)==0?m.black.xy:m.black.zw;
    vec4 black=(sx&1)==0?blackRow.xyxy:blackRow.yxyx;
    precise vec4 numerator=code-black;
    precise vec4 denominator=vec4(m.white)-black;
    return clamp(numerator/denominator,0.0,1.0);
}
uvec2 loadRaw(int y) {
    if(!stripInside(y)) return uvec2(0u);
    return P(normalizeCodes(sourcePairs[(uint(y+m.top)*uint(m.rowBytes)+uint(x0+m.left)*2u)>>3u],y));
}
int planeIndex(int plane,int y) { return plane*(p.width*p.height/4)+((y*p.width+x0)>>2); }
uvec2 loadPlane(int plane,int y) { return stripInside(y)?planes[planeIndex(plane,y)]:uvec2(0u); }
// Output sampling (RAW metadata words 16/17): gradeYuv reads source pixel
// int((i+0.5)*src/out) per axis. A coordinate is computed when some output
// index may map to it; 0 or out>=src computes everything.
layout(binding=10,std430) readonly buffer RawMetadataWords { int metaWords[]; };
bool sampled(int c,int outN,int srcN) {
    if(outN<=0 || outN>=srcN) return true;
    int j=int(floor((float(c)+0.5)*float(outN)/float(srcN)));
    for(int k=j-1;k<=j+1;++k) {
        if(k<0 || k>=outN) continue;
        // gradeYuv computes int((k+0.5)*src/out) with GPU (not correctly
        // rounded) division; when u is an integer either neighbour may be
        // read, so both are computed (margin).
        float u=(float(k)+0.5)*float(srcN)/float(outN);
        if(abs(u-(float(c)+0.5))<=0.5+1e-3) return true;
    }
    return false;
}
// Columns [erosion, 64-erosion) of the band are complete.
bool ownsStrip(int erosion) { int c=4*lane;return c>=erosion && c+3<64-erosion; }
#define W(a,b,c,j) ((j)<4?a[(j)&3]:(j)<8?b[(j)&3]:c[(j)&3])
#define AT(n,j) W(n##a,n##b,n##c,j)
// Twelve-pixel window x0-4..x0+7 from this lane and its neighbours. Must be
// executed in subgroup-uniform control flow.
#define WIN(n,u) vec4 n##a=U(subgroupShuffleUp(u,1u)),n##b=U(u),n##c=U(subgroupShuffleDown(u,1u))
float hpf(float m3,float m2,float m1,float c,float p1,float p2,float p3) { return (m3-m1-p1+p3)-3.0*(m2+p2)+6.0*c; }
float refine(float c,float a,float b,float d,float e,bool cardinal) {
    float nb=cardinal?0.25*((a+b)+(d+e)):0.25*(a+b+d+e);
    return abs(0.5-c)<abs(0.5-nb)?nb:c;
}
float rcdInterpolate(float a,float b,float c) { return a*(b-c)+c; }

void guides(int y0) {
    // Lags: raw r; responses q=r-3; unrefined VH/PQ v=r-4; refined/LP z=r-5.
    uvec2 R0=uvec2(0u),R1=R0,R2=R0,R3=R0,R4=R0,R5=R0,R6=R0;
    uvec2 V0=R0,V1=R0,V2=R0,H0=R0,H1=R0,E0=R0,E1=R0,E2=R0,S0=R0,S1=R0,S2=R0;
    uvec2 A0=R0,A1=R0,A2=R0,Q0=R0,Q1=R0,Q2=R0;
    for(int r=y0-7;r<y0+ROWS+5;++r) {
        R0=R1;R1=R2;R2=R3;R3=R4;R4=R5;R5=R6;R6=loadRaw(r);
        int q=r-3;
        {
            WIN(m3,R0);WIN(m2,R1);WIN(m1,R2);WIN(c0,R3);WIN(p1,R4);WIN(p2,R5);WIN(p3,R6);
            vec4 v,h,se,sw;
            for(int i=0;i<4;++i) {
                int x=x0+i,j=i+4;
                bool ok=domain(x,q,3);
                v[i]=ok?hpf(AT(m3,j),AT(m2,j),AT(m1,j),AT(c0,j),AT(p1,j),AT(p2,j),AT(p3,j)):0.0;
                h[i]=ok?hpf(AT(c0,j-3),AT(c0,j-2),AT(c0,j-1),AT(c0,j),AT(c0,j+1),AT(c0,j+2),AT(c0,j+3)):0.0;
                // Upstream convention: diagonal responses on odd columns, shared by pairs.
                const int io=i|1,jo=io+4;
                bool od=domain(x0+io,q,3);
                se[i]=od?hpf(AT(m3,jo-3),AT(m2,jo-2),AT(m1,jo-1),AT(c0,jo),AT(p1,jo+1),AT(p2,jo+2),AT(p3,jo+3)):0.0;
                sw[i]=od?hpf(AT(m3,jo+3),AT(m2,jo+2),AT(m1,jo+1),AT(c0,jo),AT(p1,jo-1),AT(p2,jo-2),AT(p3,jo-3)):0.0;
            }
            V0=V1;V1=V2;V2=P(v);H0=H1;H1=P(h);E0=E1;E1=E2;E2=P(se);S0=S1;S1=S2;S2=P(sw);
        }
        int vrow=r-4;
        {
            vec4 vm=U(V0),vc=U(V1),vp=U(V2);
            WIN(hc,H0);WIN(em,E0);WIN(ec,E1);WIN(ep,E2);WIN(wm,S0);WIN(wc,S1);WIN(wp,S2);
            vec4 vh=vec4(0.0),pq=vec4(0.0);
            for(int i=0;i<4;++i) {
                int x=x0+i,j=i+4;
                if(!domain(x,vrow,4)) continue;
                float va=max(epssq,vm[i]*vm[i]+vc[i]*vc[i]+vp[i]*vp[i]);
                float h0=AT(hc,j-1),h1=AT(hc,j),h2=AT(hc,j+1);
                float vb=max(epssq,h0*h0+h1*h1+h2*h2);
                vh[i]=va/(va+vb);
                if(color(x,vrow)!=1) {
                    float a0=AT(em,j-1),a1=AT(ec,j),a2=AT(ep,j+1);
                    float b0=AT(wm,j+1),b1=AT(wc,j),b2=AT(wp,j-1);
                    float a=max(epssq,a0*a0+a1*a1+a2*a2),b=max(epssq,b0*b0+b1*b1+b2*b2);
                    pq[i]=a/(a+b);
                }
            }
            A0=A1;A1=A2;A2=P(vh);Q0=Q1;Q1=Q2;Q2=P(pq);
        }
        int z=r-5;
        {
            WIN(vu,A0);WIN(vc,A1);WIN(vd,A2);WIN(qu,Q0);WIN(qc,Q1);WIN(qd,Q2);
            WIN(ru,R0);WIN(rc,R1);WIN(rd,R2);
            vec4 vh,pq,lp;
            for(int i=0;i<4;++i) {
                int x=x0+i,j=i+4;
                vh[i]=refine(AT(vc,j),AT(vu,j-1),AT(vu,j+1),AT(vd,j-1),AT(vd,j+1),true);
                pq[i]=refine(AT(qc,j),AT(qu,j-1),AT(qu,j+1),AT(qd,j-1),AT(qd,j+1),false);
                lp[i]=domain(x,z,2) && color(x,z)!=1
                    ? AT(rc,j)+0.5*(AT(ru,j)+AT(rd,j)+AT(rc,j-1)+AT(rc,j+1))+0.25*(AT(ru,j-1)+AT(ru,j+1)+AT(rd,j-1)+AT(rd,j+1))
                    : 0.0;
            }
            if(z>=y0 && z<y0+ROWS && ownsStrip(8) && stripInside(z)) {
                planes[planeIndex(0,z)]=P(vh);planes[planeIndex(1,z)]=P(pq);planes[planeIndex(2,z)]=P(lp);
            }
        }
    }
}

void greenMissing(int y0) {
    // Lags: raw r; green t=r-4; missing m=r-6.
    uvec2 R0=uvec2(0u),R1=R0,R2=R0,R3=R0,R4=R0,R5=R0,R6=R0,R7=R0,R8=R0,R9=R0;
    uvec2 G0=R0,G1=R0,G2=R0,G3=R0,G4=R0;
    for(int r=y0-10;r<y0+ROWS+6;++r) {
        R0=R1;R1=R2;R2=R3;R3=R4;R4=R5;R5=R6;R6=R7;R7=R8;R8=R9;R9=loadRaw(r);
        int t=r-4;
        {
            vec4 r4m=U(R1),r3m=U(R2),r2m=U(R3),r1m=U(R4),r1p=U(R6),r2p=U(R7),r3p=U(R8),r4p=U(R9);
            WIN(rc,R5);
            uvec2 lpc=loadPlane(2,t);
            WIN(lr,lpc);
            vec4 lN=U(loadPlane(2,t-2)),lS=U(loadPlane(2,t+2)),vh=U(loadPlane(0,t));
            vec4 g;
            for(int i=0;i<4;++i) {
                int x=x0+i,j=i+4;
                float c=AT(rc,j),v=0.0;
                if(inside(x,t)) {
                    if(color(x,t)==1 || !domain(x,t,4)) v=c;
                    else {
                        float ng=eps+(abs(r1p[i]-r1m[i])+abs(c-r2m[i]))+(abs(r1m[i]-r3m[i])+abs(r2m[i]-r4m[i]));
                        float sg=eps+(abs(r1m[i]-r1p[i])+abs(c-r2p[i]))+(abs(r1p[i]-r3p[i])+abs(r2p[i]-r4p[i]));
                        float wg=eps+(abs(AT(rc,j+1)-AT(rc,j-1))+abs(c-AT(rc,j-2)))+(abs(AT(rc,j-1)-AT(rc,j-3))+abs(AT(rc,j-2)-AT(rc,j-4)));
                        float eg=eps+(abs(AT(rc,j-1)-AT(rc,j+1))+abs(c-AT(rc,j+2)))+(abs(AT(rc,j+1)-AT(rc,j+3))+abs(AT(rc,j+2)-AT(rc,j+4)));
                        float l=AT(lr,j),l2=l+l;
                        float ne=r1m[i]*l2/(eps+l+lN[i]),se=r1p[i]*l2/(eps+l+lS[i]);
                        float we=AT(rc,j-1)*l2/(eps+l+AT(lr,j-2)),ee=AT(rc,j+1)*l2/(eps+l+AT(lr,j+2));
                        float ve=(sg*ne+ng*se)/(ng+sg),he=(wg*ee+eg*we)/(eg+wg);
                        v=rcdInterpolate(vh[i],he,ve);
                    }
                }
                g[i]=v;
            }
            G0=G1;G1=G2;G2=G3;G3=G4;G4=P(g);
            if(t>=y0 && t<y0+ROWS && ownsStrip(8) && stripInside(t)) planes[planeIndex(3,t)]=G4;
        }
        int m=r-6;
        {
            WIN(r3u,R0);WIN(r1u,R2);WIN(rc,R3);WIN(r1d,R4);WIN(r3d,R6);
            WIN(g2u,G0);WIN(g1u,G1);WIN(gc,G2);WIN(g1d,G3);WIN(g2d,G4);
            vec4 pq=U(loadPlane(1,m));
            vec4 out4;
            for(int i=0;i<4;++i) {
                int x=x0+i,j=i+4;
                float v=0.0;
                if(inside(x,m) && color(x,m)!=1) {
                    if(!domain(x,m,4)) v=AT(rc,j);
                    else {
                        float g0=AT(gc,j);
                        float nwg=eps+abs(AT(r1u,j-1)-AT(r1d,j+1))+abs(AT(r1u,j-1)-AT(r3u,j-3))+abs(g0-AT(g2u,j-2));
                        float neg=eps+abs(AT(r1u,j+1)-AT(r1d,j-1))+abs(AT(r1u,j+1)-AT(r3u,j+3))+abs(g0-AT(g2u,j+2));
                        float swg=eps+abs(AT(r1d,j-1)-AT(r1u,j+1))+abs(AT(r1d,j-1)-AT(r3d,j-3))+abs(g0-AT(g2d,j-2));
                        float seg=eps+abs(AT(r1d,j+1)-AT(r1u,j-1))+abs(AT(r1d,j+1)-AT(r3d,j+3))+abs(g0-AT(g2d,j+2));
                        float nwe=AT(r1u,j-1)-AT(g1u,j-1),nee=AT(r1u,j+1)-AT(g1u,j+1),swe=AT(r1d,j-1)-AT(g1d,j-1),see=AT(r1d,j+1)-AT(g1d,j+1);
                        float pe=(nwg*see+seg*nwe)/(nwg+seg),qe=(neg*swe+swg*nee)/(neg+swg);
                        v=g0+rcdInterpolate(pq[i],qe,pe);
                    }
                }
                out4[i]=v;
            }
            if(m>=y0 && m<y0+ROWS && ownsStrip(8) && stripInside(m)) planes[planeIndex(4,m)]=P(out4);
        }
    }
}

//@PRODUCT@

// Walker product path: same equations and operation order as productPixel
// above, with dispatch-uniform configuration read once per invocation and
// gain-map corners fetched as vec4 and shared by a lane's four pixels when
// they fall in one map cell (Mali is load-instruction bound).
layout(binding=7,std430) readonly buffer ProductConfigVec { uvec4 config4[]; };
vec3 pWb; float pMin; bool pLsc; int pScale,pCols,pRows; float pOffX,pDenX,pOffY,pDenY;
void productSetup() {
    pWb=vec3(parameter(2),parameter(3),parameter(4));pMin=min(pWb.r,min(pWb.g,pWb.b));
    pLsc=config[11]!=0u;pScale=max(1,m.reserved2);pCols=int(config[6]);pRows=int(config[5]);
    pOffX=float(int(config[0])-int(config[7]));pDenX=float(int(config[9])-int(config[7]));
    pOffY=float(int(config[1])-int(config[8]));pDenY=float(int(config[10])-int(config[8]));
}
precise float lscX(int x) { return clamp((float(x)*float(pScale)+0.5*float(pScale-1)+pOffX)/pDenX,0.0,1.0)*float(pCols-1); }
precise float lscY(int y) { return clamp((float(y)*float(pScale)+0.5*float(pScale-1)+pOffY)/pDenY,0.0,1.0)*float(pRows-1); }
vec4 mapCorner(int x,int y) { return uintBitsToFloat(config4[4+y*pCols+x]); }
// Per-row LSC gains for this lane's four pixels. One bilinear evaluation at
// the lane's first pixel (same equations as productPixel) plus the cell's
// exact x-derivative from the same four corners: within a map cell the
// bilinear map is linear in x, so this is exact up to rounding; a lane
// straddling a cell boundary extrapolates up to three pixels across a
// continuous piecewise-linear kink. Multiple evaluations per lane exceed
// Mali's register budget in this pass. Gains are kept as packed FP16.
uvec2 lscR,lscG,lscB;
void productRow(int x0,int y) {
    if(!pLsc) return;
    precise float ny=lscY(y);int gy=int(ny),gy1=min(gy+1,pRows-1);
    precise float nx=lscX(x0);int gx=int(nx),gx1=min(gx+1,pCols-1);
    vec4 c00=mapCorner(gx,gy),c10=mapCorner(gx1,gy),c01=mapCorner(gx,gy1),c11=mapCorner(gx1,gy1);
    precise vec4 ga=c00+(c10-c00)*(nx-float(gx));
    precise vec4 gb=c01+(c11-c01)*(nx-float(gx));
    precise vec4 g0=ga+(gb-ga)*(ny-float(gy));
    // d(nx)/dx is zero where the map coordinate is clamped.
    float unclamped=(float(x0)*float(pScale)+0.5*float(pScale-1)+pOffX)/pDenX;
    float dnx=(unclamped>0.0 && unclamped<1.0)?float(pScale)/pDenX*float(pCols-1):0.0;
    vec4 slope=((c10-c00)+((c11-c01)-(c10-c00))*(ny-float(gy)))*dnx;
    vec4 k=vec4(0.0,1.0,2.0,3.0);
    lscR=P(g0.x+slope.x*k);lscG=P(0.5*((g0.y+slope.y*k)+(g0.z+slope.z*k)));lscB=P(g0.w+slope.w*k);
}
bool productBad=false;
void productFast(ivec2 site,vec3 sourceRgb,int lane4) {
    precise vec3 rgb=sourceRgb;
    precise vec3 t=clamp((rgb-vec3(0.70))/vec3(0.99-0.70),0.0,1.0);
    precise vec3 white=t*t*(vec3(3.0)-2.0*t);
    precise float blend=max(white.r,max(white.g,white.b));
    rgb=rgb+(vec3(pMin)/pWb-rgb)*blend;
    if(pLsc) {
        rgb*=vec3(U(lscR)[lane4],U(lscG)[lane4],U(lscB)[lane4]);
    }
    // Out-of-domain status is merged per subgroup by the caller.
    productBad=productBad || any(isnan(rgb)) || any(isinf(rgb)) || any(lessThan(rgb,vec3(0.0))) || any(greaterThan(rgb,vec3(65504.0)));
    //@STORE@
}

void finalRow(int f) {
    if(!sampled(f,metaWords[17],p.height)) return;
    // FP16 arithmetic (RelaxedPrecision) for the final colour step: -3.5 ms
    // at 4K on Mali-G615; 68.5 dB vs exact engine with LSC (max 3.9e-3).
    precision mediump float;
    // One subgroup per output row: no register history (keeps the final
    // pass, which also carries the product step, below Mali's register cliff).
    productSetup();
    {
        vec4 r3u=U(loadRaw(f-3)),r1u=U(loadRaw(f-1)),r1d=U(loadRaw(f+1)),r3d=U(loadRaw(f+3));
        vec4 m3u=U(loadPlane(4,f-3)),m1u=U(loadPlane(4,f-1)),m1d=U(loadPlane(4,f+1)),m3d=U(loadPlane(4,f+3));
        vec4 g2u=U(loadPlane(3,f-2)),g1u=U(loadPlane(3,f-1)),g1d=U(loadPlane(3,f+1)),g2d=U(loadPlane(3,f+2));
        uvec2 R3=loadRaw(f),M3=loadPlane(4,f),G2=loadPlane(3,f);
        WIN(rc,R3);WIN(mc,M3);WIN(gc,G2);
        if(!ownsStrip(4) || !stripInside(f)) return;
        vec4 vh=U(loadPlane(0,f));
        productRow(x0,f);
        for(int i=0;i<4;++i) {
            int x=x0+i,j=i+4;
            if(x>=p.width || !sampled(x,metaWords[16],p.width)) continue;
            int c=color(x,f);
            vec3 result;
            // Canonical border pixels are written by the border pass.
            if(!domain(x,f,9)) {
                continue;
            } else if(c!=1) {
                float mm=AT(mc,j);
                result=c==0?vec3(AT(rc,j),AT(gc,j),mm):vec3(mm,AT(gc,j),AT(rc,j));
            } else {
                float g0=AT(gc,j);
                result=vec3(0.0,g0,0.0);
                for(int kk=0;kk<=2;kk+=2) {
                    bool vk=color(x,f-1)==kk,hk=color(x-1,f)==kk;
                    float n1=vk?r1u[i]:m1u[i],n3=vk?r3u[i]:m3u[i],s1=vk?r1d[i]:m1d[i],s3=vk?r3d[i]:m3d[i];
                    float w1=hk?AT(rc,j-1):AT(mc,j-1),w3=hk?AT(rc,j-3):AT(mc,j-3),e1=hk?AT(rc,j+1):AT(mc,j+1),e3=hk?AT(rc,j+3):AT(mc,j+3);
                    float ng=(eps+abs(g0-g2u[i]))+abs(s1-n1)+abs(n1-n3);
                    float sg=(eps+abs(g0-g2d[i]))+abs(n1-s1)+abs(s1-s3);
                    float wg=(eps+abs(g0-AT(gc,j-2)))+abs(e1-w1)+abs(w1-w3);
                    float eg=(eps+abs(g0-AT(gc,j+2)))+abs(w1-e1)+abs(e1-e3);
                    float ne=n1-g1u[i],se=s1-g1d[i],we=w1-AT(gc,j-1),ee=e1-AT(gc,j+1);
                    float ve=(ng*se+sg*ne)/(ng+sg),he=(eg*we+wg*ee)/(eg+wg);
                    result[kk]=g0+rcdInterpolate(vh[i],he,ve);
                }
            }
            productFast(ivec2(x,f),max(vec3(0.0),result),i);
        }
        if(subgroupAny(productBad) && subgroupElect()) atomicOr(config[12],1u);
    }
}


float rawAt(int x,int y) {
    uint a=uint(y+m.top)*uint(m.rowBytes)+uint(x+m.left)*2u;
    uvec2 w=sourcePairs[a>>3u];uint word=((a>>2u)&1u)==0u?w.x:w.y;
    float code=float(((a&2u)==0u)?(word&65535u):(word>>16));
    int quad=((y+m.top)&1)*2+((x+m.left)&1);
    precise float numerator=code-m.black[quad];
    precise float denominator=m.white-m.black[quad];
    return clamp(numerator/denominator,0.0,1.0);
}
// Canonical border (Gabor Horvath): 3x3 same-colour average, own colour kept.
void borderPass() {
    int k=int(gl_GlobalInvocationID.x),w=p.width,h=p.height,band=9*w;
    int x,y;
    if(k<2*band) { y=k/w;x=k%w;if(y>=9) y=h-18+y; }
    else { int t=k-2*band,rows=h-18;if(t>=18*rows) return;int side=t/(9*rows);t%=9*rows;y=9+t/9;x=side==0?t%9:w-9+t%9; }
    vec3 total=vec3(0.0);vec3 count=vec3(0.0);
    for(int dy=-1;dy<=1;++dy) for(int dx=-1;dx<=1;++dx) {
        int nx=x+dx,ny=y+dy;
        if(!inside(nx,ny)) continue;
        vec3 sel=vec3(equal(ivec3(color(nx,ny)),ivec3(0,1,2)));
        total+=rawAt(nx,ny)*sel;count+=sel;
    }
    vec3 result=mix(total/max(count,vec3(1.0)),vec3(rawAt(x,y)),vec3(equal(ivec3(color(x,y)),ivec3(0,1,2))));
    productPixel(ivec2(x,y),max(vec3(0.0),result));
}

void main() {
    int stage=algorithmPass<0?p.stage:algorithmPass;
    if(stage==3) { borderPass();return; }
    lane=int(gl_SubgroupInvocationID);
    int erosion=stage==2?4:8,stride=64-2*erosion;
    band0=int(gl_WorkGroupID.x)*stride-erosion;
    x0=band0+4*lane;
    int y0=int(gl_WorkGroupID.y)*ROWS;
    if(stage==0) guides(y0); else if(stage==1) greenMissing(y0); else if(stage==2) for(int k=0;k<FINAL_ROWS;++k) finalRow(int(gl_WorkGroupID.y)*FINAL_ROWS+k);
}
