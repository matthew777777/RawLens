// SPDX-License-Identifier: GPL-3.0-or-later
// Frame-global RCD for recording, subgroup column-walker schedule.
// RawLens, 2026-11-03. Equations and step order: RawTherapee b2ee504c
// rtengine/rcd_demosaic.cc, Copyright (c) 2017-2020 Luis Sanz Rodriguez and
// Ingo Weyrich, via the attributed FP32 port tools/photo-rcd/baseline.comp.
// Canonical 9-pixel border: Gabor Horvath.
// Schedule (new): one 16-lane subgroup owns a 64-pixel column band, 4 pixels
// per lane, and walks down rows. Vertical neighbours live in a rolling FP16
// register history; horizontal neighbours come from adjacent lanes by
// subgroup shuffle. No shared memory and no barriers. Bands overlap by the
// stencil erosion so each written pixel has a complete neighbourhood.
// Pass 0: refined VH, refined PQ, LP planes. Pass 1: green and missing R/B.
// Pass 2: R/B at green and product output. Pass 3: canonical border.
// Generated by generate.py: product code comes from tile_local.py.
#version 450
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_control_flow_attributes : require
// Stage 6 (tiled final) specializes a 16x8 workgroup; every other stage is
// one 16-lane subgroup.
layout(local_size_x=16,local_size_y_id=12) in;
// Border pass uses the same 16-wide groups over a 1D border index.
// RAW16 source words (binding 9); normalized in-shader, so no CFA pass.
layout(binding=9,std430) readonly restrict buffer Source { uvec2 sourcePairs[]; };
layout(binding=1,std430) restrict buffer Planes { uvec2 planes[]; };
layout(push_constant) uniform Params { int width; int height; int phase; int stage; } p;
//@METADATA@
layout(constant_id=9) const int algorithmPass=-1;
const float eps=1e-5, epssq=1e-10;
const int ROWS=128;
// Final pass rows per workgroup: one row per group made launch overhead dominate.
const int FINAL_ROWS=8;
// Planes: 0 VH, 1 PQ, 2 LP, 3 green, 4 missing (FP16, four pixels per uvec2).
int lane,x0,band0;
int color(int x,int y) { return (p.phase >> (2*((y&1)*2+(x&1))))&3; }
bool inside(int x,int y) { return x>=0 && y>=0 && x<p.width && y<p.height; }
bool domain(int x,int y,int m) { return x>=m && y>=m && x<p.width-m && y<p.height-m; }
vec4 U(uvec2 u) { return vec4(unpackHalf2x16(u.x),unpackHalf2x16(u.y)); }
uvec2 P(vec4 v) { return uvec2(packHalf2x16(v.xy),packHalf2x16(v.zw)); }
bool stripInside(int y) { return y>=0 && y<p.height && x0>=0 && x0<p.width; }
// Same normalization as the separate pass: clamp((code-black[quad])/(white-black[quad]),0,1).
// Requires 2-byte pixels, crop left %4==0 and row stride %8==0 (engine-checked)
// so four crop pixels are one aligned 8-byte load.
vec4 normalizeCodes(uvec2 w,int y) {
    vec4 code=vec4(float(w.x&65535u),float(w.x>>16),float(w.y&65535u),float(w.y>>16));
    int sy=y+m.top,sx=x0+m.left;
    vec2 blackRow=(sy&1)==0?m.black.xy:m.black.zw;
    vec4 black=(sx&1)==0?blackRow.xyxy:blackRow.yxyx;
    precise vec4 numerator=code-black;
    precise vec4 denominator=vec4(m.white)-black;
    return clamp(numerator/denominator,0.0,1.0);
}
uvec2 loadRaw(int y) {
    if(!stripInside(y)) return uvec2(0u);
    return P(normalizeCodes(sourcePairs[(uint(y+m.top)*uint(m.rowBytes)+uint(x0+m.left)*2u)>>3u],y));
}
int planeIndex(int plane,int y) { return plane*(p.width*p.height/4)+((y*p.width+x0)>>2); }
uvec2 loadPlane(int plane,int y) { return stripInside(y)?planes[planeIndex(plane,y)]:uvec2(0u); }
// Output sampling: the final pass computes only source pixels the output
// reads (engine bit masks, see writeSampleMask).
layout(binding=10,std430) readonly buffer RawMetadataWords { int metaWords[]; };
// Engine-written bit masks (words 64..): columns, then rows.
bool sampledCol(int c) { return ((uint(metaWords[64+(c>>5)])>>uint(c&31))&1u)!=0u; }
bool sampledRow(int r) { return ((uint(metaWords[64+((p.width+31)>>5)+(r>>5)])>>uint(r&31))&1u)!=0u; }
// Columns [erosion, 64-erosion) of the band are complete.
bool ownsStrip(int erosion) { int c=4*lane;return c>=erosion && c+3<64-erosion; }
#define W(a,b,c,j) ((j)<4?a[(j)&3]:(j)<8?b[(j)&3]:c[(j)&3])
#define AT(n,j) W(n##a,n##b,n##c,j)
// Twelve-pixel window x0-4..x0+7 from this lane and its neighbours. Must be
// executed in subgroup-uniform control flow.
#define WIN(n,u) vec4 n##a=U(subgroupShuffleUp(u,1u)),n##b=U(u),n##c=U(subgroupShuffleDown(u,1u))
float hpf(float m3,float m2,float m1,float c,float p1,float p2,float p3) { return (m3-m1-p1+p3)-3.0*(m2+p2)+6.0*c; }
float refine(float c,float a,float b,float d,float e,bool cardinal) {
    float nb=cardinal?0.25*((a+b)+(d+e)):0.25*(a+b+d+e);
    return abs(0.5-c)<abs(0.5-nb)?nb:c;
}
float rcdInterpolate(float a,float b,float c) { return a*(b-c)+c; }

void guides(int y0) {
    // Lags: raw r; responses q=r-3; unrefined VH/PQ v=r-4; refined/LP z=r-5.
    uvec2 R0=uvec2(0u),R1=R0,R2=R0,R3=R0,R4=R0,R5=R0,R6=R0;
    uvec2 V0=R0,V1=R0,V2=R0,H0=R0,H1=R0,E0=R0,E1=R0,E2=R0,S0=R0,S1=R0,S2=R0;
    uvec2 A0=R0,A1=R0,A2=R0,Q0=R0,Q1=R0,Q2=R0;
    for(int r=y0-7;r<y0+ROWS+5;++r) {
        R0=R1;R1=R2;R2=R3;R3=R4;R4=R5;R5=R6;R6=loadRaw(r);
        int q=r-3;
        {
            WIN(m3,R0);WIN(m2,R1);WIN(m1,R2);WIN(c0,R3);WIN(p1,R4);WIN(p2,R5);WIN(p3,R6);
            vec4 v,h,se,sw;
            for(int i=0;i<4;++i) {
                int x=x0+i,j=i+4;
                bool ok=domain(x,q,3);
                v[i]=ok?hpf(AT(m3,j),AT(m2,j),AT(m1,j),AT(c0,j),AT(p1,j),AT(p2,j),AT(p3,j)):0.0;
                h[i]=ok?hpf(AT(c0,j-3),AT(c0,j-2),AT(c0,j-1),AT(c0,j),AT(c0,j+1),AT(c0,j+2),AT(c0,j+3)):0.0;
                // Upstream convention: diagonal responses on odd columns, shared by pairs.
                const int io=i|1,jo=io+4;
                bool od=domain(x0+io,q,3);
                se[i]=od?hpf(AT(m3,jo-3),AT(m2,jo-2),AT(m1,jo-1),AT(c0,jo),AT(p1,jo+1),AT(p2,jo+2),AT(p3,jo+3)):0.0;
                sw[i]=od?hpf(AT(m3,jo+3),AT(m2,jo+2),AT(m1,jo+1),AT(c0,jo),AT(p1,jo-1),AT(p2,jo-2),AT(p3,jo-3)):0.0;
            }
            V0=V1;V1=V2;V2=P(v);H0=H1;H1=P(h);E0=E1;E1=E2;E2=P(se);S0=S1;S1=S2;S2=P(sw);
        }
        int vrow=r-4;
        {
            vec4 vm=U(V0),vc=U(V1),vp=U(V2);
            WIN(hc,H0);WIN(em,E0);WIN(ec,E1);WIN(ep,E2);WIN(wm,S0);WIN(wc,S1);WIN(wp,S2);
            vec4 vh=vec4(0.0),pq=vec4(0.0);
            for(int i=0;i<4;++i) {
                int x=x0+i,j=i+4;
                if(!domain(x,vrow,4)) continue;
                float va=max(epssq,vm[i]*vm[i]+vc[i]*vc[i]+vp[i]*vp[i]);
                float h0=AT(hc,j-1),h1=AT(hc,j),h2=AT(hc,j+1);
                float vb=max(epssq,h0*h0+h1*h1+h2*h2);
                vh[i]=va/(va+vb);
                if(color(x,vrow)!=1) {
                    float a0=AT(em,j-1),a1=AT(ec,j),a2=AT(ep,j+1);
                    float b0=AT(wm,j+1),b1=AT(wc,j),b2=AT(wp,j-1);
                    float a=max(epssq,a0*a0+a1*a1+a2*a2),b=max(epssq,b0*b0+b1*b1+b2*b2);
                    pq[i]=a/(a+b);
                }
            }
            A0=A1;A1=A2;A2=P(vh);Q0=Q1;Q1=Q2;Q2=P(pq);
        }
        int z=r-5;
        {
            WIN(vu,A0);WIN(vc,A1);WIN(vd,A2);WIN(qu,Q0);WIN(qc,Q1);WIN(qd,Q2);
            WIN(ru,R0);WIN(rc,R1);WIN(rd,R2);
            vec4 vh,pq=vec4(0.0),lp;
            // Light frames read PQ (missing colour) only on sampled rows.
            bool needPq=metaWords[38]==0 || (z>=0 && z<p.height && sampledRow(z));
            for(int i=0;i<4;++i) {
                int x=x0+i,j=i+4;
                vh[i]=refine(AT(vc,j),AT(vu,j-1),AT(vu,j+1),AT(vd,j-1),AT(vd,j+1),true);
                if(needPq) pq[i]=refine(AT(qc,j),AT(qu,j-1),AT(qu,j+1),AT(qd,j-1),AT(qd,j+1),false);
                lp[i]=domain(x,z,2) && color(x,z)!=1
                    ? AT(rc,j)+0.5*(AT(ru,j)+AT(rd,j)+AT(rc,j-1)+AT(rc,j+1))+0.25*(AT(ru,j-1)+AT(ru,j+1)+AT(rd,j-1)+AT(rd,j+1))
                    : 0.0;
            }
            if(z>=y0 && z<y0+ROWS && ownsStrip(8) && stripInside(z)) {
                planes[planeIndex(0,z)]=P(vh);if(needPq) planes[planeIndex(1,z)]=P(pq);planes[planeIndex(2,z)]=P(lp);
            }
        }
    }
}

void greenMissing(int y0) {
    // Lags: raw r; green t=r-4; missing m=r-6.
    uvec2 R0=uvec2(0u),R1=R0,R2=R0,R3=R0,R4=R0,R5=R0,R6=R0,R7=R0,R8=R0,R9=R0;
    uvec2 G0=R0,G1=R0,G2=R0,G3=R0,G4=R0;
    for(int r=y0-10;r<y0+ROWS+6;++r) {
        R0=R1;R1=R2;R2=R3;R3=R4;R4=R5;R5=R6;R6=R7;R7=R8;R8=R9;R9=loadRaw(r);
        int t=r-4;
        {
            vec4 r4m=U(R1),r3m=U(R2),r2m=U(R3),r1m=U(R4),r1p=U(R6),r2p=U(R7),r3p=U(R8),r4p=U(R9);
            WIN(rc,R5);
            uvec2 lpc=loadPlane(2,t);
            WIN(lr,lpc);
            vec4 lN=U(loadPlane(2,t-2)),lS=U(loadPlane(2,t+2)),vh=U(loadPlane(0,t));
            vec4 g;
            for(int i=0;i<4;++i) {
                int x=x0+i,j=i+4;
                float c=AT(rc,j),v=0.0;
                if(inside(x,t)) {
                    if(color(x,t)==1 || !domain(x,t,4)) v=c;
                    else {
                        float ng=eps+(abs(r1p[i]-r1m[i])+abs(c-r2m[i]))+(abs(r1m[i]-r3m[i])+abs(r2m[i]-r4m[i]));
                        float sg=eps+(abs(r1m[i]-r1p[i])+abs(c-r2p[i]))+(abs(r1p[i]-r3p[i])+abs(r2p[i]-r4p[i]));
                        float wg=eps+(abs(AT(rc,j+1)-AT(rc,j-1))+abs(c-AT(rc,j-2)))+(abs(AT(rc,j-1)-AT(rc,j-3))+abs(AT(rc,j-2)-AT(rc,j-4)));
                        float eg=eps+(abs(AT(rc,j-1)-AT(rc,j+1))+abs(c-AT(rc,j+2)))+(abs(AT(rc,j+1)-AT(rc,j+3))+abs(AT(rc,j+2)-AT(rc,j+4)));
                        float l=AT(lr,j),l2=l+l;
                        float ne=r1m[i]*l2/(eps+l+lN[i]),se=r1p[i]*l2/(eps+l+lS[i]);
                        float we=AT(rc,j-1)*l2/(eps+l+AT(lr,j-2)),ee=AT(rc,j+1)*l2/(eps+l+AT(lr,j+2));
                        float ve=(sg*ne+ng*se)/(ng+sg),he=(wg*ee+eg*we)/(eg+wg);
                        v=rcdInterpolate(vh[i],he,ve);
                    }
                }
                g[i]=v;
            }
            G0=G1;G1=G2;G2=G3;G3=G4;G4=P(g);
            if(t>=y0 && t<y0+ROWS && ownsStrip(8) && stripInside(t)) planes[planeIndex(3,t)]=G4;
        }
        int m=r-6;
        // Light final (word 38) reads missing colour only at its own sampled
        // pixel: skip whole unsampled rows (subgroup-uniform branch).
        if(metaWords[38]==0 || (m>=0 && m<p.height && sampledRow(m))) {
            WIN(r3u,R0);WIN(r1u,R2);WIN(rc,R3);WIN(r1d,R4);WIN(r3d,R6);
            WIN(g2u,G0);WIN(g1u,G1);WIN(gc,G2);WIN(g1d,G3);WIN(g2d,G4);
            vec4 pq=U(loadPlane(1,m));
            vec4 out4;
            for(int i=0;i<4;++i) {
                int x=x0+i,j=i+4;
                float v=0.0;
                if(inside(x,m) && color(x,m)!=1) {
                    if(!domain(x,m,4)) v=AT(rc,j);
                    else {
                        float g0=AT(gc,j);
                        float nwg=eps+abs(AT(r1u,j-1)-AT(r1d,j+1))+abs(AT(r1u,j-1)-AT(r3u,j-3))+abs(g0-AT(g2u,j-2));
                        float neg=eps+abs(AT(r1u,j+1)-AT(r1d,j-1))+abs(AT(r1u,j+1)-AT(r3u,j+3))+abs(g0-AT(g2u,j+2));
                        float swg=eps+abs(AT(r1d,j-1)-AT(r1u,j+1))+abs(AT(r1d,j-1)-AT(r3d,j-3))+abs(g0-AT(g2d,j-2));
                        float seg=eps+abs(AT(r1d,j+1)-AT(r1u,j-1))+abs(AT(r1d,j+1)-AT(r3d,j+3))+abs(g0-AT(g2d,j+2));
                        float nwe=AT(r1u,j-1)-AT(g1u,j-1),nee=AT(r1u,j+1)-AT(g1u,j+1),swe=AT(r1d,j-1)-AT(g1d,j-1),see=AT(r1d,j+1)-AT(g1d,j+1);
                        float pe=(nwg*see+seg*nwe)/(nwg+seg),qe=(neg*swe+swg*nee)/(neg+swg);
                        v=g0+rcdInterpolate(pq[i],qe,pe);
                    }
                }
                out4[i]=v;
            }
            if(m>=y0 && m<y0+ROWS && ownsStrip(8) && stripInside(m)) planes[planeIndex(4,m)]=P(out4);
        }
    }
}

//@PRODUCT@

// Walker product path: same equations and operation order as productPixel
// above, with dispatch-uniform configuration read once per invocation and
// gain-map corners fetched as vec4 and shared by a lane's four pixels when
// they fall in one map cell (Mali is load-instruction bound).
layout(binding=7,std430) readonly buffer ProductConfigVec { uvec4 config4[]; };
vec3 pWb; float pMin; bool pLsc; int pScale,pCols,pRows; float pOffX,pDenX,pOffY,pDenY;
void productSetup() {
    pWb=vec3(parameter(2),parameter(3),parameter(4));pMin=min(pWb.r,min(pWb.g,pWb.b));
    pLsc=config[11]!=0u;pScale=max(1,m.reserved2);pCols=int(config[6]);pRows=int(config[5]);
    pOffX=float(int(config[0])-int(config[7]));pDenX=float(int(config[9])-int(config[7]));
    pOffY=float(int(config[1])-int(config[8]));pDenY=float(int(config[10])-int(config[8]));
}
precise float lscX(int x) { return clamp((float(x)*float(pScale)+0.5*float(pScale-1)+pOffX)/pDenX,0.0,1.0)*float(pCols-1); }
precise float lscY(int y) { return clamp((float(y)*float(pScale)+0.5*float(pScale-1)+pOffY)/pDenY,0.0,1.0)*float(pRows-1); }
vec4 mapCorner(int x,int y) { return uintBitsToFloat(config4[4+y*pCols+x]); }
// Per-row LSC gains for this lane's four pixels. One bilinear evaluation at
// the lane's first pixel (same equations as productPixel) plus the cell's
// exact x-derivative from the same four corners: within a map cell the
// bilinear map is linear in x, so this is exact up to rounding; a lane
// straddling a cell boundary extrapolates up to three pixels across a
// continuous piecewise-linear kink. Multiple evaluations per lane exceed
// Mali's register budget in this pass. Gains are kept as packed FP16.
uvec2 lscR,lscG,lscB;
void productRow(int x0,int y) {
    if(!pLsc) return;
    precise float ny=lscY(y);int gy=int(ny),gy1=min(gy+1,pRows-1);
    precise float nx=lscX(x0);int gx=int(nx),gx1=min(gx+1,pCols-1);
    vec4 c00=mapCorner(gx,gy),c10=mapCorner(gx1,gy),c01=mapCorner(gx,gy1),c11=mapCorner(gx1,gy1);
    precise vec4 ga=c00+(c10-c00)*(nx-float(gx));
    precise vec4 gb=c01+(c11-c01)*(nx-float(gx));
    precise vec4 g0=ga+(gb-ga)*(ny-float(gy));
    // d(nx)/dx is zero where the map coordinate is clamped.
    float unclamped=(float(x0)*float(pScale)+0.5*float(pScale-1)+pOffX)/pDenX;
    float dnx=(unclamped>0.0 && unclamped<1.0)?float(pScale)/pDenX*float(pCols-1):0.0;
    vec4 slope=((c10-c00)+((c11-c01)-(c10-c00))*(ny-float(gy)))*dnx;
    vec4 k=vec4(0.0,1.0,2.0,3.0);
    lscR=P(g0.x+slope.x*k);lscG=P(0.5*((g0.y+slope.y*k)+(g0.z+slope.z*k)));lscB=P(g0.w+slope.w*k);
}
bool productBad=false;
vec3 productFastRgb(ivec2 site,vec3 sourceRgb,int lane4) {
    precise vec3 rgb=sourceRgb;
    precise vec3 t=clamp((rgb-vec3(0.70))/vec3(0.99-0.70),0.0,1.0);
    precise vec3 white=t*t*(vec3(3.0)-2.0*t);
    precise float blend=max(white.r,max(white.g,white.b));
    rgb=rgb+(vec3(pMin)/pWb-rgb)*blend;
    if(pLsc) {
        rgb*=vec3(U(lscR)[lane4],U(lscG)[lane4],U(lscB)[lane4]);
    }
    // Out-of-domain status is merged per subgroup by the caller.
    productBad=productBad || any(isnan(rgb)) || any(isinf(rgb)) || any(lessThan(rgb,vec3(0.0))) || any(greaterThan(rgb,vec3(65504.0)));
    return rgb;
}
void productFast(ivec2 site,vec3 sourceRgb,int lane4) {
    vec3 rgb=productFastRgb(site,sourceRgb,lane4);
    //@STORE@
}
// Same product equations per pixel (border pass, fused mode): exact
// bilinear LSC evaluation, as productPixel.
vec3 productExact(ivec2 site,vec3 sourceRgb) {
    precise vec3 rgb=sourceRgb;
    precise vec3 t=clamp((rgb-vec3(0.70))/vec3(0.99-0.70),0.0,1.0);
    precise vec3 white=t*t*(vec3(3.0)-2.0*t);
    precise float blend=max(white.r,max(white.g,white.b));
    rgb=rgb+(vec3(pMin)/pWb-rgb)*blend;
    if(pLsc) {
        precise float ny=lscY(site.y);int gy=int(ny),gy1=min(gy+1,pRows-1);
        precise float nx=lscX(site.x);int gx=int(nx),gx1=min(gx+1,pCols-1);
        precise vec4 a=mapCorner(gx,gy)+(mapCorner(gx1,gy)-mapCorner(gx,gy))*(nx-float(gx));
        precise vec4 b=mapCorner(gx,gy1)+(mapCorner(gx1,gy1)-mapCorner(gx,gy1))*(nx-float(gx));
        precise vec4 gains=a+(b-a)*(ny-float(gy));
        rgb*=vec3(gains.x,0.5*(gains.y+gains.z),gains.w);
    }
    if(any(isnan(rgb)) || any(isinf(rgb)) || any(lessThan(rgb,vec3(0.0))) || any(greaterThan(rgb,vec3(65504.0)))) atomicOr(config[12],1u);
    return rgb;
}

// ---- Fused grade (stage 4): same equations as shaders/vf/vf_gradeyuv.comp
// (direct profile encode, no record cube LUT), written straight to P010.
// Metadata words: 18 fused flag, 19 outMode, 20 bypass, 21 yStride (u16),
// 22 uvStride (u16), 23 uvBase (bytes), 24..35 folded CCM rows (vec4 x3),
// 36/37 output W/H.
layout(binding=11,std430) writeonly restrict buffer P010Out { uint p010[]; };
float metaF(int i) { return intBitsToFloat(metaWords[i]); }
vec3 bt709Encode(vec3 v) {
    v=clamp(v,0.0,1.0);vec3 lo=4.5*v;vec3 hi=1.099*pow(v,vec3(0.45))-0.099;
    return mix(hi,lo,vec3(lessThan(v,vec3(0.018))));
}
float hlgOetf(float e) {
    e=clamp(e,0.0,1.0);if(e<=1.0/12.0) return sqrt(3.0*e);
    return clamp(0.17883277*log(12.0*e-0.28466892)+0.55991073,0.0,1.0);
}
vec3 srgbToBt2020(vec3 v) {
    return vec3(dot(v,vec3(0.6274040,0.3292820,0.0433136)),dot(v,vec3(0.0690970,0.9195400,0.0113612)),dot(v,vec3(0.0163916,0.0880132,0.8955950)));
}
vec3 srgbToSgamut3Cine(vec3 v) {
    return vec3(dot(v,vec3(0.6456794776,0.2591145470,0.0952059754)),dot(v,vec3(0.0875299915,0.7596995626,0.1527704459)),dot(v,vec3(0.0369574199,0.1292809048,0.8337616753)));
}
float slog3cutY() { return (420.0+log2((0.01125+0.01)/0.19)*0.30102999566*261.5)/1023.0; }
float sonySlog3(float x) {
    if(x>=0.01125) return (420.0+log2((x+0.01)/0.19)*0.30102999566*261.5)/1023.0;
    return (95.0+x*(slog3cutY()*1023.0-95.0)/0.01125)/1023.0;
}
vec3 acesFitted(vec3 v) {
    v=vec3(dot(v,vec3(0.59719,0.35458,0.04823)),dot(v,vec3(0.07600,0.90834,0.01566)),dot(v,vec3(0.02840,0.13383,0.83777)));
    v=(v*(v+0.0245786)-0.000090537)/(v*(0.983729*v+0.4329510)+0.238081);
    return clamp(vec3(dot(v,vec3(1.60475,-0.53108,-0.07367)),dot(v,vec3(-0.10208,1.10813,-0.00605)),dot(v,vec3(-0.00327,-0.07276,1.07602))),0.0,1.0);
}
vec3 rgbToYuv(vec3 rgb,int mode) {
    if(mode==2) {
        float y=0.2627*rgb.r+0.6780*rgb.g+0.0593*rgb.b;
        return vec3(y,(rgb.b-y)/1.8814+0.5,(rgb.r-y)/1.4746+0.5);
    }
    float y=0.2126*rgb.r+0.7152*rgb.g+0.0722*rgb.b;
    return vec3(y,(rgb.b-y)/(2.0*(1.0-0.0722))+0.5,(rgb.r-y)/(2.0*(1.0-0.2126))+0.5);
}
vec3 gradeYuvOf(vec3 rgb) {
    int mode=metaWords[19];
    vec3 lg;
    if(metaWords[20]!=0) lg=rgb;
    else {
        vec3 developed=vec3(dot(vec3(metaF(24),metaF(25),metaF(26)),rgb),dot(vec3(metaF(28),metaF(29),metaF(30)),rgb),dot(vec3(metaF(32),metaF(33),metaF(34)),rgb));
        if(mode==3) lg=pow(acesFitted(developed),vec3(1.0/2.4));
        else if(mode==1) { vec3 v=srgbToSgamut3Cine(developed);lg=vec3(sonySlog3(v.r),sonySlog3(v.g),sonySlog3(v.b)); }
        else if(mode==2) { vec3 v=srgbToBt2020(developed);lg=vec3(hlgOetf(v.r),hlgOetf(v.g),hlgOetf(v.b)); }
        else lg=bt709Encode(developed);
    }
    return rgbToYuv(lg,mode);
}
uint pack10(float v,float low,float high) { uint code=uint(round(clamp(v,0.0,1.0)*(high-low)+low));return (code<<6)&0xFFC0u; }
// Exact integer form of gradeYuv's int((o+0.5)*src/out).
int srcOf(int o,int outN,int srcN) { return ((2*o+1)*srcN)/(2*outN); }
bool colNeeded(int c,int outN,int srcN) {
    int num=2*outN*c-srcN,o=num<=0?0:(num+2*srcN-1)/(2*srcN);
    return o<outN && srcOf(o,outN,srcN)==c;
}
int borderIndex(int x,int y) {
    int w=p.width,h=p.height,rows=h-18;
    if(y<9) return y*w+x;
    if(y>=h-9) return (y-(h-18))*w+x;
    return 18*w+(x<9?0:9*rows)+(y-9)*9+(x<9?x:x-(w-9));
}
int borderBase() { return 5*(p.width*p.height/4); }
vec3 borderRgb(int x,int y) { uvec2 v=planes[borderBase()+borderIndex(x,y)];return vec3(unpackHalf2x16(v.x),unpackHalf2x16(v.y).x); }
vec4 oY,oU,oV;
// Fused mode: output column of each lane pixel (-1 = unsampled), computed
// once per invocation (integer division is slow on Mali).
ivec4 laneOut;

// Stage 6: the final step as a shared-memory tile (standard GPU stencil
// staging). A 16x8 workgroup owns 64x8 pixels; normalized raw, green and
// missing colour for the tile plus a 3-row / 4-pixel halo are fetched from
// global memory once, then every neighbour read hits shared memory. The
// per-pixel RCD arithmetic is finalRow's, unchanged.
const int TROWS=8,TGROUPS=16,SROWS=TROWS+6,SGROUPS=TGROUPS+2;
// Raw and missing colour share one 16-byte slot: one shared read serves both.
shared uvec4 sRM[SROWS][SGROUPS];
shared uvec2 sGrn[SROWS][SGROUPS];
void tiledFinal() {
    const int W=p.width,H=p.height,n4=W*H/4;
    int g0=int(gl_WorkGroupID.x)*TGROUPS-1,ty0=int(gl_WorkGroupID.y)*TROWS-3;
    int t=int(gl_LocalInvocationIndex);
    for(int k=t;k<SROWS*SGROUPS;k+=TGROUPS*TROWS) {
        int r=k/SGROUPS,c=k-r*SGROUPS,y=ty0+r,gx=(g0+c)*4;
        bool ok=y>=0 && y<H && gx>=0 && gx<W;
        uvec2 raw=uvec2(0u),mis=uvec2(0u),grn=uvec2(0u);
        if(ok) {
            x0=gx;
            raw=P(normalizeCodes(sourcePairs[(uint(y+m.top)*uint(m.rowBytes)+uint(gx+m.left)*2u)>>3u],y));
            int idx=(y*W+gx)>>2;
            mis=planes[4*n4+idx];grn=planes[3*n4+idx];
        }
        sRM[r][c]=uvec4(raw,mis);sGrn[r][c]=grn;
    }
    barrier();
    int lx=int(gl_LocalInvocationID.x),ly=int(gl_LocalInvocationID.y);
    int f=ty0+3+ly,cc=lx+1,rr=ly+3;
    x0=(g0+cc)*4;
    // Shuffles first: every lane of the row must take part.
    uvec4 qc=sRM[rr][cc];uvec2 gc0=sGrn[rr][cc];
    // Horizontal neighbours: shuffles within the 16-lane row; the two edge
    // lanes read their halo group from shared memory.
    uvec4 qa=subgroupShuffleUp(qc,1u),qz=subgroupShuffleDown(qc,1u);
    uvec2 ga=subgroupShuffleUp(gc0,1u),gz=subgroupShuffleDown(gc0,1u);
    if(lx==0) { qa=sRM[rr][0];ga=sGrn[rr][0]; }
    if(lx==TGROUPS-1) { qz=sRM[rr][SGROUPS-1];gz=sGrn[rr][SGROUPS-1]; }
    if(f>=H || x0>=W || (metaWords[16]==0 && !sampledRow(f))) return;
    uvec4 q3u=sRM[rr-3][cc],q1u=sRM[rr-1][cc],q1d=sRM[rr+1][cc],q3d=sRM[rr+3][cc];
    precision mediump float;
    productSetup();
    vec4 r3u=U(q3u.xy),r1u=U(q1u.xy),r1d=U(q1d.xy),r3d=U(q3d.xy);
    vec4 m3u=U(q3u.zw),m1u=U(q1u.zw),m1d=U(q1d.zw),m3d=U(q3d.zw);
    vec4 g2u=U(sGrn[rr-2][cc]),g1u=U(sGrn[rr-1][cc]),g1d=U(sGrn[rr+1][cc]),g2d=U(sGrn[rr+2][cc]);
    vec4 rca=U(qa.xy),rcb=U(qc.xy),rcc=U(qz.xy);
    vec4 mca=U(qa.zw),mcb=U(qc.zw),mcc=U(qz.zw);
    vec4 gca=U(ga),gcb=U(gc0),gcc=U(gz);
    vec4 vh=U(planes[(f*W+x0)>>2]);
    productRow(x0,f);
    uint colBits=metaWords[17]!=0?15u:uint(metaWords[64+(x0>>5)])>>uint(x0&31);
        for(int i=0;i<4;++i) {
            int x=x0+i,j=i+4;
            if(x>=p.width || ((colBits>>uint(i))&1u)==0u) continue;
            int c=color(x,f);
            vec3 result;
            // Canonical border pixels come from the border pass.
            if(!domain(x,f,9)) continue;
            else if(c!=1) {
                float mm=AT(mc,j);
                result=c==0?vec3(AT(rc,j),AT(gc,j),mm):vec3(mm,AT(gc,j),AT(rc,j));
            } else {
                float g0=AT(gc,j);
                result=vec3(0.0,g0,0.0);
                for(int kk=0;kk<=2;kk+=2) {
                    bool vk=color(x,f-1)==kk,hk=color(x-1,f)==kk;
                    float n1=vk?r1u[i]:m1u[i],n3=vk?r3u[i]:m3u[i],s1=vk?r1d[i]:m1d[i],s3=vk?r3d[i]:m3d[i];
                    float w1=hk?AT(rc,j-1):AT(mc,j-1),w3=hk?AT(rc,j-3):AT(mc,j-3),e1=hk?AT(rc,j+1):AT(mc,j+1),e3=hk?AT(rc,j+3):AT(mc,j+3);
                    float ng=(eps+abs(g0-g2u[i]))+abs(s1-n1)+abs(n1-n3);
                    float sg=(eps+abs(g0-g2d[i]))+abs(n1-s1)+abs(s1-s3);
                    float wg=(eps+abs(g0-AT(gc,j-2)))+abs(e1-w1)+abs(w1-w3);
                    float eg=(eps+abs(g0-AT(gc,j+2)))+abs(w1-e1)+abs(e1-e3);
                    float ne=n1-g1u[i],se=s1-g1d[i],we=w1-AT(gc,j-1),ee=e1-AT(gc,j+1);
                    float ve=(ng*se+sg*ne)/(ng+sg),he=(eg*we+wg*ee)/(eg+wg);
                    result[kk]=g0+rcdInterpolate(vh[i],he,ve);
                }
            }
            productFast(ivec2(x,f),max(vec3(0.0),result),i);
        }
    if(productBad) atomicOr(config[12],1u);
}

void finalRow(int f,bool fused) {
    if(!fused && (f>=p.height || (metaWords[16]==0 && !sampledRow(f)))) return;
    // FP16 arithmetic (RelaxedPrecision) for the final colour step: -3.5 ms
    // at 4K on Mali-G615; 68.5 dB vs exact engine with LSC (max 3.9e-3).
    precision mediump float;
    // One subgroup per output row: no register history (keeps the final
    // pass, which also carries the product step, below Mali's register cliff).
    productSetup();
    {
        vec4 r3u=U(loadRaw(f-3)),r1u=U(loadRaw(f-1)),r1d=U(loadRaw(f+1)),r3d=U(loadRaw(f+3));
        vec4 m3u=U(loadPlane(4,f-3)),m1u=U(loadPlane(4,f-1)),m1d=U(loadPlane(4,f+1)),m3d=U(loadPlane(4,f+3));
        vec4 g2u=U(loadPlane(3,f-2)),g1u=U(loadPlane(3,f-1)),g1d=U(loadPlane(3,f+1)),g2d=U(loadPlane(3,f+2));
        uvec2 R3=loadRaw(f),M3=loadPlane(4,f),G2=loadPlane(3,f);
        WIN(rc,R3);WIN(mc,M3);WIN(gc,G2);
        if(!ownsStrip(4) || !stripInside(f)) return;
        vec4 vh=U(loadPlane(0,f));
        productRow(x0,f);
        // x0%4==0: the lane's four column bits share one mask word.
        uint colBits=metaWords[17]!=0?15u:x0>=0 && x0<p.width?uint(metaWords[64+(x0>>5)])>>uint(x0&31):0u;
        for(int i=0;i<4;++i) {
            int x=x0+i,j=i+4;
            if(x>=p.width || (fused?laneOut[i]<0:((colBits>>uint(i))&1u)==0u)) continue;
            int c=color(x,f);
            vec3 result;
            // Canonical border pixels come from the border pass (written
            // there in half mode; read back as product RGB in fused mode).
            if(!domain(x,f,9)) {
                if(!fused) continue;
                vec3 rgbB=borderRgb(x,f);oY[i]=rgbB.x;oU[i]=rgbB.y;oV[i]=rgbB.z;
                continue;
            } else if(c!=1) {
                float mm=AT(mc,j);
                result=c==0?vec3(AT(rc,j),AT(gc,j),mm):vec3(mm,AT(gc,j),AT(rc,j));
            } else {
                float g0=AT(gc,j);
                result=vec3(0.0,g0,0.0);
                for(int kk=0;kk<=2;kk+=2) {
                    bool vk=color(x,f-1)==kk,hk=color(x-1,f)==kk;
                    float n1=vk?r1u[i]:m1u[i],n3=vk?r3u[i]:m3u[i],s1=vk?r1d[i]:m1d[i],s3=vk?r3d[i]:m3d[i];
                    float w1=hk?AT(rc,j-1):AT(mc,j-1),w3=hk?AT(rc,j-3):AT(mc,j-3),e1=hk?AT(rc,j+1):AT(mc,j+1),e3=hk?AT(rc,j+3):AT(mc,j+3);
                    float ng=(eps+abs(g0-g2u[i]))+abs(s1-n1)+abs(n1-n3);
                    float sg=(eps+abs(g0-g2d[i]))+abs(n1-s1)+abs(s1-s3);
                    float wg=(eps+abs(g0-AT(gc,j-2)))+abs(e1-w1)+abs(w1-w3);
                    float eg=(eps+abs(g0-AT(gc,j+2)))+abs(w1-e1)+abs(e1-e3);
                    float ne=n1-g1u[i],se=s1-g1d[i],we=w1-AT(gc,j-1),ee=e1-AT(gc,j+1);
                    float ve=(ng*se+sg*ne)/(ng+sg),he=(eg*we+wg*ee)/(eg+wg);
                    result[kk]=g0+rcdInterpolate(vh[i],he,ve);
                }
            }
            if(fused) {
                // Product RGB here; graded after the lane loop (one copy).
                vec3 rgbP=productFastRgb(ivec2(x,f),max(vec3(0.0),result),i);
                oY[i]=rgbP.x;oU[i]=rgbP.y;oV[i]=rgbP.z;
            } else productFast(ivec2(x,f),max(vec3(0.0),result),i);
        }
        if(subgroupAny(productBad) && subgroupElect()) atomicOr(config[12],1u);
    }
}


float rawAt(int x,int y) {
    uint a=uint(y+m.top)*uint(m.rowBytes)+uint(x+m.left)*2u;
    uvec2 w=sourcePairs[a>>3u];uint word=((a>>2u)&1u)==0u?w.x:w.y;
    float code=float(((a&2u)==0u)?(word&65535u):(word>>16));
    int quad=((y+m.top)&1)*2+((x+m.left)&1);
    precise float numerator=code-m.black[quad];
    precise float denominator=m.white-m.black[quad];
    return clamp(numerator/denominator,0.0,1.0);
}
// Canonical border (Gabor Horvath): 3x3 same-colour average, own colour kept.
void borderPass() {
    int k=int(gl_GlobalInvocationID.x),w=p.width,h=p.height,band=9*w;
    int x,y;
    if(k<2*band) { y=k/w;x=k%w;if(y>=9) y=h-18+y; }
    else { int t=k-2*band,rows=h-18;if(t>=18*rows) return;int side=t/(9*rows);t%=9*rows;y=9+t/9;x=side==0?t%9:w-9+t%9; }
    vec3 total=vec3(0.0);vec3 count=vec3(0.0);
    for(int dy=-1;dy<=1;++dy) for(int dx=-1;dx<=1;++dx) {
        int nx=x+dx,ny=y+dy;
        if(!inside(nx,ny)) continue;
        vec3 sel=vec3(equal(ivec3(color(nx,ny)),ivec3(0,1,2)));
        total+=rawAt(nx,ny)*sel;count+=sel;
    }
    vec3 result=mix(total/max(count,vec3(1.0)),vec3(rawAt(x,y)),vec3(equal(ivec3(color(x,y)),ivec3(0,1,2))));
    if(metaWords[18]!=0) {
        productSetup();
        vec3 rgb=productExact(ivec2(x,y),max(vec3(0.0),result));
        planes[borderBase()+borderIndex(x,y)]=uvec2(packHalf2x16(rgb.rg),packHalf2x16(vec2(rgb.b,0.0)));
    } else productPixel(ivec2(x,y),max(vec3(0.0),result));
}

#ifndef IMAGE_OUTPUT
// P010 frames, stage 4: the final pass for sampled source rows only. Product
// RGB of sampled columns goes to an output-resolution FP16 buffer. Grading
// here as well crossed Mali's register cliff (2-4x slower), so it is stage 5.
int outIndex(int c,int outN,int srcN) {
    int num=2*outN*c-srcN,o=num<=0?0:(num+2*srcN-1)/(2*srcN);
    return o<outN && srcOf(o,outN,srcN)==c?o:-1;
}
void sampledFinal() {
    int outW=metaWords[36],outH=metaWords[37],W=p.width,H=p.height;
    for(int i=0;i<4;++i) laneOut[i]=x0+i<W?outIndex(x0+i,outW,W):-1;
    for(int k=0;k<FINAL_ROWS;++k) {
        int oy=int(gl_WorkGroupID.y)*FINAL_ROWS+k;
        if(oy>=outH) return;
        int f=srcOf(oy,outH,H);
        oY=vec4(0.0);oU=oY;oV=oY;
        finalRow(f,true);
        if(!ownsStrip(4) || !stripInside(f)) continue;
        for(int i=0;i<4;++i) {
            int o=laneOut[i];
            if(o>=0) halfOutput[oy*outW+o]=uvec2(packHalf2x16(vec2(oY[i],oU[i])),packHalf2x16(vec2(oV[i],1.0)));
        }
    }
}
// Stage 5: one invocation per 2x2 P010 cell (vf_gradeyuv layout and maths).
float planeAt(int plane,int x,int y) {
    uvec2 v=planes[plane*(p.width*p.height/4)+((y*p.width+x)>>2)];
    vec2 h=unpackHalf2x16((x&2)!=0?v.y:v.x);
    return (x&1)!=0?h.y:h.x;
}
// Light frames (word 38): RCD's final step at a red/blue site is the raw
// value plus that pixel's green and missing colour, so stage 5 assembles it
// directly (stage 2 is skipped). Canonical border pixels come from the
// border pass output.
vec3 lightRgb(int x,int y) {
    if(!domain(x,y,9)) { uvec2 v=halfOutput[y*p.width+x];return vec3(unpackHalf2x16(v.x),unpackHalf2x16(v.y).x); }
    float r=rawAt(x,y),g=planeAt(3,x,y),mm=planeAt(4,x,y);
    vec3 result=color(x,y)==0?vec3(r,g,mm):vec3(mm,g,r);
    return productExact(ivec2(x,y),max(vec3(0.0),result));
}
// Two light pixels of one source row in the same 4-pixel word: one raw,
// green and missing load serve both, and one LSC corner fetch (when both sit
// in the same map cell). Same equations as lightRgb/productExact.
void lightPair(int xa,int xb,int y,out vec3 ra,out vec3 rb) {
    if((xa>>2)!=(xb>>2) || !domain(xa,y,9) || !domain(xb,y,9)) { ra=lightRgb(xa,y);rb=lightRgb(xb,y);return; }
    x0=xa&~3;
    vec4 raw=normalizeCodes(sourcePairs[(uint(y+m.top)*uint(m.rowBytes)+uint(x0+m.left)*2u)>>3u],y);
    int idx=(y*p.width+x0)>>2;
    vec4 gr=U(planes[3*(p.width*p.height/4)+idx]),mi=U(planes[4*(p.width*p.height/4)+idx]);
    int ia=xa&3,ib=xb&3;
    vec3 sa=color(xa,y)==0?vec3(raw[ia],gr[ia],mi[ia]):vec3(mi[ia],gr[ia],raw[ia]);
    vec3 sb=color(xb,y)==0?vec3(raw[ib],gr[ib],mi[ib]):vec3(mi[ib],gr[ib],raw[ib]);
    ra=productExact(ivec2(xa,y),max(vec3(0.0),sa));
    rb=productExact(ivec2(xb,y),max(vec3(0.0),sb));
}
vec3 sampledRgb(int ox,int oy) {
    if(metaWords[38]!=0) return lightRgb(srcOf(ox,metaWords[36],p.width)+metaWords[39],srcOf(oy,metaWords[37],p.height)+metaWords[40]);
    uvec2 v=halfOutput[(srcOf(oy,metaWords[37],p.height)+metaWords[40])*p.width+srcOf(ox,metaWords[36],p.width)+metaWords[39]];return vec3(unpackHalf2x16(v.x),unpackHalf2x16(v.y).x); }
void gradePass() {
    int outW=metaWords[36],outH=metaWords[37];
    int kc=int(gl_GlobalInvocationID.x),j=int(gl_WorkGroupID.y),o0=2*kc;
    if(o0>=outW || 2*j>=outH) return;
    if(metaWords[38]!=0) productSetup();
    vec3 a0,a1,b0,b1;
    if(metaWords[38]!=0) {
        int xa=srcOf(o0,outW,p.width)+metaWords[39],xb=srcOf(o0+1,outW,p.width)+metaWords[39];
        lightPair(xa,xb,srcOf(2*j,outH,p.height)+metaWords[40],a0,a1);
        lightPair(xa,xb,srcOf(2*j+1,outH,p.height)+metaWords[40],b0,b1);
        a0=gradeYuvOf(a0);a1=gradeYuvOf(a1);b0=gradeYuvOf(b0);b1=gradeYuvOf(b1);
    } else {
        a0=gradeYuvOf(sampledRgb(o0,2*j));a1=gradeYuvOf(sampledRgb(o0+1,2*j));
        b0=gradeYuvOf(sampledRgb(o0,2*j+1));b1=gradeYuvOf(sampledRgb(o0+1,2*j+1));
    }
    int yStride=metaWords[21];
    uint yIdx=uint(2*j)*uint(yStride)+uint(o0);
    p010[yIdx>>1u]=pack10(a0.x,64.0,940.0)|(pack10(a1.x,64.0,940.0)<<16u);
    p010[(yIdx+uint(yStride))>>1u]=pack10(b0.x,64.0,940.0)|(pack10(b1.x,64.0,940.0)<<16u);
    vec3 mean=((a0+a1)+(b0+b1))*0.25;
    uint pairIdx=uint(metaWords[23])/2u+uint(j)*uint(metaWords[22])+uint(o0);
    p010[pairIdx>>1u]=pack10(mean.g,64.0,960.0)|(pack10(mean.b,64.0,960.0)<<16u);
}
#endif

void main() {
    int stage=algorithmPass<0?p.stage:algorithmPass;
    if(stage==6) { if(metaWords[38]==0) tiledFinal();return; }
    if(stage==3) { borderPass();return; }
#ifndef IMAGE_OUTPUT
    if(stage==5) { gradePass();return; }
#endif
    lane=int(gl_SubgroupInvocationID);
    int erosion=stage==2||stage==4?4:8,stride=64-2*erosion;
    band0=int(gl_WorkGroupID.x)*stride-erosion;
    x0=band0+4*lane;
    int y0=int(gl_WorkGroupID.y)*ROWS;
    if(stage==0) guides(y0); else if(stage==1) greenMissing(y0); else if(stage==2) { if(metaWords[38]!=0) return; else for(int k=0;k<FINAL_ROWS;++k) finalRow(int(gl_WorkGroupID.y)*FINAL_ROWS+k,false); }
#ifndef IMAGE_OUTPUT
    else if(stage==4) sampledFinal();
#endif
}
