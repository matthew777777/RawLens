#version 450
#extension GL_EXT_control_flow_attributes : require
// PhotonCamera KernelNet (eszdman/PhotonCamera @ b2eff82,
// assets/models/kernelnet_aniso_v2_2_params.ncnn.{param,bin}) evaluated
// in-engine, plus its conversion to Wronski merge covariances.
//
// Graph (ncnn .param): cat(in0 luma, in1 sigma) -> conv3x3 s2 16 relu ->
// 4 x conv3x3 16 relu -> conv1x1 3 -> (2 sig, 2 sig, 2 sig - 1) = (s1, s2,
// rho). ncnn Convolution: weights [out][in][ky][kx], zero padding (pad 1 on
// the 3x3 layers), bias added before the activation. The sigma input is a
// constant plane, so it is zero-padded like any other channel.
//
// p.mode selects the op (one dispatch per op, grid-stride over p.pixelCount):
//   0 PREP  luma[y][x] = sqrt(clamp(mean(2x2 raw quad), 0, 1))
//           (PhotonCamera upscalecrop/singleluma.glsl; black 0, white 1)
//   1 CONV  out = act(conv(in)); pad[] carries the layer shape
//   2 HEAD  conv1x1 16->3 then (2 sigmoid, 2 sigmoid, 2 sigmoid - 1),
//           stored through fp16 like the app's RGBA16F parameter map
//   3 COV   Omega on the merge's grey grid from the parameter map (see below)
//
// Buffers: 0 = A (input), 1 = B (output), 2 = W (all weights+biases, fp32).
layout(local_size_x = 256) in;

struct HmsrPush {
  uint width; uint height; uint pixelCount; uint tileCount;
  uint level; uint tileSize; float scale;
  float alpha; float beta; float robustness; uint mode;
  uint pad[21];
};
layout(push_constant) uniform Push { HmsrPush p; };

layout(set = 0, binding = 0) readonly buffer A { float a_[]; };
layout(set = 0, binding = 1) buffer B { float b_[]; };
layout(set = 0, binding = 2) readonly buffer W { float w_[]; };

// pad layout per mode:
// The merge input is flipped to RGGB phase (DngRead.flipToRggb); the net
// must see SENSOR orientation like PhotonCamera (a CNN is not flip-
// invariant), so PREP reads quads through the flip and COV maps positions
// back, negating rho when exactly one axis is flipped.
// PREP: [0]=rawW [1]=rawH [2]=lumaW [3]=lumaH [4]=flipX [5]=flipY
// CONV/HEAD: [0]=cin [1]=cout [2]=inW [3]=inH [4]=outW [5]=outH [6]=stride
//            [7]=ksize [8]=relu [9]=wOff [10]=bOff [11]=layer0 (sigma plane)
//            sigma rides p.alpha
// COV: [0]=mapW [1]=mapH [2]=rawW [3]=rawH [4]=cropX [5]=cropY [6]=covW
//      [7]=covH [8]=flipX [9]=flipY ; p.alpha = sigmaScale, p.beta = sigmaCap

float inputAt(uint c, int x, int y, uint inW, uint inH, bool layer0, float sigma) {
  if (x < 0 || y < 0 || x >= int(inW) || y >= int(inH)) return 0.0;  // zero pad
  if (layer0 && c == 1u) return sigma;                                // in1 plane
  return a_[c * inW * inH + uint(y) * inW + uint(x)];
}

float sigmoid(float v) { return 1.0 / (1.0 + exp(-v)); }
float roundToFp16(float v) { return unpackHalf2x16(packHalf2x16(vec2(v, 0.0))).x; }

// CONV/HEAD weights of the current layer as vec4 over output channels:
// sw4[(ic*k*k + ky*k + kx)*4 + q] = w[oc = 4q..4q+3][ic][ky][kx] (zero for
// oc >= cout), biases in sb4[q]. One broadcast vec4 load feeds 4 FMAs
// (Mali: shared loads go through the load/store unit, the old bottleneck).
shared vec4 sw4[16 * 9 * 4];
shared vec4 sb4[4];

void main() {
  uint stride = gl_NumWorkGroups.x * 256u;
  if (p.mode == 1u || p.mode == 2u) {
    // Mobile path: pixel-major conv. One invocation per OUTPUT PIXEL computes
    // all cout channels (each input tap read once, not cout times) from
    // weights staged in shared memory. Per channel the accumulation order is
    // unchanged (bias, then ic, ky, kx), so values match the old
    // channel-major dispatch.
    uint cin = p.pad[0], cout = p.pad[1], kk = p.pad[7] * p.pad[7];
    for (uint i = gl_LocalInvocationID.x; i < cin * kk * 4u; i += 256u) {
      uint tap = i / 4u, q = i % 4u;   // tap = ic*kk + ky*k + kx
      vec4 v = vec4(0.0);
      for (uint j = 0u; j < 4u; j++) {
        uint oc = 4u * q + j;
        if (oc < cout) v[j] = w_[p.pad[9] + oc * cin * kk + tap];
      }
      sw4[i] = v;
    }
    if (gl_LocalInvocationID.x < 4u) {
      vec4 b = vec4(0.0);
      for (uint j = 0u; j < 4u; j++) {
        uint oc = 4u * gl_LocalInvocationID.x + j;
        if (oc < cout) b[j] = w_[p.pad[10] + oc];
      }
      sb4[gl_LocalInvocationID.x] = b;
    }
    barrier();
  }
  for (uint id = gl_GlobalInvocationID.x; id < p.pixelCount; id += stride) {
    if (p.mode == 0u) {
      uint rawW = p.pad[0], lumaW = p.pad[2], lumaH = p.pad[3];
      uint ly = id / lumaW, lx = id % lumaW;          // sensor-orientation quad
      uint qx = (p.pad[4] != 0u) ? lumaW - 1u - lx : lx;  // pipeline quad
      uint qy = (p.pad[5] != 0u) ? lumaH - 1u - ly : ly;
      uint b = (2u * qy) * rawW + 2u * qx;
      float m = 0.25 * (a_[b] + a_[b + 1u] + a_[b + rawW] + a_[b + rawW + 1u]);
      b_[id] = sqrt(clamp(m, 0.0, 1.0));
    } else if (p.mode == 1u || p.mode == 2u) {
      uint cin = p.pad[0], inW = p.pad[2], inH = p.pad[3];
      uint outW = p.pad[4], outH = p.pad[5], st = p.pad[6], k = p.pad[7];
      bool layer0 = p.pad[11] != 0u;
      uint cout = p.pad[1];
      uint plane = outW * outH;
      uint oy = id / outW, ox = id % outW;
      int r = int(k) / 2;
      uint kk = k * k;
      // Constant trip counts keep acc[] in registers (a runtime bound spills
      // it to the stack on Mali); lanes >= cout are computed and discarded.
      vec4 acc0 = sb4[0], acc1 = sb4[1], acc2 = sb4[2], acc3 = sb4[3];
      for (uint ic = 0u; ic < cin; ic++) {
        for (uint ky = 0u; ky < k; ky++) {
          for (uint kx = 0u; kx < k; kx++) {
            int ix = int(ox * st) + int(kx) - r;
            int iy = int(oy * st) + int(ky) - r;
            float v = inputAt(ic, ix, iy, inW, inH, layer0, p.alpha);
            uint wi = ((ic * k + ky) * k + kx) * 4u;
            acc0 += sw4[wi] * v;
            acc1 += sw4[wi + 1u] * v;
            acc2 += sw4[wi + 2u] * v;
            acc3 += sw4[wi + 3u] * v;
          }
        }
      }
      float acc[16] = float[16](acc0.x, acc0.y, acc0.z, acc0.w, acc1.x, acc1.y, acc1.z, acc1.w,
                                acc2.x, acc2.y, acc2.z, acc2.w, acc3.x, acc3.y, acc3.z, acc3.w);
      [[unroll]] for (uint oc = 0u; oc < 16u; oc++) {
        if (oc >= cout) break;
        if (p.mode == 1u) {
          b_[oc * plane + id] = (p.pad[8] != 0u) ? max(acc[oc], 0.0) : acc[oc];
        } else {
          // out0 = cat(2 sig(c0), 2 sig(c1), 2 sig(c2) - 1), stored fp16.
          float v = 2.0 * sigmoid(acc[oc]) - (oc == 2u ? 1.0 : 0.0);
          b_[oc * plane + id] = roundToFp16(v);
        }
      }
    } else {
      // COV. Map texel (s1, s2, rho) sampled bilinearly at the grey cell's
      // raw position (cell g centred at crop + 2g + 1), exactly as GL
      // texture() samples it at that normalized coordinate. Then
      // anisoupscale.glsl's shaping: sigmas *= raw/map texel ratio *
      // sigmaScale, clamp [0.90, sigmaCap] px, elongation <= 7, rho clamp
      // +-0.8, det >= 1e-2; its weight exp(-q) with q = c dx^2 + 2 b dx dy +
      // a dy^2 (s2 = x width, s1 = y width; verified on the model) is
      // Wronski's exp(-0.5 d^T Omega^-1 d) with
      //   Omega = 0.5 [[s2^2, rho s1 s2], [rho s1 s2, s1^2]].
      uint mapW = p.pad[0], mapH = p.pad[1];
      float rawW = float(p.pad[2]), rawH = float(p.pad[3]);
      uint covW = p.pad[6];
      uint gy = id / covW, gx = id % covW;
      float X = float(p.pad[4]) + 2.0 * float(gx) + 1.0;   // pipeline coords
      float Y = float(p.pad[5]) + 2.0 * float(gy) + 1.0;
      bool fx = p.pad[8] != 0u, fy = p.pad[9] != 0u;
      if (fx) X = rawW - X;                                   // -> sensor coords
      if (fy) Y = rawH - Y;
      float u = X / rawW * float(mapW) - 0.5;
      float v = Y / rawH * float(mapH) - 0.5;
      int u0 = clamp(int(floor(u)), 0, int(mapW) - 1);
      int v0 = clamp(int(floor(v)), 0, int(mapH) - 1);
      int u1 = min(u0 + 1, int(mapW) - 1);
      int v1 = min(v0 + 1, int(mapH) - 1);
      float fu = clamp(u - float(u0), 0.0, 1.0);
      float fv = clamp(v - float(v0), 0.0, 1.0);
      uint mp = mapW * mapH;
      vec3 t00 = vec3(a_[uint(v0) * mapW + uint(u0)], a_[mp + uint(v0) * mapW + uint(u0)], a_[2u * mp + uint(v0) * mapW + uint(u0)]);
      vec3 t01 = vec3(a_[uint(v0) * mapW + uint(u1)], a_[mp + uint(v0) * mapW + uint(u1)], a_[2u * mp + uint(v0) * mapW + uint(u1)]);
      vec3 t10 = vec3(a_[uint(v1) * mapW + uint(u0)], a_[mp + uint(v1) * mapW + uint(u0)], a_[2u * mp + uint(v1) * mapW + uint(u0)]);
      vec3 t11 = vec3(a_[uint(v1) * mapW + uint(u1)], a_[mp + uint(v1) * mapW + uint(u1)], a_[2u * mp + uint(v1) * mapW + uint(u1)]);
      vec3 s = mix(mix(t00, t01, fu), mix(t10, t11, fu), fv);
      float s1 = max(s.x, 1e-4), s2 = max(s.y, 1e-4);
      float rho = clamp(s.z, -0.8, 0.8);
      // Width window [0.90, cap]: RawLens C24 (VulkanBurstCheckTest, 5 bursts x
      // 4 crops on Vulkan). The merge gathers a 3x3 neighbourhood: wider than
      // that (cap 2.0) made the per-site sample count set the noise level
      // (checker in flats); narrower than 0.90 px made texture a per-lattice
      // pick (checker in texture). PhotonCamera's own 0.25 floor is kept for
      // its upscaler, not for this merge. Cost: ~5 % edge sharpness vs Wronski.
      s1 = clamp(s1 * (rawW / float(mapW)) * p.alpha, 0.90, p.beta);
      s2 = clamp(s2 * (rawH / float(mapH)) * p.alpha, 0.90, p.beta);
      if (s1 > s2 * 7.0) s1 = s2 * 7.0; else if (s2 > s1 * 7.0) s2 = s1 * 7.0;
      float det = max(1.0 - rho * rho, 1e-2);
      float rhoEff = sign(rho) * sqrt(max(1.0 - det, 0.0));
      if (fx != fy) rhoEff = -rhoEff;                         // one-axis flip
      b_[id * 4u + 0u] = 0.5 * s2 * s2;           // xx
      b_[id * 4u + 1u] = 0.5 * rhoEff * s1 * s2;  // xy
      b_[id * 4u + 2u] = 0.5 * s1 * s1;           // yy
      b_[id * 4u + 3u] = 0.0;
    }
  }
}
