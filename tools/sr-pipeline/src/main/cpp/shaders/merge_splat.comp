#version 450
#extension GL_EXT_control_flow_attributes : require
// 1:1 port of merge.py cpu_accumulate (Alg.4 Accumulation): per-HR-pixel 3x3,
// op-for-op identical to the proven Vulkan-port decomposition
// (merge.comp:accumulate, dual parity there).
// anisotropic Gaussian splat with bilinear-interpolated then inverted 2x2
// covariance, robustness weight, and RGGB channel select. One invocation per
// HR pixel; accumulation into the resident float32 num/den pair uses one
// invocation per HR pixel (atomic-free by construction, as on CPU where each
// HR pixel is owned by exactly one prange task).
// Push overlay: pad[1] = nTilesX, pad[2] = hrW, pad[3] = refKernels,
// pad[4] = reference frame, pad[5] = detail reconstruction,
// pad[6] = continuous motion (B-spline flow, bilinear robustness),
// pad[7] = wide faded gather + detail green for per-frame (Wronski) kernels,
// robustness = frame equalization gamma (0 = Wronski weights).
// width/height = LR size; scale, tileSize, mode as usual.
layout(local_size_x = 256) in;

struct HmsrPush {
  uint width; uint height; uint pixelCount; uint tileCount;
  uint level; uint tileSize; float scale;
  float alpha; float beta; float robustness; uint mode;
  uint pad[21];
};
layout(push_constant) uniform Push { HmsrPush p; };

layout(set = 0, binding = 0) readonly buffer Comp { float compImg[]; };
layout(set = 0, binding = 1) readonly buffer Align { vec2 align_[]; };
layout(set = 0, binding = 2) readonly buffer Cov { vec4 cov[]; }; // xx,xy,yy
layout(set = 0, binding = 3) readonly buffer Rob { float rob[]; };
layout(set = 0, binding = 4) buffer Num { float num_[]; }; // tightly packed H*W*3
layout(set = 0, binding = 5) buffer Den { float den_[]; };

// Positive cubic B-spline basis: C2 motion field with no tile-edge slope jumps.
vec4 flowWeights(float t) {
  float u = 1.0-t;
  return vec4(u*u*u, 4.0-6.0*t*t+3.0*t*t*t,
              1.0+3.0*t+3.0*t*t-3.0*t*t*t, t*t*t) / 6.0;
}

// Interpolating cubic on the complete sensor grid after directional green
// reconstruction. No inverse-filter sharpening or narrowed Gaussian.
// Keys cubic parameter. -0.5 (Catmull-Rom) averaged over sub-pixel frame
// offsets low-passes luma ("too soft"). -1.5 on burst 125318_179, three
// 512 px crops: G detail band x1.14, axial-Nyquist (zipper) energy x1.04
// absolute, checker x1.0; overshoot stays inside the 4x4 min/max clamp.
// Same 16 taps, so no cost change.
const float GREEN_A = -1.5;
float greenCubic(float x) {
  const float a = GREEN_A;
  x = abs(x);
  if (x < 1.0) return ((a+2.0)*x-(a+3.0))*x*x+1.0;
  if (x < 2.0) return ((a*x-5.0*a)*x+8.0*a)*x-4.0*a;
  return 0.0;
}

// Reconstruct missing green samples along locally smooth sensor axes before
// regular-grid interpolation. Fixed diagonal-only interpolation crosses
// axis-aligned edges and imprints the Bayer phase on their contours.
float sensorGreen(int j,int i) {
  int jp=j&1, ip=i&1;
  j=clamp(j,jp,int(p.width)-2+jp);i=clamp(i,ip,int(p.height)-2+ip);
  return compImg[uint(i)*p.width+uint(j)];
}
float dirGreen(float l,float r,float u,float d) {
  float dh=abs(l-r),dv=abs(u-d);
  float wh=1.0/(1e-8+dh*dh),wv=1.0/(1e-8+dv*dv);
  return (wh*(l+r)+wv*(u+d))/(2.0*(wh+wv));
}
float interpolateGreen(vec2 position) {
  vec2 q=position-0.5;ivec2 base=ivec2(floor(q));vec2 t=fract(q);
  float value=0.0,lo=3.402823e38,hi=-3.402823e38;
  // One tap at a time, missing greens from 4 neighbours, sensor greens
  // direct: 48 loads instead of 80 and a small live set (a cached 6x6
  // window or a vectorised row pushed this shader to 64 work registers,
  // half occupancy on Mali-G615).
  [[dont_unroll]] for(int k=0;k<16;++k) {
    int x=(k&3)-1, y=(k>>2)-1;
    int j=base.x+x, i=base.y+y;
    float c=((j+i)&1)==1 ? sensorGreen(j,i)
        : dirGreen(sensorGreen(j-1,i),sensorGreen(j+1,i),sensorGreen(j,i-1),sensorGreen(j,i+1));
    value+=greenCubic(float(x)-t.x)*greenCubic(float(y)-t.y)*c;
    lo=min(lo,c);hi=max(hi,c);
  }
  return clamp(value,lo,hi);
}

void main() {
  uint id = gl_GlobalInvocationID.x;
  if (id >= p.pixelCount) return;
  uint hrW = p.pad[2];
  uint lrW = p.width;
  uint lrH = p.height;
  uint nTilesX = p.pad[1];
  uint tileSize = p.tileSize;
  bool bayer = (p.mode == 0u);
  uint nch = bayer ? 3u : 1u;

  uint hri = id / hrW;
  uint hrj = id % hrW;
  float lr_x = (float(hrj) + 0.5) / p.scale;
  float lr_y = (float(hri) + 0.5) / p.scale;
  uint px = uint(lr_x / float(tileSize));
  uint py = uint(lr_y / float(tileSize));
  vec2 F = align_[py * nTilesX + px];
  if (p.pad[6] != 0u) {
    vec2 g = vec2(lr_x, lr_y) / float(tileSize) - 0.5;
    ivec2 base = ivec2(floor(g));
    vec4 wx = flowWeights(fract(g.x)), wy = flowWeights(fract(g.y));
    int ny = int((lrH + tileSize - 1u) / tileSize);
    F = vec2(0);
    for (int y = 0; y < 4; ++y) for (int x = 0; x < 4; ++x) {
      int xx = clamp(base.x+x-1, 0, int(nTilesX)-1);
      int yy = clamp(base.y+y-1, 0, ny-1);
      F += wx[x]*wy[y]*align_[uint(yy)*nTilesX+uint(xx)];
    }
  }

  // Guide-grid robustness: continuous KernelNet sampling or reference-port lookup.
  float local_r;
  if (bayer && p.pad[6] != 0u) {
    // Same reference-grid guide centres as the rejection stage. The old
    // floor-then-truncate lookup both shifted and stair-stepped this map.
    vec2 q = clamp(vec2(lr_x,lr_y)*0.5-0.5, vec2(0), vec2(lrW/2u-1u,lrH/2u-1u));
    uvec2 lo = uvec2(q), hi = min(lo+1u,uvec2(lrW/2u-1u,lrH/2u-1u));
    vec2 f = fract(q); uint rw = lrW/2u;
    local_r = mix(mix(rob[lo.y*rw+lo.x],rob[lo.y*rw+hi.x],f.x),
                  mix(rob[hi.y*rw+lo.x],rob[hi.y*rw+hi.x],f.x),f.y);
  } else if (bayer) {
    // CPU is int(lr//2 - 0.5): Python // FLOORS before subtracting, so this
    // is floor-then-subtract, NOT truncation (they differ by one for half of
    // all pixels). Replicated exactly; min() matches the CPU.
    int ir = min(int(floor(lr_y / 2.0) - 0.5), int(lrH / 2u) - 1);
    int jr = min(int(floor(lr_x / 2.0) - 0.5), int(lrW / 2u) - 1);
    local_r = rob[uint(max(ir, 0)) * (lrW / 2u) + uint(max(jr, 0))];
    // NOTE: CPU uses int() truncation (toward zero) for frac below; kept here.
  } else {
    int ir = min(int(lr_y), int(lrH) - 1);
    int jr = min(int(lr_x), int(lrW) - 1);
    local_r = rob[uint(max(ir, 0)) * lrW + uint(max(jr, 0))];
  }

  float mov_x = lr_x + F.x;
  float mov_y = lr_y + F.y;
  if (!(mov_x >= 0.0 && mov_x < float(lrW) && mov_y >= 0.0 && mov_y < float(lrH)))
    return;

  // Covariance-grid coordinates (grey grid offset, half-rate in bayer mode).
  // Wronski: each frame's own kernels, read at its aligned position.
  // pad[3] == 1 (KernelNet): ONE kernel map from the reference frame, read
  // at the output position on the reference grid it was computed on.
  bool refKernels = (p.pad[3] == 1u);
  float kx = refKernels ? lr_x : mov_x;
  float ky = refKernels ? lr_y : mov_y;
  float kmap_j = bayer ? kx / 2.0 - 0.5 : kx - 0.5;
  float kmap_i = bayer ? ky / 2.0 - 0.5 : ky - 0.5;
  // frac from truncation (stays negative for negative inputs), as on CPU.
  float frac_x = kmap_j - float(int(kmap_j));
  float frac_y = kmap_i - float(int(kmap_i));
  int floor_x = max(int(kmap_j), 0);
  int floor_y = max(int(kmap_i), 0);
  uint covW = bayer ? lrW / 2u : lrW;
  uint covH = bayer ? lrH / 2u : lrH;
  uint ceil_x = min(uint(floor_x) + 1u, covW - 1u);
  uint ceil_y = min(uint(floor_y) + 1u, covH - 1u);
  vec4 tr = cov[uint(floor_y) * covW + uint(floor_x)];
  vec4 tl = cov[uint(floor_y) * covW + ceil_x];
  vec4 br = cov[uint(ceil_y) * covW + uint(floor_x)];
  vec4 bl = cov[uint(ceil_y) * covW + ceil_x];
  float cxx = mix(mix(tr.x, tl.x, frac_x), mix(br.x, bl.x, frac_x), frac_y);
  float cxy = mix(mix(tr.y, tl.y, frac_x), mix(br.y, bl.y, frac_x), frac_y);
  float cyy = mix(mix(tr.z, tl.z, frac_x), mix(br.z, bl.z, frac_x), frac_y);
  float det = cxx * cyy - cxy * cxy;
  float inv = 1.0 / det;
  float ixx = inv * cyy;
  float ixy = -inv * cxy;
  float iyy = inv * cxx;

  int center_j = int(mov_x);
  int center_i = int(mov_y);
  float mov_j = mov_x - 0.5;
  float mov_i = mov_y - 0.5;
  vec3 val = vec3(0.0);
  vec3 acc = vec3(0.0);
  // R/B kernel width factor (p.alpha, 0 = 1): with the colour-difference merge
  // R/B hold smooth wb*C - G_hat differences; a wider R/B kernel spreads their
  // weight over the few same-colour samples of the 3x3 gather (zipper source
  // at 2x) without touching green, which carries the luma detail.
  float cs = p.alpha > 0.0 ? p.alpha : 1.0;
  float chromaInv = 1.0 / (cs * cs);
  // A hard 3x3 cutoff removes a nonzero Gaussian weight whenever the
  // centre crosses a sensor-pixel boundary. KernelNet widths (especially
  // widened colour differences) need more support. Fade only the outer
  // ring of a 7x7 gather, making entering/leaving weights continuously zero.
  // The original Jamy-L/Wronski gather stays 3x3.
  // pad[7] gives Wronski's per-frame kernels the same wide faded gather and
  // detail-green path as the KernelNet map (kernels stay at mov position).
  bool wideGather = refKernels || p.pad[7] != 0u;
  int radius = wideGather ? 3 : 1;
  // A non-unit green weight opts the reference into the same continuous
  // reconstruction as comparisons; this retains its original fine texture.
  bool detailGreen = bayer && wideGather && p.pad[5] != 0u &&
                     (p.pad[4] == 0u || p.beta != 1.0);
  // With detailGreen the green taps are skipped: visit only the R/B sites
  // of each row (j parity == row parity in RGGB), same taps in the same
  // order, so bit-identical at half the 7x7 loop trips.
  int djStep = detailGreen ? 2 : 1;
  for (int di = -radius; di <= radius; di++) {
    int dj0 = -radius;
    if (detailGreen && (((center_j + dj0) ^ (center_i + di)) & 1) != 0) dj0++;
    for (int dj = dj0; dj <= radius; dj += djStep) {
      int j = center_j + dj;
      int i2 = center_i + di;
      if (!(j >= 0 && j < int(lrW) && i2 >= 0 && i2 < int(lrH))) continue;
      uint ch = bayer ? uint(i2 % 2 + j % 2) : 0u; // RGGB hardcoded, as on CPU
      if (detailGreen && ch == 1u) continue;
      float c = compImg[uint(i2) * lrW + uint(j)];
      float dx = float(j) - mov_j;
      float dy = float(i2) - mov_i;
      float z = ixx * dx * dx + 2.0 * ixy * dx * dy + iyy * dy * dy;
      z = max(z, 0.0);
      if (bayer && ch != 1u) z *= chromaInv;
      float w = exp(-0.5 * z);
      if (wideGather) {
        w *= (1.0 - smoothstep(2.5, 3.5, abs(dx))) *
             (1.0 - smoothstep(2.5, 3.5, abs(dy)));
      }
      val[ch] += w * local_r * c;
      acc[ch] += w * local_r;
    }
  }
  if (detailGreen && local_r > 0.0 && p.beta > 0.0) {
    // Identical frame weights at every image position: preserve source
    // luminance grain in textured areas as well as flats. No spatial mask,
    // narrower sampling kernel, or generated noise is involved.
    float weight = 3.14159265359*sqrt(max(det,0.0))*local_r*p.beta;
    val.g = weight*interpolateGreen(vec2(mov_x,mov_y));
    acc.g = weight;
  }
  // Frame equalization (gamma > 0): a narrow kernel lets whichever frame has
  // the nearest sample dominate, so frames stop averaging and Wronski needs
  // wide (blurring) kernels to denoise. Rescale this frame's total weight
  // from local_r*S to local_r*S^(1-gamma): gamma = 1 weighs every frame
  // equally (full temporal averaging) while the kernel keeps its shape.
  if (p.robustness > 0.0) {
    for (uint ch = 0u; ch < nch; ch++) {
      if (acc[ch] > 0.0 && local_r > 0.0) {
        float s = acc[ch] / local_r;
        float f = pow(max(s, 1e-6), -p.robustness);
        val[ch] *= f; acc[ch] *= f;
      }
    }
  }
  for (uint ch = 0u; ch < nch; ch++) {
    num_[id * 3u + ch] += val[ch];
    den_[id * 3u + ch] += acc[ch];
  }
}
