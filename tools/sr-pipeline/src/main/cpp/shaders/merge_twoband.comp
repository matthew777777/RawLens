#version 450
// Two-band MFSR accumulation (TwoBandReconstruction.finishSinglePass, GPU
// form). One invocation per output pixel per frame, atomic-free (each output
// pixel owned by one invocation), frames streamed once like merge_splat.
//
// Input frame: colour-difference CFA (ColourDiff: green raw, R/B sites hold
// wb*C - G_hat). Flow: per finest tile, C2 B-spline interpolated (as
// merge_splat continuous motion). Robustness: guide grid, bilinear.
// Gather over the 7x7 frame neighbourhood of the aligned position:
//   green, wide (sigmaLow):   num.g / den.g  (low band)
//   green, narrow (sigmaHigh): aux = (sum w g, sum w, sum w dx, sum w dy)
//                              dx, dy = sample - pixel in sensor px
//   R / B differences, wide:  num.r / den.r, num.b / den.b
// No per-frame kernels: the merge blur is the narrow kernel's.
// Edge steering (pad[4] = field grid width, 0 = isotropic): twoband_tensor's
// field from the reference frame (edge direction e, stretch from the
// structure-tensor coherence), read nearest at the output position on the
// reference grid: sigmaHigh across the edge, stretch * sigmaHigh along. On an edge the
// gather then follows the edge: at an R/B site of a horizontal edge it uses
// the left / right greens (same edge position), not the ones above / below.
// An isotropic narrow kernel is sharp on green sites and a 4-neighbour
// average on R/B sites wherever the frames leave the green quincunx gaps, and
// that alternation along an edge is a zipper.
//
// push: width/height = frame, pixelCount = outW*outH, tileSize, scale,
//   alpha = sigmaHigh, beta = sigmaLow (sensor px),
//   pad[1] = nTilesX, pad[2] = outW, pad[3] = nTilesY, pad[4] = field width.
// Buffers: 0 frame, 1 flow (vec2 per tile), 2 rob (w/2 x h/2), 3 num (x3),
//   4 den (x3), 5 aux (vec4), 6 field (vec4 e.x, e.y, stretch at w/2 x h/2).
layout(local_size_x = 256) in;

struct HmsrPush {
  uint width; uint height; uint pixelCount; uint tileCount;
  uint level; uint tileSize; float scale;
  float alpha; float beta; float robustness; uint mode;
  uint pad[21];
};
layout(push_constant) uniform Push { HmsrPush p; };

layout(set = 0, binding = 0) readonly buffer Comp { float img[]; };
layout(set = 0, binding = 1) readonly buffer Align { vec2 align_[]; };
layout(set = 0, binding = 2) readonly buffer Rob { float rob[]; };
layout(set = 0, binding = 3) buffer Num { float num_[]; };
layout(set = 0, binding = 4) buffer Den { float den_[]; };
layout(set = 0, binding = 5) buffer Aux { vec4 aux_[]; };
layout(set = 0, binding = 6) readonly buffer Cov { vec4 cov_[]; };

vec4 flowWeights(float t) {
  float u = 1.0 - t;
  return vec4(u*u*u, 4.0 - 6.0*t*t + 3.0*t*t*t, 1.0 + 3.0*t + 3.0*t*t - 3.0*t*t*t, t*t*t) / 6.0;
}

// One output item; SrpBridge.dispatchRes caps the grid at 65535 groups,
// so main() grid-strides (2x outputs exceed 65535 * 256 = 2^24 items).
void process(const uint id) {
  const uint outW = p.pad[2];
  const int W = int(p.width), H = int(p.height);
  const uint ts = p.tileSize, nTx = p.pad[1], nTy = p.pad[3];
  const float lx = (float(id % outW) + 0.5) / p.scale;
  const float ly = (float(id / outW) + 0.5) / p.scale;

  vec2 g = vec2(lx, ly) / float(ts) - 0.5;
  ivec2 base = ivec2(floor(g));
  vec4 wx = flowWeights(fract(g.x)), wy = flowWeights(fract(g.y));
  vec2 F = vec2(0.0);
  for (int y = 0; y < 4; ++y) {
    const uint yy = uint(clamp(base.y + y - 1, 0, int(nTy) - 1)) * nTx;
    for (int x = 0; x < 4; ++x)
      F += wx[x] * wy[y] * align_[yy + uint(clamp(base.x + x - 1, 0, int(nTx) - 1))];
  }

  const uint rw = p.width / 2u, rh = p.height / 2u;
  vec2 q = clamp(vec2(lx, ly) * 0.5 - 0.5, vec2(0.0), vec2(rw - 1u, rh - 1u));
  uvec2 lo = uvec2(q), hi = min(lo + 1u, uvec2(rw - 1u, rh - 1u));
  vec2 f = fract(q);
  const float r = mix(mix(rob[lo.y*rw + lo.x], rob[lo.y*rw + hi.x], f.x),
                      mix(rob[hi.y*rw + lo.x], rob[hi.y*rw + hi.x], f.x), f.y);
  if (!(r > 0.0)) return;

  const float mx = lx + F.x, my = ly + F.y;
  if (!(mx >= 0.0 && mx < float(W) && my >= 0.0 && my < float(H))) return;
  const int cj = int(mx), ci = int(my);
  const float invL = 0.5 / (p.beta * p.beta);
  // Narrow kernel: exponent = -(qxx dx^2 + 2 qxy dx dy + qyy dy^2).
  float qxx = 0.5 / (p.alpha * p.alpha), qxy = 0.0, qyy = qxx;
  const uint covW = p.pad[4];
  if (covW != 0u) {
    const uint covH = p.height / 2u;
    const uvec2 k = uvec2(clamp(ivec2(floor(vec2(lx, ly) * 0.5)), ivec2(0), ivec2(covW - 1u, covH - 1u)));
    const vec4 fld = cov_[k.y * covW + k.x];
    const vec2 e1 = fld.xy;
    const float stretch = fld.z;
    // Axis variances sigmaHigh^2 (across) and (stretch sigmaHigh)^2 (along).
    const float i2 = 0.5 / (p.alpha * p.alpha), i1 = i2 / (stretch * stretch);
    qxx = i1 * e1.x * e1.x + i2 * e1.y * e1.y;
    qxy = (i1 - i2) * e1.x * e1.y;
    qyy = i1 * e1.y * e1.y + i2 * e1.x * e1.x;
  }

  vec3 val = vec3(0.0), acc = vec3(0.0);
  vec4 nar = vec4(0.0);
  for (int di = -3; di <= 3; ++di) {
    const int i2 = ci + di;
    if (i2 < 0 || i2 >= H) continue;
    const float dy = float(i2) + 0.5 - my;
    const float fy = 1.0 - smoothstep(2.5, 3.5, abs(dy));
    for (int dj = -3; dj <= 3; ++dj) {
      const int j = cj + dj;
      if (j < 0 || j >= W) continue;
      const float dx = float(j) + 0.5 - mx;
      const float d2 = dx*dx + dy*dy;
      const float c = img[uint(i2) * p.width + uint(j)];
      const float wl = r * exp(-d2 * invL) * fy * (1.0 - smoothstep(2.5, 3.5, abs(dx)));
      const uint ch = uint((i2 & 1) + (j & 1));   // RGGB: 0 R, 1 G, 2 B
      val[ch] += wl * c; acc[ch] += wl;
      const float qn = qxx * dx * dx + 2.0 * qxy * dx * dy + qyy * dy * dy;
      if (ch == 1u && qn < 4.5) {   // 3 sigma along the kernel's own axes
        const float wn = r * exp(-qn) * fy * (1.0 - smoothstep(2.5, 3.5, abs(dx)));
        nar += wn * vec4(c, 1.0, dx, dy);
      }
    }
  }
  num_[id*3u] += val.r; num_[id*3u+1u] += val.g; num_[id*3u+2u] += val.b;
  den_[id*3u] += acc.r; den_[id*3u+1u] += acc.g; den_[id*3u+2u] += acc.b;
  aux_[id] += nar;
}

void main() {
  for (uint id = gl_GlobalInvocationID.x; id < p.pixelCount; id += gl_NumWorkGroups.x * gl_WorkGroupSize.x)
    process(id);
}
