#version 450
// divide.comp in place over the whole image: num /= den.
layout(local_size_x = 256) in;
struct HmsrPush {
  uint width; uint height; uint pixelCount; uint tileCount;
  uint level; uint tileSize; float scale;
  float alpha; float beta; float robustness; uint mode;
  uint pad[21];
};
layout(push_constant) uniform Push { HmsrPush p; };

layout(set = 0, binding = 0) buffer Num { float n_[]; };
layout(set = 0, binding = 1) readonly buffer Den { float d_[]; };
void main() {
  for (uint i = gl_GlobalInvocationID.x; i < p.pixelCount; i += gl_NumWorkGroups.x * 256u) n_[i] = n_[i] / d_[i];
}
