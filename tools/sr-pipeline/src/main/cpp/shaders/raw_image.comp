#version 450
// Uploaded frame buffer -> R32F image (every later stage samples it).
layout(local_size_x = 16, local_size_y = 16) in;
struct HmsrPush {
  uint width; uint height; uint pixelCount; uint tileCount;
  uint level; uint tileSize; float scale;
  float alpha; float beta; float robustness; uint mode;
  uint pad[21];
};
layout(push_constant) uniform Push { HmsrPush p; };
layout(set = 0, binding = 0) readonly buffer A { float a_[]; };
layout(set = 0, binding = 1, r32f) uniform writeonly highp image2D out_;
void main() {
  uvec2 q = gl_GlobalInvocationID.xy;
  if (any(greaterThanEqual(q, uvec2(p.width, p.height)))) return;
  imageStore(out_, ivec2(q), vec4(a_[q.y * p.width + q.x]));
}
