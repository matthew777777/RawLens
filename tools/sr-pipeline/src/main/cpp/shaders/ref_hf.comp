#version 450
// Supplement S.3 variance-loss map (robustness.comp op 9) from ref_stats.comp.
// width/height = guide grid. pad: [4] rho [5] K [6..8] alpha [9..11] beta (bits).
layout(local_size_x = 16, local_size_y = 16) in;
struct HmsrPush {
  uint width; uint height; uint pixelCount; uint tileCount;
  uint level; uint tileSize; float scale;
  float alpha; float beta; float robustness; uint mode;
  uint pad[21];
};
layout(push_constant) uniform Push { HmsrPush p; };
layout(set = 0, binding = 0) uniform highp sampler2D ref_;
layout(set = 0, binding = 1, r32f) uniform writeonly highp image2D out_;
void main() {
  ivec2 q = ivec2(gl_GlobalInvocationID.xy), sz = ivec2(p.width, p.height);
  if (any(greaterThanEqual(q, sz))) return;
  vec4 ref = texelFetch(ref_, q, 0);
  vec3 m = vec3(0.0), m2 = vec3(0.0);
  for (int dy = -1; dy <= 1; dy++) for (int dx = -1; dx <= 1; dx++) {
    vec3 v = texelFetch(ref_, clamp(q + ivec2(dx, dy), ivec2(0), sz - 1), 0).xyz;
    m += v;
    m2 += v * v;
  }
  m /= 9.0;
  vec3 after = m2 / 9.0 - m * m;
  vec3 lin = max(ref.xyz, vec3(1e-6));
  lin *= lin;
  vec3 half_ = vec3(1.0, 0.5, 1.0);
  vec3 a = uintBitsToFloat(uvec3(p.pad[6], p.pad[7], p.pad[8])) * half_;
  vec3 b = uintBitsToFloat(uvec3(p.pad[9], p.pad[10], p.pad[11])) * half_;
  vec3 noise = (a * lin + b) / (4.0 * lin);
  bool hf = (after.x + after.y + after.z) / max(ref.w, 1e-12) < uintBitsToFloat(p.pad[4])
      && ref.w > uintBitsToFloat(p.pad[5]) * (noise.x + noise.y + noise.z);
  imageStore(out_, q, vec4(hf ? 1.0 : 0.0));
}
