#version 450
// srp:half - the build also compiles <name>_h.spv with -DSRP_HALF (fp16 storage, MobileMerge).
#ifdef SRP_HALF
#define SRP_R r16f
#define SRP_RGBA rgba16f
#else
#define SRP_R r32f
#define SRP_RGBA rgba32f
#endif
// Reference statistics for rob_test.comp straight from the raw image: (mean R, G,
// B, variance sum) of robustness.comp op 1. width/height = guide grid.
layout(local_size_x = 16, local_size_y = 16) in;
struct HmsrPush {
  uint width; uint height; uint pixelCount; uint tileCount;
  uint level; uint tileSize; float scale;
  float alpha; float beta; float robustness; uint mode;
  uint pad[21];
};
layout(push_constant) uniform Push { HmsrPush p; };
layout(set = 0, binding = 0) uniform highp sampler2D raw_;
layout(set = 0, binding = 1, SRP_RGBA) uniform writeonly highp image2D out_;
vec3 guide(ivec2 g) {
  ivec2 j = 2 * g;
  float r = texelFetch(raw_, j, 0).x, g1 = texelFetch(raw_, j + ivec2(1, 0), 0).x;
  float g2 = texelFetch(raw_, j + ivec2(0, 1), 0).x, b = texelFetch(raw_, j + ivec2(1, 1), 0).x;
  return vec3(sqrt(max(r, 0.0)), sqrt(max(0.5 * (g1 + g2), 0.0)), sqrt(max(b, 0.0)));
}
void main() {
  ivec2 q = ivec2(gl_GlobalInvocationID.xy), sz = ivec2(p.width, p.height);
  if (any(greaterThanEqual(q, sz))) return;
  vec3 m = vec3(0.0), s = vec3(0.0);
  for (int dy = -1; dy <= 1; dy++) for (int dx = -1; dx <= 1; dx++) {
    vec3 v = guide(clamp(q + ivec2(dx, dy), ivec2(0), sz - 1));
    m += v;
    s += v * v;
  }
  m /= 9.0;
  s = s / 9.0 - m * m;
  imageStore(out_, q, vec4(m, s.x + s.y + s.z));
}
